             <property name="styleSheet"><string>background:#F5F7FA;border:none;border-top:1px solid #EEF1F6;border-radius:0 0 12px 12px;min-height:52px;max-height:52px;</string></property>
             <layout class="QHBoxLayout">
              <property name="contentsMargins"><rect><x>16</x><y>6</y><width>16</width><height>6</height></rect></property>
