<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MissingLogPrediction</class>
 <widget class="QMainWindow" name="MissingLogPrediction">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1440</width><height>900</height></rect>
  </property>
  <property name="windowTitle">
   <string>PetroARX AI Analytics — Missing Log Prediction</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
/* ══════════════════════════════════════════════════════════
   PETROARX LIGHT THEME — Missing Log Prediction
   Design language: precision-instrument / lab-grade clarity
   Palette:
     --bg-canvas:   #F5F7FA   (page background)
     --bg-surface:  #FFFFFF   (card/panel surfaces)
     --bg-raised:   #EEF1F6   (inset / input backgrounds)
     --border:      #DDE2EA   (all hairline borders)
     --accent-ink:  #1B3A6B   (deep navy — primary text, headings)
     --accent-blue: #1D6FE8   (interactive blue)
     --accent-teal: #0EA5A0   (data accent — predicted trace)
     --accent-amber:#E07B2A   (warning / secondary metric)
     --accent-green:#1A9E5C   (success / positive)
     --accent-red:  #D94040   (missing interval / negative)
     --text-body:   #3A4558
     --text-muted:  #7A8AA0
     --text-micro:  #9BAABB
   ══════════════════════════════════════════════════════════ */

/* ── GLOBAL ─────────────────────────────────────────────── */
QMainWindow, QWidget { 
    background-color: #F5F7FA; 
    color: #3A4558;
    font-family: "Inter", "Segoe UI", "SF Pro Text", sans-serif;
    font-size: 13px;
}

/* ── TOPBAR ─────────────────────────────────────────────── */
QWidget#topBar {
    background: #FFFFFF;
    border-bottom: 1px solid #DDE2EA;
    min-height: 52px; max-height: 52px;
}
QLabel#brandIcon {
    color: #1D6FE8;
    font-size: 22px;
    font-weight: 900;
    letter-spacing: -1px;
}
QLabel#brandName {
    color: #1B3A6B;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.2px;
}
QLabel#brandSub {
    color: #7A8AA0;
    font-size: 11px;
}
QLabel#topBarSep {
    color: #DDE2EA;
    font-size: 18px;
    padding: 0 4px;
}
QComboBox#projectCombo, QComboBox#wellCombo {
    background: #F5F7FA;
    border: 1px solid #DDE2EA;
    border-radius: 7px;
    color: #1B3A6B;
    font-size: 12px;
    font-weight: 600;
    padding: 5px 28px 5px 10px;
    min-width: 130px;
}
QComboBox#projectCombo::drop-down, QComboBox#wellCombo::drop-down {
    border: none; width: 20px;
}
QComboBox#projectCombo:hover, QComboBox#wellCombo:hover {
    border-color: #1D6FE8;
    background: #EFF4FE;
}
QLabel#topBarCtxLabel {
    color: #7A8AA0;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}
QPushButton#btnLoadLAS {
    background: #1D6FE8;
    border: none;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 600;
    padding: 7px 18px;
}
QPushButton#btnLoadLAS:hover { background: #1558C4; }
QLabel#statusBadge {
    background: #E8F7EF;
    border: 1px solid #9ADCBD;
    border-radius: 12px;
    color: #1A9E5C;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 12px;
}
QPushButton#btnTopAction {
    background: transparent;
    border: none;
    color: #7A8AA0;
    font-size: 12px;
    padding: 6px 12px;
}
QPushButton#btnTopAction:hover { color: #1B3A6B; }
QFrame#topSepV {
    color: #DDE2EA;
}

/* ── LEFT SIDEBAR ─────────────────────────────────────────── */
QWidget#sidebar {
    background: #FFFFFF;
    border-right: 1px solid #DDE2EA;
    min-width: 280px; max-width: 280px;
}
QLabel#sideSection {
    color: #7A8AA0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.1px;
    padding: 0 0 4px 0;
}
QLabel#sideStepNum {
    background: #1D6FE8;
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 700;
    min-width: 20px; max-width: 20px;
    min-height: 20px; max-height: 20px;
    padding: 2px;
}
QLabel#sideStepNumDone {
    background: #1A9E5C;
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 700;
    min-width: 20px; max-width: 20px;
    min-height: 20px; max-height: 20px;
    padding: 2px;
}
QLabel#sideStepTitle {
    color: #1B3A6B;
    font-size: 13px;
    font-weight: 600;
}

/* Input fields */
QComboBox {
    background: #F5F7FA;
    border: 1px solid #DDE2EA;
    border-radius: 7px;
    color: #1B3A6B;
    font-size: 13px;
    font-weight: 500;
    padding: 7px 10px;
}
QComboBox:focus { border-color: #1D6FE8; background: #EFF4FE; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 7px;
    color: #3A4558;
    selection-background-color: #EFF4FE;
    selection-color: #1D6FE8;
}
QLineEdit {
    background: #F5F7FA;
    border: 1px solid #DDE2EA;
    border-radius: 7px;
    color: #1B3A6B;
    font-size: 13px;
    padding: 7px 10px;
}
QLineEdit:focus { border-color: #1D6FE8; background: #EFF4FE; }
QSpinBox, QDoubleSpinBox {
    background: #F5F7FA;
    border: 1px solid #DDE2EA;
    border-radius: 7px;
    color: #1B3A6B;
    font-size: 13px;
    padding: 6px 8px;
}
QSpinBox:focus, QDoubleSpinBox:focus { border-color: #1D6FE8; }

/* Missing intervals table */
QTableWidget {
    background: #FFFFFF;
    alternate-background-color: #F5F7FA;
    border: 1px solid #DDE2EA;
    border-radius: 7px;
    color: #3A4558;
    font-size: 12px;
    gridline-color: #EEF1F6;
    selection-background-color: #EFF4FE;
    selection-color: #1D6FE8;
}
QTableWidget::item { padding: 5px 10px; }
QHeaderView::section {
    background: #F5F7FA;
    color: #7A8AA0;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
    border: none;
    border-bottom: 1px solid #DDE2EA;
    padding: 6px 10px;
}

/* Feature selection */
QPushButton#btnEditFeatures {
    background: #EFF4FE;
    border: 1px solid #C3D9FC;
    border-radius: 6px;
    color: #1D6FE8;
    font-size: 11px;
    font-weight: 600;
    padding: 5px 12px;
}
QPushButton#btnEditFeatures:hover { background: #DCE9FC; }
QLabel#featCount {
    background: #EFF4FE;
    border-radius: 10px;
    color: #1D6FE8;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
}
QPushButton#btnCorrMatrix {
    background: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    color: #3A4558;
    font-size: 12px;
    font-weight: 500;
    padding: 8px 0;
}
QPushButton#btnCorrMatrix:hover {
    border-color: #1D6FE8;
    color: #1D6FE8;
    background: #EFF4FE;
}

/* Train button — signature element */
QPushButton#btnTrainModel {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 #1D6FE8, stop:1 #0EA5A0);
    border: none;
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.2px;
    min-height: 46px;
    padding: 0 20px;
}
QPushButton#btnTrainModel:hover {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 #1558C4, stop:1 #0B8A86);
}

/* Slider */
QSlider::groove:horizontal {
    height: 4px; background: #DDE2EA; border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #1D6FE8;
    border: 2px solid #FFFFFF;
    box-shadow: 0 0 0 1px #1D6FE8;
    width: 14px; height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::sub-page:horizontal {
    background: #1D6FE8; border-radius: 2px;
}

/* GPU Toggle */
QPushButton#gpuToggle {
    background: #1A9E5C;
    border: none;
    border-radius: 11px;
    color: transparent;
    min-width: 42px; max-width: 42px;
    min-height: 22px; max-height: 22px;
}
QPushButton#gpuToggleOff {
    background: #DDE2EA;
    border: none;
    border-radius: 11px;
    color: transparent;
    min-width: 42px; max-width: 42px;
    min-height: 22px; max-height: 22px;
}

/* ── CENTRE WORKSPACE ──────────────────────────────────────── */
QWidget#workspace {
    background: #F5F7FA;
}
QFrame#workspaceCard {
    background: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 12px;
}
QLabel#workspaceTitle {
    color: #1B3A6B;
    font-size: 16px;
    font-weight: 700;
}
QLabel#workspaceSub {
    color: #7A8AA0;
    font-size: 12px;
}

/* Legend chips */
QLabel#legendChip {
    background: #F5F7FA;
    border: 1px solid #DDE2EA;
    border-radius: 5px;
    color: #3A4558;
    font-size: 11px;
    padding: 3px 8px;
}

/* Log canvas */
QFrame#logCanvas {
    background: #FAFBFC;
    border: 1px solid #EEF1F6;
    border-radius: 8px;
}

/* Column header badges */
QLabel#colHeaderGR   { background:#FFF5E0; border:1px solid #F5C842; color:#8A6200; font-size:10px; font-weight:700; padding:3px 7px; border-radius:5px; }
QLabel#colHeaderNPHI { background:#E8F4FE; border:1px solid #7BBFEE; color:#1B5F99; font-size:10px; font-weight:700; padding:3px 7px; border-radius:5px; }
QLabel#colHeaderDT   { background:#F3EEFF; border:1px solid #C4A3F5; color:#5A1FA8; font-size:10px; font-weight:700; padding:3px 7px; border-radius:5px; }
QLabel#colHeaderRT   { background:#E6FFF4; border:1px solid #8ADCB8; color:#0D6E43; font-size:10px; font-weight:700; padding:3px 7px; border-radius:5px; }
QLabel#colHeaderRHOB { background:#FFF0E8; border:1px solid #F0A877; color:#8C3B00; font-size:10px; font-weight:700; padding:3px 7px; border-radius:5px; }
QLabel#colHeaderPred { background:#EFF4FE; border:1px solid #7FB3F5; color:#0D40A0; font-size:10px; font-weight:700; padding:3px 7px; border-radius:5px; }

/* Depth axis */
QLabel#depthAxisLabel {
    color: #7A8AA0;
    font-size: 11px;
    font-weight: 600;
}

/* Minimap */
QFrame#minimap {
    background: #F5F7FA;
    border: 1px solid #DDE2EA;
    border-radius: 6px;
    min-height: 52px; max-height: 52px;
}

/* Training summary / log panels */
QFrame#panelSm {
    background: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 10px;
}
QLabel#panelSmTitle {
    color: #1B3A6B;
    font-size: 12px;
    font-weight: 700;
}
QLabel#trainKey {
    color: #7A8AA0;
    font-size: 11px;
}
QLabel#trainVal {
    color: #3A4558;
    font-size: 11px;
    font-weight: 600;
}
QTextEdit#trainingLog {
    background: #F5F7FA;
    border: 1px solid #EEF1F6;
    border-radius: 6px;
    color: #1A9E5C;
    font-family: "JetBrains Mono","Cascadia Code","Consolas",monospace;
    font-size: 10px;
    padding: 6px 8px;
}
QLabel#logLine { color: #3A4558; font-size: 11px; }
QLabel#logLineDone { color: #1A9E5C; font-size: 11px; }
QLabel#modelReadyBadge {
    background: #E8F7EF;
    border: 1px solid #9ADCBD;
    border-radius: 8px;
    color: #1A9E5C;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 14px;
}
QPushButton#btnViewLog {
    background: #F5F7FA;
    border: 1px solid #DDE2EA;
    border-radius: 7px;
    color: #3A4558;
    font-size: 12px;
    padding: 7px;
}
QPushButton#btnViewLog:hover { border-color: #1D6FE8; color: #1D6FE8; }

/* ── RIGHT METRICS PANEL ───────────────────────────────────── */
QWidget#metricsPanel {
    background: #FFFFFF;
    border-left: 1px solid #DDE2EA;
    min-width: 290px; max-width: 290px;
}
QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: #7A8AA0;
    font-size: 12px;
    font-weight: 500;
    padding: 10px 14px;
}
QTabBar::tab:selected {
    color: #1D6FE8;
    border-bottom: 2px solid #1D6FE8;
}
QTabBar::tab:hover { color: #1B3A6B; }
QTabWidget::pane {
    border: none;
    background: #FFFFFF;
}
QLabel#metricsHeading {
    color: #1B3A6B;
    font-size: 13px;
    font-weight: 700;
}
/* KPI cards */
QFrame#kpiCard {
    background: #F5F7FA;
    border: 1px solid #EEF1F6;
    border-radius: 10px;
}
QLabel#kpiLabel {
    color: #7A8AA0;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.6px;
}
QLabel#kpiBlue {
    color: #1D6FE8;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.5px;
}
QLabel#kpiAmber {
    color: #E07B2A;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.5px;
}
QLabel#kpiGreen {
    color: #1A9E5C;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.5px;
}
QLabel#kpiTeal {
    color: #0EA5A0;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.5px;
}
QLabel#sparklinePlaceholder {
    color: #DDE2EA;
    font-size: 11px;
    font-style: italic;
}

/* Residuals chart */
QFrame#residualsChart {
    background: #F5F7FA;
    border: 1px solid #EEF1F6;
    border-radius: 8px;
    min-height: 160px;
}
QPushButton#btnResHisto {
    background: transparent;
    border: 1px solid #DDE2EA;
    border-radius: 6px;
    color: #7A8AA0;
    font-size: 11px;
    padding: 5px 12px;
}
QPushButton#btnResHisto:hover { border-color: #1D6FE8; color: #1D6FE8; }

/* Prediction uncertainty */
QLabel#ciLabel {
    color: #7A8AA0;
    font-size: 11px;
}
QLabel#ciVal {
    color: #3A4558;
    font-size: 12px;
    font-weight: 600;
}

/* ── PROGRESS BAR ──────────────────────────────────────────── */
QProgressBar {
    background: #EEF1F6;
    border: none;
    border-radius: 3px;
    max-height: 5px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 #1D6FE8, stop:1 #0EA5A0);
    border-radius: 3px;
}
QProgressBar#shapBar::chunk { background: #1D6FE8; border-radius: 2px; }
QProgressBar#shapBarNeg::chunk { background: #D94040; border-radius: 2px; }

/* ── BOTTOM STATUS BAR ─────────────────────────────────────── */
QWidget#statusBar {
    background: #FFFFFF;
    border-top: 1px solid #DDE2EA;
    min-height: 42px; max-height: 42px;
}
QLabel#statusItem {
    color: #7A8AA0;
    font-size: 11px;
}
QLabel#statusItemBold {
    color: #3A4558;
    font-size: 11px;
    font-weight: 600;
}
QLabel#statusDot {
    background: #1A9E5C;
    border-radius: 4px;
    min-width: 8px; max-width: 8px;
    min-height: 8px; max-height: 8px;
}
QPushButton#btnExportReport {
    background: #F5F7FA;
    border: 1px solid #DDE2EA;
    border-radius: 7px;
    color: #3A4558;
    font-size: 12px;
    padding: 6px 16px;
}
QPushButton#btnExportReport:hover { border-color: #1B3A6B; color: #1B3A6B; }
QPushButton#btnSaveProject {
    background: #F5F7FA;
    border: 1px solid #DDE2EA;
    border-radius: 7px;
    color: #3A4558;
    font-size: 12px;
    padding: 6px 16px;
}
QPushButton#btnSaveProject:hover { border-color: #1B3A6B; color: #1B3A6B; }
QPushButton#btnApplySave {
    background: #1D6FE8;
    border: none;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 24px;
}
QPushButton#btnApplySave:hover { background: #1558C4; }

/* ── SCROLLBARS ─────────────────────────────────────────────── */
QScrollBar:vertical, QScrollBar:horizontal {
    background: #F5F7FA; width: 7px; height: 7px; border-radius: 3px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #C8D1DC; border-radius: 3px; min-height: 28px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #7A8AA0;
}
QScrollBar::add-line, QScrollBar::sub-line { height:0; width:0; }

/* ── SPLITTER ───────────────────────────────────────────────── */
QSplitter::handle { background: #DDE2EA; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical   { height: 1px; }

/* ── TOOLTIPS ───────────────────────────────────────────────── */
QToolTip {
    background: #1B3A6B;
    border: none;
    color: #FFFFFF;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
}
   </string>
  </property>

  <widget class="QWidget" name="centralWidget">
   <layout class="QVBoxLayout" name="rootVLayout">
    <property name="spacing"><number>0</number></property>
    <property name="contentsMargins"><rect><x>0</x><y>0</y><width>0</width><height>0</height></rect></property>

    <!-- ═══════════════════════════════════════════
         TOP BAR
         ═══════════════════════════════════════════ -->
    <item>
     <widget class="QWidget" name="topBar">
      <layout class="QHBoxLayout" name="topBarLayout">
       <property name="contentsMargins"><rect><x>16</x><y>0</y><width>16</width><height>0</height></rect></property>
       <property name="spacing"><number>10</number></property>

       <!-- Brand -->
       <item>
        <layout class="QHBoxLayout">
         <property name="spacing"><number>6</number></property>
         <item>
          <widget class="QLabel" name="brandIcon">
