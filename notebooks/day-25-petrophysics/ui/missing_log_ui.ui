       <!-- Well -->
       <item>
        <layout class="QVBoxLayout">
         <property name="spacing"><number>1</number></property>
         <item><widget class="QLabel" name="topBarCtxLabel2"><property name="text"><string>WELL</string></property>
          <property name="styleSheet"><string>color:#7A8AA0;font-size:10px;font-weight:700;letter-spacing:0.8px;</string></property>
         </widget></item>
         <item>
          <widget class="QComboBox" name="wellCombo">
           <item><property name="text"><string>GORGONICHTHYS_1</string></property></item>
