       <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>

       <item>
        <widget class="QLabel" name="statusBadge">
         <property name="text"><string>✓  Training Complete</string></property>
        </widget>
       </item>

       <item>
        <widget class="QFrame" name="topSepV3">
         <property name="frameShape"><enum>QFrame::VLine</enum></property>
         <property name="styleSheet"><string>color:#DDE2EA; margin: 8px 4px;</string></property>
        </widget>
       </item>

       <item><widget class="QPushButton" name="btnDocs"><property name="text"><string>📄 Docs</string></property><property name="objectName"><string>btnTopAction</string></property></widget></item>
       <item><widget class="QPushButton" name="btnHelp"><property name="text"><string>? Help</string></property><property name="objectName"><string>btnTopAction</string></property></widget></item>
       <item><widget class="QPushButton" name="btnTheme"><property name="text"><string>☀</string></property><property name="objectName"><string>btnTopAction</string></property></widget></item>

       <!-- Avatar -->
       <item>
        <widget class="QLabel">
         <property name="text"><string>PA</string></property>
         <property name="styleSheet">
          <string>
background:#1D6FE8;
border-radius:16px;
color:#FFFFFF;
font-size:12px;
font-weight:700;
min-width:32px; max-width:32px;
min-height:32px; max-height:32px;
padding:0;
          </string>
         </property>
         <property name="alignment"><set>AlignCenter</set></property>
        </widget>
       </item>

      </layout>
     </widget>
    </item>

    <!-- ═══════════════════════════════════════════
         BODY: SIDEBAR | WORKSPACE | METRICS
         ═══════════════════════════════════════════ -->
    <item>
     <widget class="QSplitter" name="bodySplitter">
      <property name="orientation"><enum>Qt::Horizontal</enum></property>
      <property name="childrenCollapsible"><bool>false</bool></property>
      <property name="sizePolicy">
       <sizepolicy hsizetype="Expanding" vsizetype="Expanding"/>
      </property>

      <!-- ═══════════════════════
           LEFT SIDEBAR
           ═══════════════════════ -->
      <widget class="QWidget" name="sidebar">
       <layout class="QVBoxLayout" name="sidebarLayout">
        <property name="contentsMargins"><rect><x>16</x><y>16</y><width>16</width><height>16</height></rect></property>
        <property name="spacing"><number>16</number></property>

        <!-- STEP 1: Target Log -->
        <item>
         <layout class="QVBoxLayout"><property name="spacing"><number>8</number></property>
          <item>
           <layout class="QHBoxLayout"><property name="spacing"><number>8</number></property>
            <item><widget class="QLabel" name="sideStepNumDone"><property name="text"><string>✓</string></property><property name="alignment"><set>AlignCenter</set></property></widget></item>
            <item><widget class="QLabel" name="sideStepTitle"><property name="text"><string>Target Log</string></property></widget></item>
            <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
           </layout>
          </item>
          <item>
           <widget class="QComboBox" name="targetLogCombo">
            <item><property name="text"><string>TCMR  —  Total CMR Porosity</string></property></item>
            <item><property name="text"><string>RHOB  —  Bulk Density</string></property></item>
            <item><property name="text"><string>DT  —  Sonic Travel Time</string></property></item>
            <item><property name="text"><string>NPHI  —  Neutron Porosity</string></property></item>
           </widget>
          </item>
          <!-- Data summary strip -->
          <item>
           <widget class="QFrame">
            <property name="styleSheet"><string>background:#F5F7FA;border:1px solid #EEF1F6;border-radius:8px;padding:8px 10px;</string></property>
            <layout class="QGridLayout"><property name="spacing"><number>5</number></property>
             <item row="0" column="0"><widget class="QLabel" name="trainKey"><property name="text"><string>Data Points</string></property></widget></item>
             <item row="0" column="1"><widget class="QLabel" name="trainVal"><property name="text"><string>1,495</string></property></widget></item>
             <item row="0" column="2">
              <widget class="QLabel">
               <property name="text"><string>117 missing (7.8%)</string></property>
               <property name="styleSheet"><string>background:#FDECEA;border:1px solid #F5B8B8;border-radius:4px;color:#D94040;font-size:10px;font-weight:600;padding:2px 7px;</string></property>
              </widget>
             </item>
             <item row="1" column="0"><widget class="QLabel" name="trainKey2"><property name="text"><string>Depth Range</string></property>
              <property name="styleSheet"><string>color:#7A8AA0;font-size:11px;</string></property></widget></item>
             <item row="1" column="1" colspan="2"><widget class="QLabel" name="trainVal2"><property name="text"><string>3,918 – 4,145 m</string></property>
              <property name="styleSheet"><string>color:#3A4558;font-size:11px;font-weight:600;</string></property></widget></item>
            </layout>
           </widget>
          </item>
         </layout>
        </item>

        <item><widget class="QFrame"><property name="frameShape"><enum>QFrame::HLine</enum></property><property name="styleSheet"><string>color:#EEF1F6;</string></property></widget></item>

        <!-- STEP 2: Missing Intervals -->
        <item>
         <layout class="QVBoxLayout"><property name="spacing"><number>8</number></property>
          <item>
           <layout class="QHBoxLayout"><property name="spacing"><number>8</number></property>
            <item><widget class="QLabel" name="sideStepNum"><property name="text"><string>2</string></property><property name="alignment"><set>AlignCenter</set></property></widget></item>
            <item><widget class="QLabel" name="sideStepTitle2"><property name="text"><string>Missing Intervals</string></property>
             <property name="styleSheet"><string>color:#1B3A6B;font-size:13px;font-weight:600;</string></property></widget></item>
            <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
           </layout>
          </item>
          <item>
           <widget class="QTableWidget" name="intervalsTable">
            <property name="minimumHeight"><number>100</number></property>
            <property name="maximumHeight"><number>120</number></property>
            <property name="columnCount"><number>4</number></property>
            <property name="rowCount"><number>2</number></property>
            <property name="showGrid"><bool>false</bool></property>
            <property name="alternatingRowColors"><bool>true</bool></property>
            <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
            <column><property name="text"><string>#</string></property></column>
            <column><property name="text"><string>Top (m)</string></property></column>
            <column><property name="text"><string>Base (m)</string></property></column>
            <column><property name="text"><string>Len (m)</string></property></column>
           </widget>
          </item>
          <item>
           <widget class="QPushButton">
            <property name="text"><string>+ Add Interval</string></property>
            <property name="styleSheet"><string>background:transparent;border:1px dashed #C8D1DC;border-radius:6px;color:#7A8AA0;padding:6px;font-size:12px;</string></property>
            <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
           </widget>
          </item>
         </layout>
        </item>

        <item><widget class="QFrame"><property name="frameShape"><enum>QFrame::HLine</enum></property><property name="styleSheet"><string>color:#EEF1F6;</string></property></widget></item>

        <!-- STEP 3: Model Configuration -->
        <item>
         <layout class="QVBoxLayout"><property name="spacing"><number>8</number></property>
          <item>
           <layout class="QHBoxLayout"><property name="spacing"><number>8</number></property>
            <item><widget class="QLabel" name="sideStepNum2"><property name="text"><string>3</string></property><property name="alignment"><set>AlignCenter</set></property>
             <property name="styleSheet"><string>background:#1D6FE8;border-radius:10px;color:#FFFFFF;font-size:10px;font-weight:700;min-width:20px;max-width:20px;min-height:20px;max-height:20px;padding:2px;</string></property></widget></item>
            <item><widget class="QLabel" name="sideStepTitle3"><property name="text"><string>Model Configuration</string></property>
             <property name="styleSheet"><string>color:#1B3A6B;font-size:13px;font-weight:600;</string></property></widget></item>
            <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
           </layout>
          </item>
          <!-- Algorithm -->
          <item><widget class="QLabel"><property name="text"><string>Algorithm</string></property>
           <property name="styleSheet"><string>color:#7A8AA0;font-size:11px;font-weight:500;</string></property></widget></item>
          <item>
           <widget class="QComboBox" name="algorithmCombo">
            <item><property name="text"><string>Random Forest Regressor</string></property></item>
            <item><property name="text"><string>Gradient Boosting (XGBoost)</string></property></item>
            <item><property name="text"><string>Neural Network (MLP)</string></property></item>
            <item><property name="text"><string>Support Vector Regression</string></property></item>
            <item><property name="text"><string>Ensemble (Stacked)</string></property></item>
           </widget>
          </item>
          <!-- Cross Validation -->
          <item><widget class="QLabel"><property name="text"><string>Cross Validation</string></property>
           <property name="styleSheet"><string>color:#7A8AA0;font-size:11px;font-weight:500;</string></property></widget></item>
          <item>
           <widget class="QComboBox" name="cvCombo">
            <item><property name="text"><string>5-Fold</string></property></item>
            <item><property name="text"><string>10-Fold</string></property></item>
            <item><property name="text"><string>Leave-One-Out</string></property></item>
           </widget>
          </item>
          <!-- Test Split -->
          <item>
           <layout class="QHBoxLayout">
            <item><widget class="QLabel"><property name="text"><string>Test Split</string></property>
             <property name="styleSheet"><string>color:#7A8AA0;font-size:11px;</string></property></widget></item>
            <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
            <item><widget class="QLabel" name="testSplitLbl"><property name="text"><string>20%</string></property>
             <property name="styleSheet"><string>color:#1D6FE8;font-size:12px;font-weight:700;</string></property></widget></item>
           </layout>
          </item>
          <item>
           <widget class="QSlider" name="testSplitSlider">
            <property name="orientation"><enum>Qt::Horizontal</enum></property>
            <property name="minimum"><number>10</number></property>
            <property name="maximum"><number>40</number></property>
            <property name="value"><number>20</number></property>
           </widget>
          </item>
          <!-- Random State -->
          <item>
           <layout class="QHBoxLayout">
            <item><widget class="QLabel"><property name="text"><string>Random State</string></property>
             <property name="styleSheet"><string>color:#7A8AA0;font-size:11px;</string></property></widget></item>
            <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
            <item>
             <widget class="QSpinBox" name="randStateSpin">
              <property name="maximum"><number>999</number></property>
              <property name="value"><number>42</number></property>
              <property name="maximumWidth"><number>80</number></property>
             </widget>
            </item>
           </layout>
          </item>
          <!-- GPU -->
          <item>
           <layout class="QHBoxLayout">
            <item><widget class="QLabel"><property name="text"><string>GPU Acceleration</string></property>
             <property name="styleSheet"><string>color:#7A8AA0;font-size:11px;</string></property></widget></item>
            <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
            <item>
             <widget class="QPushButton" name="gpuToggle">
              <property name="text"><string></string></property>
              <property name="checkable"><bool>true</bool></property>
              <property name="checked"><bool>true</bool></property>
              <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </item>

        <item><widget class="QFrame"><property name="frameShape"><enum>QFrame::HLine</enum></property><property name="styleSheet"><string>color:#EEF1F6;</string></property></widget></item>

        <!-- STEP 4: Feature Selection -->
        <item>
         <layout class="QVBoxLayout"><property name="spacing"><number>8</number></property>
          <item>
           <layout class="QHBoxLayout"><property name="spacing"><number>8</number></property>
            <item><widget class="QLabel" name="sideStepNum3"><property name="text"><string>4</string></property><property name="alignment"><set>AlignCenter</set></property>
             <property name="styleSheet"><string>background:#1D6FE8;border-radius:10px;color:#FFFFFF;font-size:10px;font-weight:700;min-width:20px;max-width:20px;min-height:20px;max-height:20px;padding:2px;</string></property></widget></item>
            <item><widget class="QLabel" name="sideStepTitle4"><property name="text"><string>Feature Selection</string></property>
             <property name="styleSheet"><string>color:#1B3A6B;font-size:13px;font-weight:600;</string></property></widget></item>
            <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
           </layout>
          </item>
          <item>
           <layout class="QHBoxLayout">
            <item><widget class="QLabel" name="featCount"><property name="text"><string>7 features selected</string></property></widget></item>
            <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
            <item><widget class="QPushButton" name="btnEditFeatures"><property name="text"><string>✎ Edit Features</string></property><property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property></widget></item>
           </layout>
          </item>
          <item>
