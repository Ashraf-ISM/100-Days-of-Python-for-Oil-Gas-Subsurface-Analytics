            <property name="text"><string>⬛  Feature Correlation Matrix</string></property>
            <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
           </widget>
          </item>
         </layout>
        </item>

        <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>

        <!-- TRAIN button -->
