         <property name="styleSheet"><string>color:#DDE2EA; margin: 8px 4px;</string></property>
        </widget>
       </item>

       <item>
        <widget class="QPushButton" name="btnLoadLAS">
         <property name="text"><string>⬆  Load LAS</string></property>
         <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
        </widget>
