           <!-- Main log canvas -->
           <item>
            <widget class="QFrame" name="logCanvas">
             <property name="minimumHeight"><number>380</number></property>
             <layout class="QVBoxLayout">
              <item>
               <widget class="QLabel">
                <property name="text"><string>[ Well Log Track — QCustomPlot / Matplotlib Canvas ]
Multiple tracks with depth axis · Missing intervals highlighted in red
Actual trace (blue) · Predicted trace (teal) · 95% confidence band (grey)
Depth range: 3,918 – 4,145 m ]</string></property>
                <property name="alignment"><set>AlignCenter</set></property>
