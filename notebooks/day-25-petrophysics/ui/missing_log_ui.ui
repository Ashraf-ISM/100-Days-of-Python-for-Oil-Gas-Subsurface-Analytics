      <!-- END sidebar -->

      <!-- ═══════════════════════
           CENTRE WORKSPACE
           ═══════════════════════ -->
      <widget class="QWidget" name="workspace">
       <layout class="QVBoxLayout" name="workspaceLayout">
        <property name="contentsMargins"><rect><x>16</x><y>16</y><width>16</width><height>16</height></rect></property>
        <property name="spacing"><number>12</number></property>

        <!-- Workspace card -->
        <item>
         <widget class="QFrame" name="workspaceCard">
          <layout class="QVBoxLayout" name="wsCardLayout">
           <property name="contentsMargins"><rect><x>0</x><y>0</y><width>0</width><height>0</height></rect></property>
           <property name="spacing"><number>0</number></property>

           <!-- Card header -->
           <item>
            <widget class="QWidget">
             <property name="styleSheet"><string>background:#FFFFFF;border-bottom:1px solid #EEF1F6;border-radius:12px 12px 0 0;padding:12px 16px;</string></property>
             <layout class="QHBoxLayout" name="wsHeaderLayout">
              <property name="contentsMargins"><rect><x>16</x><y>12</y><width>16</width><height>12</height></rect></property>
              <property name="spacing"><number>12</number></property>
              <item>
               <layout class="QVBoxLayout"><property name="spacing"><number>1</number></property>
                <item><widget class="QLabel" name="workspaceTitle"><property name="text"><string>Prediction Workspace</string></property></widget></item>
                <item><widget class="QLabel" name="workspaceSub"><property name="text"><string>Depth: 3,918 – 4,145 m  ·  Interactive log track view</string></property></widget></item>
               </layout>
              </item>
              <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
              <!-- Legend -->
              <item>
               <layout class="QHBoxLayout"><property name="spacing"><number>6</number></property>
                <item><widget class="QLabel" name="legendChip"><property name="text"><string>— Actual</string></property>
                 <property name="styleSheet"><string>background:#EFF4FE;border:1px solid #C3D9FC;border-radius:5px;color:#1D6FE8;font-size:11px;font-weight:600;padding:3px 8px;</string></property></widget></item>
                <item><widget class="QLabel" name="legendChip2"><property name="text"><string>— Predicted</string></property>
                 <property name="styleSheet"><string>background:#E6FFF9;border:1px solid #8ADCD4;border-radius:5px;color:#0C7A75;font-size:11px;font-weight:600;padding:3px 8px;</string></property></widget></item>
                <item><widget class="QLabel" name="legendChip3"><property name="text"><string>▓ 95% CI</string></property>
                 <property name="styleSheet"><string>background:#F5F7FA;border:1px solid #DDE2EA;border-radius:5px;color:#7A8AA0;font-size:11px;padding:3px 8px;</string></property></widget></item>
                <item><widget class="QLabel" name="legendChip4"><property name="text"><string>■ Missing</string></property>
                 <property name="styleSheet"><string>background:#FDECEA;border:1px solid #F5B8B8;border-radius:5px;color:#D94040;font-size:11px;font-weight:600;padding:3px 8px;</string></property></widget></item>
               </layout>
              </item>
              <!-- Auto scale toggle -->
              <item>
               <layout class="QHBoxLayout"><property name="spacing"><number>6</number></property>
                <item><widget class="QLabel"><property name="text"><string>Auto Scale</string></property>
                 <property name="styleSheet"><string>color:#7A8AA0;font-size:11px;</string></property></widget></item>
                <item><widget class="QPushButton" name="autoScaleToggle"><property name="text"><string></string></property>
                 <property name="checkable"><bool>true</bool></property><property name="checked"><bool>true</bool></property>
                 <property name="styleSheet"><string>background:#1A9E5C;border:none;border-radius:11px;min-width:42px;max-width:42px;min-height:22px;max-height:22px;</string></property>
                 <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property></widget></item>
               </layout>
              </item>
              <!-- Toolbar icons -->
              <item>
               <layout class="QHBoxLayout"><property name="spacing"><number>2</number></property>
                <item><widget class="QPushButton"><property name="text"><string>🔍</string></property><property name="styleSheet"><string>background:transparent;border:none;font-size:14px;padding:4px 6px;</string></property></widget></item>
                <item><widget class="QPushButton"><property name="text"><string>🔎</string></property><property name="styleSheet"><string>background:transparent;border:none;font-size:14px;padding:4px 6px;</string></property></widget></item>
                <item><widget class="QPushButton"><property name="text"><string>⛶</string></property><property name="styleSheet"><string>background:transparent;border:none;font-size:14px;padding:4px 6px;</string></property></widget></item>
                <item><widget class="QPushButton"><property name="text"><string>⋯</string></property><property name="styleSheet"><string>background:transparent;border:none;font-size:14px;padding:4px 6px;</string></property></widget></item>
               </layout>
              </item>
             </layout>
            </widget>
           </item>

           <!-- Column headers row -->
           <item>
            <widget class="QWidget">
             <property name="styleSheet"><string>background:#FAFBFC;border-bottom:1px solid #EEF1F6;padding:6px 16px;</string></property>
             <layout class="QHBoxLayout" name="colHeaderLayout">
              <property name="contentsMargins"><rect><x>16</x><y>6</y><width>16</width><height>6</height></rect></property>
