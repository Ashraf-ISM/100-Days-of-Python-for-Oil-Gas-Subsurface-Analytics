        <!-- Bottom panels row: Training Summary | Log | Model Status -->
        <item>
         <layout class="QHBoxLayout" name="bottomPanelsRow">
          <property name="spacing"><number>12</number></property>

          <!-- Training Summary -->
          <item>
           <widget class="QFrame" name="panelSm">
            <layout class="QVBoxLayout" name="trainSumLayout">
             <property name="contentsMargins"><rect><x>14</x><y>12</y><width>14</width><height>12</height></rect></property>
             <property name="spacing"><number>8</number></property>
             <item>
              <layout class="QHBoxLayout">
               <item><widget class="QLabel" name="panelSmTitle"><property name="text"><string>Training Summary</string></property></widget></item>
               <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
              </layout>
             </item>
             <item>
              <layout class="QGridLayout"><property name="spacing"><number>6</number></property>
               <item row="0" column="0"><widget class="QLabel" name="trainKey3"><property name="text"><string>Algorithm</string></property><property name="styleSheet"><string>color:#7A8AA0;font-size:11px;</string></property></widget></item>
               <item row="0" column="1"><widget class="QLabel" name="trainVal3"><property name="text"><string>Random Forest Regressor</string></property><property name="styleSheet"><string>color:#3A4558;font-size:11px;font-weight:600;</string></property></widget></item>
               <item row="1" column="0"><widget class="QLabel" name="trainKey4"><property name="text"><string>Features Used</string></property><property name="styleSheet"><string>color:#7A8AA0;font-size:11px;</string></property></widget></item>
               <item row="1" column="1"><widget class="QLabel" name="trainVal4"><property name="text"><string>7</string></property><property name="styleSheet"><string>color:#3A4558;font-size:11px;font-weight:600;</string></property></widget></item>
               <item row="2" column="0"><widget class="QLabel" name="trainKey5"><property name="text"><string>Validation Samples</string></property><property name="styleSheet"><string>color:#7A8AA0;font-size:11px;</string></property></widget></item>
               <item row="2" column="1"><widget class="QLabel" name="trainVal5"><property name="text"><string>3,842</string></property><property name="styleSheet"><string>color:#3A4558;font-size:11px;font-weight:600;</string></property></widget></item>
