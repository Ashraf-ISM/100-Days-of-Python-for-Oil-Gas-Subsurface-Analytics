          </widget>
         </item>
         <item>
          <layout class="QVBoxLayout">
           <property name="spacing"><number>0</number></property>
           <item><widget class="QLabel" name="brandName"><property name="text"><string>PetroARX</string></property></widget></item>
           <item><widget class="QLabel" name="brandSub"><property name="text"><string>AI Analytics</string></property></widget></item>
          </layout>
         </item>
        </layout>
       </item>

       <item>
        <widget class="QFrame" name="topSepV">
         <property name="frameShape"><enum>QFrame::VLine</enum></property>
         <property name="styleSheet"><string>color:#DDE2EA; margin: 8px 4px;</string></property>
        </widget>
       </item>

       <!-- Project -->
       <item>
        <layout class="QVBoxLayout">
         <property name="spacing"><number>1</number></property>
         <item><widget class="QLabel" name="topBarCtxLabel"><property name="text"><string>PROJECT</string></property></widget></item>
         <item>
          <widget class="QComboBox" name="projectCombo">
           <item><property name="text"><string>Shale_Prospect_X</string></property></item>
