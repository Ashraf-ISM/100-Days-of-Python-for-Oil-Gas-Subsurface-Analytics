  <property name="styleSheet">
   <string notr="true">
/* ─── GLOBAL ──────────────────────────────────────────── */
QMainWindow, QWidget#centralWidget {
    background-color: #0d1117;
    color: #e6edf3;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
}

/* ─── TOP HEADER BAR ──────────────────────────────────── */
QWidget#headerBar {
    background-color: #161b22;
    border-bottom: 1px solid #21262d;
    min-height: 54px;
    max-height: 54px;
}
QLabel#appTitle {
    color: #e6edf3;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.3px;
}
QLabel#appSubtitle {
    color: #8b949e;
    font-size: 12px;
}
QPushButton#btnDoc, QPushButton#btnVideo, QPushButton#btnHelp {
    background: transparent;
    color: #8b949e;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 5px 14px;
    font-size: 12px;
}
QPushButton#btnDoc:hover, QPushButton#btnVideo:hover, QPushButton#btnHelp:hover {
    color: #e6edf3;
    border-color: #58a6ff;
    background: #1f2937;
}

/* ─── LEFT SIDEBAR ─────────────────────────────────────── */
QWidget#sidebarWidget {
    background-color: #161b22;
    border-right: 1px solid #21262d;
    min-width: 240px;
    max-width: 240px;
}
QLabel#sidebarSectionLabel {
    color: #8b949e;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    padding: 16px 16px 6px 16px;
}
QLabel#targetLogLabel {
    color: #8b949e;
    font-size: 11px;
    padding-left: 2px;
}
QLineEdit#targetLogEdit {
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
    color: #e6edf3;
    padding: 7px 10px;
    font-size: 13px;
    selection-background-color: #1f6feb;
}
QLineEdit#targetLogEdit:focus {
    border-color: #388bfd;
    background: #0d1117;
}
QLabel#dataInfoLabel {
    color: #8b949e;
    font-size: 11px;
    line-height: 1.6;
}
QLabel#missingBadge {
    background: rgba(248, 81, 73, 0.15);
    color: #f85149;
    border: 1px solid rgba(248, 81, 73, 0.3);
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#intervalBadge {
    color: #58a6ff;
    font-size: 11px;
    text-decoration: underline;
}
QPushButton#btnAutoSelect {
    background: #1f2937;
    border: 1px solid #30363d;
    border-radius: 6px;
    color: #c9d1d9;
    padding: 7px 0;
    font-size: 12px;
}
QPushButton#btnAutoSelect:hover {
    border-color: #58a6ff;
    color: #58a6ff;
}
QPushButton#btnFeatureEng {
    background: rgba(56, 139, 253, 0.12);
    border: 1px solid rgba(56, 139, 253, 0.4);
    border-radius: 6px;
    color: #58a6ff;
    padding: 7px 0;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#btnFeatureEng:hover {
    background: rgba(56, 139, 253, 0.22);
}
QPushButton#btnCorrMatrix {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1f3a5f, stop:1 #1a3052);
    border: 1px solid #2d5a8e;
    border-radius: 8px;
    color: #79c0ff;
    padding: 10px 0;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#btnCorrMatrix:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #264a75, stop:1 #1f3f68);
}

/* ─── FEATURE LIST (QListWidget) ───────────────────────── */
QListWidget#featureList {
    background: #0d1117;
    border: 1px solid #21262d;
    border-radius: 6px;
    color: #c9d1d9;
    font-size: 12px;
    padding: 4px;
}
QListWidget#featureList::item {
    padding: 5px 8px;
    border-radius: 4px;
}
QListWidget#featureList::item:selected {
    background: rgba(56, 139, 253, 0.2);
    color: #79c0ff;
}
QListWidget#featureList::item:hover {
    background: #1c2128;
}
QCheckBox {
    color: #c9d1d9;
    font-size: 12px;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #30363d;
    border-radius: 3px;
    background: #0d1117;
}
QCheckBox::indicator:checked {
    background: #1f6feb;
    border-color: #388bfd;
}

/* ─── MAIN CONTENT AREA ─────────────────────────────────── */
QWidget#mainContent {
    background: #0d1117;
}

/* ─── PANEL / CARD STYLE ─────────────────────────────────── */
QFrame#panelCard {
    background: #161b22;
    border: 1px solid #21262d;
    border-radius: 10px;
}
QLabel#panelTitle {
    color: #8b949e;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.0px;
    text-transform: uppercase;
}
QLabel#panelIndex {
    color: #388bfd;
    font-size: 10px;
    font-weight: 700;
}

/* ─── MODEL CONFIG PANEL ────────────────────────────────── */
QComboBox {
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
    color: #e6edf3;
    padding: 7px 10px;
    font-size: 13px;
    min-width: 6em;
}
QComboBox:hover { border-color: #58a6ff; }
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}
QComboBox QAbstractItemView {
    background: #161b22;
    border: 1px solid #30363d;
    color: #e6edf3;
    selection-background-color: #1f6feb;
    border-radius: 6px;
}
QLabel#configKey {
    color: #8b949e;
    font-size: 12px;
}
QLabel#configVal {
    color: #e6edf3;
    font-size: 12px;
    font-weight: 500;
}
QSpinBox, QDoubleSpinBox {
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
    color: #e6edf3;
    padding: 6px 8px;
    font-size: 13px;
}
QSpinBox:focus, QDoubleSpinBox:focus { border-color: #388bfd; }

/* ─── SLIDER ───────────────────────────────────────────── */
QSlider::groove:horizontal {
    height: 4px;
    background: #21262d;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #388bfd;
    border: 2px solid #161b22;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::sub-page:horizontal {
    background: #1f6feb;
    border-radius: 2px;
}

/* ─── TOGGLE SWITCH (custom via QPushButton) ────────────── */
QPushButton#toggleOn {
    background: #238636;
    border: none;
    border-radius: 10px;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 10px;
    min-width: 44px;
    max-width: 44px;
    min-height: 20px;
    max-height: 20px;
}
QPushButton#toggleOff {
    background: #21262d;
    border: 1px solid #30363d;
    border-radius: 10px;
    color: #8b949e;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 10px;
    min-width: 44px;
    max-width: 44px;
    min-height: 20px;
    max-height: 20px;
}

/* ─── METRICS BAR (top-right KPIs) ─────────────────────── */
QWidget#metricsBar {
    background: #161b22;
    border-left: 1px solid #21262d;
    min-width: 280px;
    max-width: 280px;
}
QLabel#kpiValue {
    font-size: 26px;
    font-weight: 700;
    color: #3fb950;
    letter-spacing: -0.5px;
}
QLabel#kpiValueAlt {
    font-size: 26px;
    font-weight: 700;
    color: #f0883e;
    letter-spacing: -0.5px;
}
QLabel#kpiUnit {
    color: #8b949e;
    font-size: 11px;
}
QLabel#kpiKey {
    color: #8b949e;
    font-size: 11px;
    font-weight: 500;
}
QLabel#kpiSmall {
    color: #c9d1d9;
    font-size: 13px;
    font-weight: 600;
}
QLabel#cccValue {
    color: #3fb950;
    font-size: 22px;
    font-weight: 700;
}

/* ─── PROGRESS BAR ──────────────────────────────────────── */
QProgressBar {
    background: #21262d;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: transparent;
    max-height: 6px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #388bfd, stop:1 #56d364);
    border-radius: 4px;
}
QProgressBar#modelBar {
    max-height: 4px;
    background: #21262d;
}
QProgressBar#modelBar::chunk {
    background: #388bfd;
    border-radius: 2px;
}
QProgressBar#modelBarNeg::chunk {
    background: #f85149;
    border-radius: 2px;
}

/* ─── TRAINING LOG ──────────────────────────────────────── */
QTextEdit#trainingLog {
    background: #010409;
    border: 1px solid #21262d;
    border-radius: 6px;
    color: #3fb950;
    font-family: "JetBrains Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
    padding: 8px;
}

/* ─── TABLE WIDGET ──────────────────────────────────────── */
QTableWidget {
    background: #0d1117;
    alternate-background-color: #161b22;
    border: none;
    color: #c9d1d9;
    font-size: 12px;
    gridline-color: #21262d;
    selection-background-color: rgba(56, 139, 253, 0.2);
    selection-color: #e6edf3;
}
QTableWidget::item { padding: 6px 10px; }
QHeaderView::section {
    background: #161b22;
    color: #8b949e;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
    border: none;
    border-bottom: 1px solid #21262d;
    padding: 7px 10px;
}
QScrollBar:vertical, QScrollBar:horizontal {
    background: #0d1117;
    width: 8px;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #30363d;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #58a6ff;
}
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }

/* ─── BOTTOM ACTION BAR ─────────────────────────────────── */
QWidget#actionBar {
    background: #161b22;
    border-top: 1px solid #21262d;
    min-height: 56px;
    max-height: 56px;
}
QPushButton#btnBack {
    background: transparent;
    border: 1px solid #30363d;
    border-radius: 7px;
    color: #8b949e;
    padding: 9px 20px;
    font-size: 13px;
}
QPushButton#btnBack:hover { border-color: #8b949e; color: #c9d1d9; }
QPushButton#btnReset {
    background: rgba(248, 81, 73, 0.1);
    border: 1px solid rgba(248, 81, 73, 0.3);
    border-radius: 7px;
    color: #f85149;
    padding: 9px 20px;
    font-size: 13px;
}
QPushButton#btnReset:hover { background: rgba(248, 81, 73, 0.2); }
QPushButton#btnPreview {
    background: #1f2937;
    border: 1px solid #388bfd;
    border-radius: 7px;
    color: #79c0ff;
    padding: 9px 22px;
    font-size: 13px;
    font-weight: 500;
}
QPushButton#btnPreview:hover { background: rgba(56, 139, 253, 0.15); }
QPushButton#btnApply {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1a7f37, stop:1 #196c2e);
    border: 1px solid #238636;
    border-radius: 7px;
    color: #ffffff;
    padding: 9px 22px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#btnApply:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #238636, stop:1 #1f7a32);
}
QPushButton#btnExport {
    background: #1f2937;
    border: 1px solid #30363d;
    border-radius: 7px;
    color: #c9d1d9;
    padding: 9px 20px;
    font-size: 13px;
}
QPushButton#btnExport:hover { border-color: #8b949e; }

/* ─── TAB WIDGET ─────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #21262d;
    border-radius: 8px;
    background: #0d1117;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: #8b949e;
    padding: 8px 18px;
    font-size: 12px;
}
QTabBar::tab:selected {
    color: #e6edf3;
    border-bottom: 2px solid #388bfd;
}
QTabBar::tab:hover { color: #c9d1d9; }

/* ─── MISC ─────────────────────────────────────────────── */
QSplitter::handle { background: #21262d; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
QToolTip {
    background: #161b22;
    border: 1px solid #30363d;
    color: #e6edf3;
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 12px;
}
