<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>DataDownloaderWindow</class>
 <widget class="QMainWindow" name="DataDownloaderWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1280</width>
    <height>860</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>PetroARX — Data Downloader</string>
  </property>
  <property name="styleSheet">
   <string notr="true">

/* ═══════════════════════════════════════════════
   PETROARX DATA DOWNLOADER — LIGHT THEME
   ═══════════════════════════════════════════════ */

QMainWindow, QDialog {
    background-color: #F4F6F9;
}

/* ── TOP HEADER FRAME ── */
#headerFrame {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1A3A5C, stop:1 #2E6DA4);
    border-bottom: 2px solid #1A3A5C;
}

#headerTitle {
    color: #FFFFFF;
    font-family: "Segoe UI";
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

#headerSubtitle {
    color: #A8C8E8;
    font-family: "Segoe UI";
    font-size: 11px;
    font-weight: 400;
}

#headerIcon {
    color: #F0C040;
    font-family: "Segoe UI";
    font-size: 26px;
}

/* ── TOOLBAR ── */
#toolbarFrame {
    background-color: #FFFFFF;
    border-bottom: 1px solid #DDE3EC;
    padding: 4px 0px;
}

/* ── SEARCH BAR ── */
#searchLineEdit {
    background-color: #F0F4FA;
    border: 1px solid #C8D4E3;
    border-radius: 6px;
    padding: 6px 12px 6px 36px;
    font-family: "Segoe UI";
    font-size: 12px;
    color: #2C3E50;
    min-width: 300px;
    max-height: 34px;
}
#searchLineEdit:focus {
    border: 1.5px solid #2E6DA4;
    background-color: #FFFFFF;
}

#searchLabel {
    color: #5A7A99;
    font-size: 14px;
}

/* ── FILTER COMBO BOXES ── */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #C8D4E3;
    border-radius: 5px;
    padding: 5px 28px 5px 10px;
    font-family: "Segoe UI";
    font-size: 11px;
    color: #2C3E50;
    min-width: 130px;
    max-height: 30px;
}
QComboBox:hover {
    border-color: #2E6DA4;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #5A7A99;
    width: 0;
    height: 0;
    margin-right: 6px;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #C8D4E3;
    border-radius: 4px;
    selection-background-color: #E8F0FA;
    selection-color: #1A3A5C;
    font-family: "Segoe UI";
    font-size: 11px;
    padding: 2px;
}

/* ── TOOLBAR BUTTONS ── */
#btnRefresh, #btnCopyLink, #btnOpenBrowser {
    background-color: #FFFFFF;
    border: 1px solid #C8D4E3;
    border-radius: 5px;
    padding: 5px 14px;
    font-family: "Segoe UI";
    font-size: 11px;
    font-weight: 500;
    color: #2C3E50;
    max-height: 30px;
}
#btnRefresh:hover, #btnCopyLink:hover, #btnOpenBrowser:hover {
    background-color: #E8F0FA;
    border-color: #2E6DA4;
    color: #1A3A5C;
}
#btnRefresh:pressed, #btnCopyLink:pressed, #btnOpenBrowser:pressed {
    background-color: #D0E4F5;
}

#btnAddLink {
    background-color: #2E6DA4;
    border: none;
    border-radius: 5px;
    padding: 5px 16px;
    font-family: "Segoe UI";
    font-size: 11px;
    font-weight: 600;
    color: #FFFFFF;
    max-height: 30px;
}
#btnAddLink:hover {
    background-color: #245A8A;
}
#btnAddLink:pressed {
    background-color: #1A3A5C;
}

/* ── MAIN TAB WIDGET ── */
#mainTabWidget {
    background-color: transparent;
}

QTabWidget::pane {
    background-color: #FFFFFF;
    border: 1px solid #DDE3EC;
    border-top: none;
    border-radius: 0px 0px 8px 8px;
}

QTabBar {
    background-color: transparent;
}

QTabBar::tab {
    background-color: #E8EEF6;
    border: 1px solid #C8D4E3;
    border-bottom: none;
    border-radius: 6px 6px 0px 0px;
    padding: 8px 18px;
    font-family: "Segoe UI";
    font-size: 11px;
    font-weight: 500;
    color: #5A7A99;
    margin-right: 2px;
    min-width: 110px;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #1A3A5C;
    font-weight: 700;
    border-bottom: 2px solid #FFFFFF;
    border-top: 2px solid #2E6DA4;
}

QTabBar::tab:hover:!selected {
    background-color: #D8E8F5;
    color: #2E6DA4;
}

/* ── TABLE WIDGET ── */
QTableWidget {
    background-color: #FFFFFF;
    gridline-color: #EDF1F7;
    border: none;
    font-family: "Segoe UI";
    font-size: 12px;
    color: #2C3E50;
    selection-background-color: #E0EDF8;
    selection-color: #1A3A5C;
    outline: none;
}

QTableWidget::item {
    padding: 6px 10px;
    border-bottom: 1px solid #EDF1F7;
}

QTableWidget::item:selected {
    background-color: #E0EDF8;
    color: #1A3A5C;
}

QTableWidget::item:alternate {
    background-color: #F8FAFE;
}

QHeaderView::section {
    background-color: #F0F4FA;
    color: #1A3A5C;
    font-family: "Segoe UI";
    font-size: 11px;
    font-weight: 700;
    padding: 8px 10px;
    border: none;
    border-bottom: 2px solid #2E6DA4;
    border-right: 1px solid #DDE3EC;
    letter-spacing: 0.3px;
    text-transform: uppercase;
}

QHeaderView::section:last {
    border-right: none;
}

/* ── TABLE ACTION BUTTONS ── */
#btnVisitLink {
    background-color: #2E6DA4;
    border: none;
    border-radius: 4px;
    padding: 4px 10px;
    font-family: "Segoe UI";
    font-size: 10px;
    font-weight: 600;
    color: #FFFFFF;
}
#btnVisitLink:hover {
    background-color: #245A8A;
}

/* ── SIDE PANEL ── */
#sidePanelFrame {
    background-color: #FFFFFF;
    border-left: 1px solid #DDE3EC;
    border-radius: 0px 8px 8px 0px;
}

#sidePanelTitle {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #F0F4FA, stop:1 #E8EEF6);
    color: #1A3A5C;
    font-family: "Segoe UI";
    font-size: 12px;
    font-weight: 700;
    padding: 10px 14px;
    border-bottom: 1px solid #DDE3EC;
    letter-spacing: 0.3px;
}

/* ── STAT CARDS ── */
#statCard {
    background-color: #F8FAFE;
    border: 1px solid #DDE3EC;
    border-radius: 8px;
    padding: 10px;
}

#statCardValue {
    color: #2E6DA4;
    font-family: "Segoe UI";
    font-size: 22px;
    font-weight: 700;
}

#statCardLabel {
    color: #7A9AB5;
    font-family: "Segoe UI";
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.4px;
}

/* ── CATEGORY BADGES ── */
#badgeSeismic {
    background-color: #E6F0FA;
    color: #1A5C9A;
    border-radius: 3px;
    padding: 2px 8px;
    font-family: "Segoe UI";
    font-size: 10px;
    font-weight: 600;
}
#badgeWellLog {
    background-color: #E6F8EE;
    color: #1A7A3C;
    border-radius: 3px;
    padding: 2px 8px;
    font-family: "Segoe UI";
    font-size: 10px;
    font-weight: 600;
}
#badgeGeo {
    background-color: #FDF3E6;
    color: #A05A00;
    border-radius: 3px;
    padding: 2px 8px;
    font-family: "Segoe UI";
    font-size: 10px;
    font-weight: 600;
}
#badgeFree {
    background-color: #EDF9EE;
    color: #267A30;
    border-radius: 3px;
    padding: 2px 8px;
    font-family: "Segoe UI";
    font-size: 10px;
    font-weight: 600;
}

/* ── LINK QUEUE / DOWNLOAD PANEL ── */
#downloadFrame {
    background-color: #FFFFFF;
    border-top: 2px solid #DDE3EC;
}

#downloadPanelTitle {
    color: #1A3A5C;
    font-family: "Segoe UI";
    font-size: 12px;
    font-weight: 700;
}

#linkListWidget {
    background-color: #F8FAFE;
    border: 1px solid #DDE3EC;
    border-radius: 6px;
    font-family: "Segoe UI";
    font-size: 11px;
    color: #2C3E50;
    outline: none;
}

#linkListWidget::item {
    padding: 5px 8px;
    border-bottom: 1px solid #EDF1F7;
}

#linkListWidget::item:selected {
    background-color: #E0EDF8;
    color: #1A3A5C;
}

QProgressBar {
    background-color: #E8EEF6;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    font-size: 0px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #2E6DA4, stop:1 #4A9FD4);
    border-radius: 4px;
}

/* ── DETAIL TEXT AREA ── */
#detailTextEdit {
    background-color: #F8FAFE;
    border: 1px solid #DDE3EC;
    border-radius: 6px;
    font-family: "Consolas", "Courier New";
    font-size: 11px;
    color: #2C3E50;
    padding: 8px;
}

/* ── SEPARATORS ── */
QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: #DDE3EC;
}

/* ── SCROLL BARS ── */
QScrollBar:vertical {
    background-color: #F4F6F9;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background-color: #B8C8D8;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background-color: #2E6DA4;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background-color: #F4F6F9;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background-color: #B8C8D8;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #2E6DA4;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ── STATUS BAR ── */
QStatusBar {
    background-color: #1A3A5C;
    color: #A8C8E8;
    font-family: "Segoe UI";
    font-size: 10px;
    border-top: 1px solid #2E6DA4;
    padding: 2px 8px;
}

QStatusBar QLabel {
    color: #A8C8E8;
    font-family: "Segoe UI";
    font-size: 10px;
}

/* ── TOOL TIPS ── */
QToolTip {
    background-color: #1A3A5C;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-family: "Segoe UI";
    font-size: 11px;
}

/* ── SPLITTER ── */
QSplitter::handle {
    background-color: #DDE3EC;
    width: 3px;
}
QSplitter::handle:hover {
    background-color: #2E6DA4;
}

/* ── CHECKBOXES ── */
QCheckBox {
    font-family: "Segoe UI";
    font-size: 11px;
    color: #2C3E50;
    spacing: 6px;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 1px solid #C8D4E3;
    background-color: #FFFFFF;
}
QCheckBox::indicator:checked {
    background-color: #2E6DA4;
    border-color: #2E6DA4;
}
QCheckBox::indicator:hover {
    border-color: #2E6DA4;
}

/* ── LINE EDIT (generic) ── */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #C8D4E3;
    border-radius: 5px;
    padding: 5px 10px;
    font-family: "Segoe UI";
    font-size: 11px;
    color: #2C3E50;
}
QLineEdit:focus {
    border-color: #2E6DA4;
}

/* ── LABELS ── */
QLabel {
    font-family: "Segoe UI";
    color: #2C3E50;
}

/* ── GROUP BOXES ── */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #DDE3EC;
    border-radius: 8px;
    margin-top: 18px;
    padding: 10px 8px 8px 8px;
    font-family: "Segoe UI";
    font-size: 11px;
    font-weight: 700;
    color: #1A3A5C;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    background-color: #FFFFFF;
    color: #1A3A5C;
}

   </string>
  </property>

  <!-- ╔══════════════════════════════════════╗
       ║         CENTRAL WIDGET               ║
       ╚══════════════════════════════════════╝ -->
  <widget class="QWidget" name="centralWidget">
   <layout class="QVBoxLayout" name="mainVLayout">
    <property name="spacing"><number>0</number></property>
    <property name="contentsMargins"><rect><x>0</x><y>0</y><x>0</x><y>0</y></rect></property>

    <!-- ══ HEADER ══ -->
    <item>
     <widget class="QFrame" name="headerFrame">
      <property name="minimumHeight"><number>64</number></property>
      <property name="maximumHeight"><number>64</number></property>
      <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
      <layout class="QHBoxLayout" name="headerLayout">
       <property name="contentsMargins"><rect><x>16</x><y>8</y><x>16</x><y>8</y></rect></property>
       <property name="spacing"><number>12</number></property>
       <item>
        <widget class="QLabel" name="headerIcon">
         <property name="text"><string>⛽</string></property>
        </widget>
       </item>
       <item>
        <layout class="QVBoxLayout" name="headerTextLayout">
         <property name="spacing"><number>2</number></property>
         <item>
          <widget class="QLabel" name="headerTitle">
           <property name="text"><string>PetroARX — Data Downloader</string></property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="headerSubtitle">
           <property name="text"><string>Seismic · Well Logs · Geophysical · Open Datasets · Research Repositories</string></property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <spacer>
         <property name="orientation"><enum>Qt::Horizontal</enum></property>
        </spacer>
       </item>
       <item>
        <layout class="QVBoxLayout">
         <property name="spacing"><number>2</number></property>
         <item>
          <widget class="QLabel" name="totalSourcesLbl">
           <property name="text"><string>150+ Verified Sources</string></property>
           <property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property>
           <property name="styleSheet"><string>color:#FFFFFF; font-family:'Segoe UI'; font-size:11px; font-weight:600;</string></property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="lastUpdatedLbl">
           <property name="text"><string>Last updated: April 2026</string></property>
           <property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property>
           <property name="styleSheet"><string>color:#A8C8E8; font-family:'Segoe UI'; font-size:10px;</string></property>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
    </item>

    <!-- ══ TOOLBAR ══ -->
    <item>
     <widget class="QFrame" name="toolbarFrame">
      <property name="minimumHeight"><number>48</number></property>
      <property name="maximumHeight"><number>48</number></property>
      <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
      <layout class="QHBoxLayout" name="toolbarLayout">
       <property name="contentsMargins"><rect><x>12</x><y>6</y><x>12</x><y>6</y></rect></property>
       <property name="spacing"><number>8</number></property>

       <!-- Search -->
       <item>
        <widget class="QLabel" name="searchIconLbl">
         <property name="text"><string>🔍</string></property>
         <property name="styleSheet"><string>font-size:14px; margin-right:-4px;</string></property>
        </widget>
       </item>
       <item>
        <widget class="QLineEdit" name="searchLineEdit">
         <property name="placeholderText"><string>Search sources, datasets, organizations…</string></property>
         <property name="clearButtonEnabled"><bool>true</bool></property>
        </widget>
       </item>

       <item>
        <widget class="QFrame" name="sep1">
         <property name="frameShape"><enum>QFrame::VLine</enum></property>
         <property name="frameShadow"><enum>QFrame::Sunken</enum></property>
        </widget>
       </item>

       <!-- Filter: Category -->
       <item>
        <widget class="QLabel" name="filterCatLbl">
         <property name="text"><string>Category:</string></property>
         <property name="styleSheet"><string>font-family:'Segoe UI'; font-size:11px; color:#5A7A99; font-weight:600;</string></property>
        </widget>
       </item>
       <item>
        <widget class="QComboBox" name="comboCategory">
         <item><property name="text"><string>All Categories</string></property></item>
         <item><property name="text"><string>🌊 Seismic Data</string></property></item>
         <item><property name="text"><string>🛢 Well Log Data</string></property></item>
         <item><property name="text"><string>🗺 Geological / GIS</string></property></item>
         <item><property name="text"><string>📡 Geophysical</string></property></item>
         <item><property name="text"><string>🌍 Satellite / Remote Sensing</string></property></item>
         <item><property name="text"><string>📚 Research / Publications</string></property></item>
         <item><property name="text"><string>🔧 Software / Tools</string></property></item>
        </widget>
       </item>

       <!-- Filter: Access -->
       <item>
        <widget class="QLabel" name="filterAccessLbl">
         <property name="text"><string>Access:</string></property>
         <property name="styleSheet"><string>font-family:'Segoe UI'; font-size:11px; color:#5A7A99; font-weight:600;</string></property>
        </widget>
       </item>
       <item>
        <widget class="QComboBox" name="comboAccess">
         <item><property name="text"><string>All Types</string></property></item>
         <item><property name="text"><string>✅ Free / Open Access</string></property></item>
         <item><property name="text"><string>🔑 Registration Required</string></property></item>
         <item><property name="text"><string>💳 Paid / Licensed</string></property></item>
         <item><property name="text"><string>🏛 Government / Public</string></property></item>
        </widget>
       </item>

       <!-- Filter: Region -->
       <item>
        <widget class="QLabel" name="filterRegionLbl">
         <property name="text"><string>Region:</string></property>
         <property name="styleSheet"><string>font-family:'Segoe UI'; font-size:11px; color:#5A7A99; font-weight:600;</string></property>
        </widget>
       </item>
       <item>
        <widget class="QComboBox" name="comboRegion">
         <item><property name="text"><string>Global</string></property></item>
         <item><property name="text"><string>North America</string></property></item>
         <item><property name="text"><string>South America</string></property></item>
         <item><property name="text"><string>Europe</string></property></item>
         <item><property name="text"><string>Middle East</string></property></item>
         <item><property name="text"><string>Asia Pacific</string></property></item>
         <item><property name="text"><string>Africa</string></property></item>
        </widget>
       </item>

       <item>
        <widget class="QFrame" name="sep2">
         <property name="frameShape"><enum>QFrame::VLine</enum></property>
         <property name="frameShadow"><enum>QFrame::Sunken</enum></property>
        </widget>
       </item>

       <item>
        <widget class="QPushButton" name="btnRefresh">
         <property name="text"><string>↻  Refresh</string></property>
         <property name="toolTip"><string>Reload all data sources</string></property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="btnCopyLink">
         <property name="text"><string>⎘  Copy Link</string></property>
         <property name="toolTip"><string>Copy selected source URL to clipboard</string></property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="btnOpenBrowser">
         <property name="text"><string>🌐  Open in Browser</string></property>
         <property name="toolTip"><string>Open selected source in default browser</string></property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="btnAddLink">
         <property name="text"><string>＋  Add Source</string></property>
         <property name="toolTip"><string>Add a custom data source link</string></property>
        </widget>
       </item>

      </layout>
     </widget>
    </item>

    <!-- ══ MAIN CONTENT SPLITTER ══ -->
    <item>
     <widget class="QSplitter" name="mainSplitter">
      <property name="orientation"><enum>Qt::Horizontal</enum></property>
      <property name="childrenCollapsible"><bool>false</bool></property>

      <!-- LEFT: TABS + TABLE -->
      <widget class="QWidget" name="leftPanelWidget">
       <layout class="QVBoxLayout" name="leftLayout">
        <property name="spacing"><number>0</number></property>
        <property name="contentsMargins"><rect><x>10</x><y>10</y><x>4</x><y>0</y></rect></property>

        <item>
         <widget class="QTabWidget" name="mainTabWidget">
          <property name="currentIndex"><number>0</number></property>

          <!-- ─── TAB 1: SEISMIC DATA ─── -->
          <widget class="QWidget" name="tabSeismic">
           <attribute name="title"><string>🌊  Seismic Data</string></attribute>
           <layout class="QVBoxLayout" name="seismicLayout">
            <property name="spacing"><number>8</number></property>
            <property name="contentsMargins"><rect><x>10</x><y>10</y><x>10</x><y>10</y></rect></property>

            <item>
             <widget class="QLabel" name="seismicDesc">
              <property name="text"><string>Global seismic reflection, refraction, and ambient noise datasets. Click a row to preview details, then use Open in Browser to access the portal.</string></property>
              <property name="wordWrap"><bool>true</bool></property>
              <property name="styleSheet"><string>color:#5A7A99; font-size:11px; padding:4px 0px 6px 0px;</string></property>
             </widget>
            </item>

            <item>
