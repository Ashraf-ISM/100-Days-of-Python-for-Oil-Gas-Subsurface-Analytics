     <property name="childrenCollapsible"><bool>false</bool></property>

     <!-- ═══════════ LEFT PANEL ═══════════════════════════ -->
     <widget class="QFrame" name="leftPanel">
      <property name="minimumWidth"><number>215</number></property>
      <property name="maximumWidth"><number>270</number></property>
      <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
      <layout class="QVBoxLayout" name="leftPanelLayout">
       <property name="spacing"><number>6</number></property>
       <property name="contentsMargins"><rect><x>7</x><y>7</y><width>7</width><height>7</height></rect></property>

       <!-- Wells Section Header -->
