      </widget></item>
      <item>
       <spacer>
        <property name="orientation"><enum>Qt::Horizontal</enum></property>
        <property name="sizeType"><enum>QSizePolicy::Expanding</enum></property>
       </spacer>
      </item>
      <item><widget class="QLabel" name="lblStatusRenderer">
       <property name="text"><string>Renderer: Matplotlib 3D  |  Tube Engine</string></property>
      </widget></item>
     </layout>
    </widget>
   </item>

  </layout>
