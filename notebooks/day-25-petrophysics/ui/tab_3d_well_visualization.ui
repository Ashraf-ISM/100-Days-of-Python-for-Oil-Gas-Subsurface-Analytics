        <property name="text"><string>Geometry: -- triangles</string></property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="lblStatusRenderer">
        <property name="text"><string>Renderer: PyVista / VTK</string></property>
       </widget>
      </item>
      <item>
       <spacer>
        <property name="orientation"><enum>Qt::Horizontal</enum></property>
        <property name="sizeType"><enum>QSizePolicy::Expanding</enum></property>
       </spacer>
      </item>
      <item>
       <widget class="QLabel" name="lblStatusCamera">
        <property name="text"><string>Perspective  |  Az: 45°  El: 30°  |  Zoom: 100%</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

  </layout>
 </widget>

