                 <property name="maximum"><double>99999.0</double></property>
                 <property name="decimals"><number>2</number></property>
                </widget></item>
               </layout>
              </item>
              <item>
               <layout class="QHBoxLayout">
                <item><widget class="QPushButton" name="btnAutoRange">
                 <property name="text"><string>Auto</string></property>
                 <property name="minimumHeight"><number>26</number></property>
                 <property name="toolTip"><string>Auto range from data</string></property>
                </widget></item>
                <item><widget class="QPushButton" name="btnCustomRange">
                 <property name="text"><string>Custom</string></property>
                 <property name="minimumHeight"><number>26</number></property>
                 <property name="styleSheet"><string>background:#E3F0FB;color:#1B3A6B;border:1px solid #B8D4EE;border-radius:3px;font-size:10px;</string></property>
                </widget></item>
               </layout>
              </item>
              <item><widget class="QCheckBox" name="chkLogScale">
               <property name="text"><string>Logarithmic Scale</string></property>
              </widget></item>
