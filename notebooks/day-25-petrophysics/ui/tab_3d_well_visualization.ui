           <!-- VISUALIZATION MODE -->
           <item>
            <widget class="QGroupBox" name="grpVisualizationMode">
             <property name="title"><string>Visualization Mode</string></property>
             <layout class="QVBoxLayout">
              <property name="spacing"><number>5</number></property>
              <property name="leftMargin"><number>9</number></property>
              <property name="topMargin"><number>9</number></property>
              <property name="rightMargin"><number>9</number></property>
              <property name="bottomMargin"><number>7</number></property>
              <item>
               <layout class="QGridLayout">
                <property name="spacing"><number>4</number></property>
                <item row="0" column="0">
                 <widget class="QPushButton" name="btnVisModeColorTube">
                  <property name="visModeBtn" stdset="0"><bool>true</bool></property>
                  <property name="text"><string>Color Tube + Ribbon</string></property>
                  <property name="checkable"><bool>true</bool></property>
                  <property name="checked"><bool>true</bool></property>
                  <property name="minimumHeight"><number>38</number></property>
                 </widget>
                </item>
                <item row="0" column="1">
                 <widget class="QPushButton" name="btnVisModeColorOnly">
                  <property name="visModeBtn" stdset="0"><bool>true</bool></property>
                  <property name="text"><string>Color Tube</string></property>
                  <property name="checkable"><bool>true</bool></property>
                  <property name="minimumHeight"><number>38</number></property>
                 </widget>
                </item>
                <item row="1" column="0">
                 <widget class="QPushButton" name="btnVisModeRadius">
                  <property name="visModeBtn" stdset="0"><bool>true</bool></property>
                  <property name="text"><string>Radius Tube</string></property>
                  <property name="checkable"><bool>true</bool></property>
                  <property name="minimumHeight"><number>38</number></property>
                 </widget>
                </item>
                <item row="1" column="1">
                 <widget class="QPushButton" name="btnVisModeRibbon">
                  <property name="visModeBtn" stdset="0"><bool>true</bool></property>
                  <property name="text"><string>Ribbon Only</string></property>
                  <property name="checkable"><bool>true</bool></property>
                  <property name="minimumHeight"><number>38</number></property>
                 </widget>
                </item>
                <item row="2" column="0">
                 <widget class="QPushButton" name="btnVisModePoints">
                  <property name="visModeBtn" stdset="0"><bool>true</bool></property>
                  <property name="text"><string>Points</string></property>
                  <property name="checkable"><bool>true</bool></property>
                  <property name="minimumHeight"><number>38</number></property>
                 </widget>
                </item>
                <item row="2" column="1">
                 <widget class="QPushButton" name="btnVisModeTrack">
                  <property name="visModeBtn" stdset="0"><bool>true</bool></property>
                  <property name="text"><string>Mini Track</string></property>
                  <property name="checkable"><bool>true</bool></property>
                  <property name="minimumHeight"><number>38</number></property>
                 </widget>
                </item>
               </layout>
              </item>
             </layout>
            </widget>
           </item>

           <!-- APPEARANCE -->
           <item>
            <widget class="QGroupBox" name="grpAppearance">
             <property name="title"><string>Appearance</string></property>
             <layout class="QVBoxLayout">
              <property name="spacing"><number>5</number></property>
              <property name="leftMargin"><number>9</number></property>
              <property name="topMargin"><number>9</number></property>
              <property name="rightMargin"><number>9</number></property>
              <property name="bottomMargin"><number>7</number></property>

              <item>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel" name="lblTrajRadius">
                 <property name="text"><string>Tube Radius</string></property>
                 <property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property>
                </widget></item>
                <item><widget class="QSlider" name="sliderTrajRadius">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="minimum"><number>1</number></property>
                 <property name="maximum"><number>30</number></property>
                 <property name="value"><number>5</number></property>
                </widget></item>
                <item><widget class="QLabel" name="lblTrajRadiusVal">
                 <property name="text"><string>18 px</string></property>
                 <property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:32px;</string></property>
                </widget></item>
               </layout>
              </item>

              <item>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel" name="lblOpacity">
                 <property name="text"><string>Tube Transparency</string></property>
                 <property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property>
                </widget></item>
                <item><widget class="QSlider" name="sliderOpacity">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="minimum"><number>10</number></property>
                 <property name="maximum"><number>100</number></property>
                 <property name="value"><number>100</number></property>
                </widget></item>
                <item><widget class="QLabel" name="lblOpacityVal">
                 <property name="text"><string>10%</string></property>
                 <property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:32px;</string></property>
                </widget></item>
               </layout>
              </item>

              <item>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel" name="lblTrajStyle">
