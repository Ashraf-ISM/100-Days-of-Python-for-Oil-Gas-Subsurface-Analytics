          <item>
           <widget class="QCheckBox" name="chkShowCompass">
            <property name="text"><string>N/S Compass Rose</string></property>
            <property name="checked"><bool>true</bool></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>

       <!-- Spacer -->
       <item>
        <spacer name="leftPanelSpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeType"><enum>QSizePolicy::Expanding</enum></property>
        </spacer>
       </item>

      </layout>
     </widget>

     <!-- ═══════════ CENTER: VIEWPORT + BOTTOM CONTROLS ═══ -->
     <widget class="QWidget" name="centerWidget">
      <layout class="QVBoxLayout" name="centerLayout">
       <property name="spacing"><number>5</number></property>
       <property name="contentsMargins"><rect><x>0</x><y>0</y><width>0</width><height>0</height></rect></property>

       <!-- 3D Viewport Frame -->
       <item>
        <widget class="QFrame" name="viewportFrame">
         <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
         <layout class="QVBoxLayout" name="viewportLayout">
          <property name="spacing"><number>0</number></property>
          <property name="contentsMargins"><rect><x>2</x><y>2</y><width>2</width><height>0</height></rect></property>

          <!-- OpenGL Viewport -->
          <item>
           <widget class="QOpenGLWidget" name="glWidget3D">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="minimumSize">
             <size><width>400</width><height>360</height></size>
            </property>
            <property name="toolTip">
             <string>3D Well Visualization Viewport
Left Drag: Rotate  |  Middle Drag: Pan  |  Scroll: Zoom
Double-Click: Select &amp; Query Point</string>
            </property>
           </widget>
          </item>

          <!-- Viewport Info Bar (overlaid at bottom) -->
          <item>
           <widget class="QFrame" name="viewportInfoBar">
            <property name="maximumHeight"><number>22</number></property>
            <layout class="QHBoxLayout">
             <property name="spacing"><number>14</number></property>
             <property name="contentsMargins"><rect><x>10</x><y>2</y><width>10</width><height>2</height></rect></property>
             <item>
              <widget class="QLabel" name="lblCursorX">
               <property name="text"><string>X: --</string></property>
               <property name="styleSheet"><string>color:#7EC8E3;font-size:10px;</string></property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="lblCursorY">
               <property name="text"><string>Y: --</string></property>
               <property name="styleSheet"><string>color:#7EC8E3;font-size:10px;</string></property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="lblCursorTVD">
               <property name="text"><string>TVD (m): --</string></property>
               <property name="styleSheet"><string>color:#F4C87A;font-size:10px;</string></property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="lblCursorMD">
               <property name="text"><string>MD (m): --</string></property>
               <property name="styleSheet"><string>color:#F4C87A;font-size:10px;</string></property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="lblPickedWell">
               <property name="text"><string>Well: --</string></property>
               <property name="styleSheet"><string>color:#6BCFA0;font-size:10px;</string></property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="lblPickedFormation">
               <property name="text"><string>Formation: --</string></property>
               <property name="styleSheet"><string>color:#C8A0F0;font-size:10px;</string></property>
              </widget>
             </item>
             <item>
              <spacer>
               <property name="orientation"><enum>Qt::Horizontal</enum></property>
               <property name="sizeType"><enum>QSizePolicy::Expanding</enum></property>
              </spacer>
             </item>
             <item>
              <widget class="QLabel" name="lblViewportProjection">
               <property name="text"><string>Perspective  |  Az: 45°  El: 30°</string></property>
               <property name="styleSheet"><string>color:#7AAFD4;font-size:10px;</string></property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>

         </layout>
        </widget>
       </item>

       <!-- ─── BOTTOM CONTROLS PANEL ─────────────────────── -->
       <item>
        <widget class="QFrame" name="bottomControlFrame">
         <property name="maximumHeight"><number>115</number></property>
         <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
         <layout class="QVBoxLayout" name="bottomControlLayout">
          <property name="spacing"><number>6</number></property>
          <property name="contentsMargins"><rect><x>12</x><y>7</y><width>12</width><height>7</height></rect></property>

          <!-- Row 1: Depth Range Clipping -->
          <item>
           <layout class="QHBoxLayout" name="depthRangeLayout">
            <property name="spacing"><number>8</number></property>
            <item>
             <widget class="QLabel" name="lblDepthRange">
              <property name="text"><string>Depth Range (m TVD):</string></property>
              <property name="styleSheet"><string>font-size:11px;font-weight:bold;color:#1B3A6B;min-width:150px;</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="lblDepthMinVal">
              <property name="text"><string>0</string></property>
              <property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:35px;</string></property>
             </widget>
            </item>
            <item>
             <widget class="QSlider" name="sliderDepthMin">
              <property name="orientation"><enum>Qt::Horizontal</enum></property>
              <property name="minimum"><number>0</number></property>
              <property name="maximum"><number>5000</number></property>
              <property name="value"><number>0</number></property>
              <property name="toolTip"><string>Top depth clip (m TVD)</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="lblDepthSep">
              <property name="text"><string>→</string></property>
              <property name="styleSheet"><string>font-size:10px;color:#888;</string></property>
             </widget>
            </item>
            <item>
             <widget class="QSlider" name="sliderDepthMax">
              <property name="orientation"><enum>Qt::Horizontal</enum></property>
              <property name="minimum"><number>0</number></property>
              <property name="maximum"><number>5000</number></property>
              <property name="value"><number>5000</number></property>
              <property name="toolTip"><string>Bottom depth clip (m TVD)</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="lblDepthMaxVal">
              <property name="text"><string>5000</string></property>
              <property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:40px;</string></property>
             </widget>
            </item>
            <!-- Separator -->
            <item>
             <widget class="QFrame" name="sepBottomV1">
              <property name="frameShape"><enum>QFrame::VLine</enum></property>
              <property name="styleSheet"><string>color:#D4DCE8;</string></property>
             </widget>
            </item>
            <!-- V. Exaggeration -->
            <item>
             <widget class="QLabel" name="lblVExag">
              <property name="text"><string>V. Exaggeration:</string></property>
              <property name="styleSheet"><string>font-size:11px;color:#1B3A6B;font-weight:bold;</string></property>
             </widget>
            </item>
            <item>
             <widget class="QSlider" name="sliderVExag">
              <property name="orientation"><enum>Qt::Horizontal</enum></property>
              <property name="minimum"><number>1</number></property>
              <property name="maximum"><number>20</number></property>
              <property name="value"><number>1</number></property>
              <property name="maximumWidth"><number>90</number></property>
              <property name="toolTip"><string>Vertical exaggeration factor</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="lblVExagVal">
              <property name="text"><string>1x</string></property>
              <property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:22px;</string></property>
             </widget>
            </item>
           </layout>
          </item>

          <!-- Row 2: Animation + Cross-Section -->
          <item>
           <layout class="QHBoxLayout" name="animCrossLayout">
            <property name="spacing"><number>8</number></property>

            <!-- Animation -->
            <item>
             <widget class="QLabel" name="lblAnimation">
              <property name="text"><string>Depth Animation:</string></property>
              <property name="styleSheet"><string>font-size:11px;color:#1B3A6B;font-weight:bold;</string></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btnAnimPlay">
              <property name="text"><string>▶ Play</string></property>
              <property name="maximumHeight"><number>24</number></property>
              <property name="maximumWidth"><number>58</number></property>
              <property name="toolTip"><string>Play depth sweep animation</string></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btnAnimStop">
              <property name="text"><string>■ Stop</string></property>
              <property name="maximumHeight"><number>24</number></property>
              <property name="maximumWidth"><number>58</number></property>
              <property name="toolTip"><string>Stop animation</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="lblAnimSpeed">
              <property name="text"><string>Speed:</string></property>
              <property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property>
             </widget>
            </item>
            <item>
             <widget class="QComboBox" name="cmbAnimSpeed">
              <property name="maximumWidth"><number>55</number></property>
              <item><property name="text"><string>0.5x</string></property></item>
              <item><property name="text"><string>1x</string></property></item>
              <item><property name="text"><string>2x</string></property></item>
              <item><property name="text"><string>5x</string></property></item>
             </widget>
            </item>

            <!-- Separator -->
            <item>
             <widget class="QFrame" name="sepBottomV2">
              <property name="frameShape"><enum>QFrame::VLine</enum></property>
              <property name="styleSheet"><string>color:#D4DCE8;</string></property>
             </widget>
            </item>

            <!-- Cross-Section -->
            <item>
             <widget class="QLabel" name="lblCrossSection">
              <property name="text"><string>Cross-Section:</string></property>
              <property name="styleSheet"><string>font-size:11px;color:#1B3A6B;font-weight:bold;</string></property>
             </widget>
            </item>
            <item>
             <widget class="QComboBox" name="cmbCrossSection">
              <property name="maximumWidth"><number>80</number></property>
              <item><property name="text"><string>None</string></property></item>
              <item><property name="text"><string>X-Plane</string></property></item>
              <item><property name="text"><string>Y-Plane</string></property></item>
              <item><property name="text"><string>Z-Plane</string></property></item>
              <item><property name="text"><string>Custom</string></property></item>
             </widget>
            </item>
            <item>
             <widget class="QSlider" name="sliderCrossSection">
              <property name="orientation"><enum>Qt::Horizontal</enum></property>
              <property name="minimum"><number>0</number></property>
              <property name="maximum"><number>100</number></property>
              <property name="value"><number>50</number></property>
              <property name="maximumWidth"><number>110</number></property>
              <property name="toolTip"><string>Cross-section position along selected axis</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="lblCrossSectionVal">
              <property name="text"><string>50%</string></property>
              <property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:28px;</string></property>
             </widget>
            </item>

            <!-- Spacer -->
            <item>
             <spacer>
              <property name="orientation"><enum>Qt::Horizontal</enum></property>
              <property name="sizeType"><enum>QSizePolicy::Expanding</enum></property>
             </spacer>
            </item>

            <!-- Well count indicator -->
            <item>
             <widget class="QLabel" name="lblWellCountIndicator">
              <property name="text"><string>Wells Visible: 0 / 0</string></property>
              <property name="styleSheet"><string>font-size:10px;color:#888;border:1px solid #D4DCE8;border-radius:3px;padding:2px 8px;background:#F5F8FC;</string></property>
             </widget>
            </item>
           </layout>
          </item>

         </layout>
        </widget>
       </item>

      </layout>
     </widget>

     <!-- ═══════════ RIGHT PANEL ══════════════════════════ -->
     <widget class="QFrame" name="rightPanel">
      <property name="minimumWidth"><number>228</number></property>
      <property name="maximumWidth"><number>285</number></property>
      <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
      <layout class="QVBoxLayout" name="rightPanelLayout">
       <property name="spacing"><number>6</number></property>
       <property name="contentsMargins"><rect><x>7</x><y>7</y><width>7</width><height>7</height></rect></property>

       <!-- Right Panel Tab Widget -->
       <item>
        <widget class="QTabWidget" name="rightTabWidget">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
           <horstretch>0</horstretch>
           <verstretch>0</verstretch>
          </sizepolicy>
         </property>
         <property name="currentIndex"><number>0</number></property>

         <!-- ─── TAB 1: Display ──────────────────────────── -->
         <widget class="QWidget" name="tabDisplay">
          <attribute name="title"><string>Display</string></attribute>
          <layout class="QVBoxLayout">
           <property name="spacing"><number>6</number></property>
           <property name="contentsMargins"><rect><x>4</x><y>6</y><width>4</width><height>4</height></rect></property>

           <!-- Trajectory Style -->
           <item>
            <widget class="QGroupBox" name="grpTrajStyle">
             <property name="title"><string>Trajectory Style</string></property>
             <layout class="QVBoxLayout">
              <property name="spacing"><number>5</number></property>
             <property name="contentsMargins"><rect><x>9</x><y>9</y><width>9</width><height>7</height></rect></property>
              <item>
               <layout class="QHBoxLayout">
                <item>
                 <widget class="QLabel" name="lblTrajStyle">
                  <property name="text"><string>Style:</string></property>
                  <property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QComboBox" name="cmbTrajStyle">
                  <item><property name="text"><string>Tube / Cylinder</string></property></item>
                  <item><property name="text"><string>Line</string></property></item>
                  <item><property name="text"><string>Ribbon</string></property></item>
                  <item><property name="text"><string>Dotted / Dashed</string></property></item>
                 </widget>
                </item>
               </layout>
              </item>
              <item>
               <layout class="QHBoxLayout">
                <item>
                 <widget class="QLabel" name="lblTrajRadius">
                  <property name="text"><string>Radius:</string></property>
                  <property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QSlider" name="sliderTrajRadius">
                  <property name="orientation"><enum>Qt::Horizontal</enum></property>
                  <property name="minimum"><number>1</number></property>
                  <property name="maximum"><number>20</number></property>
                  <property name="value"><number>5</number></property>
                 </widget>
                </item>
                <item>
                 <widget class="QLabel" name="lblTrajRadiusVal">
                  <property name="text"><string>5</string></property>
                  <property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:18px;</string></property>
                 </widget>
                </item>
               </layout>
              </item>
              <item>
               <layout class="QHBoxLayout">
                <item>
                 <widget class="QLabel" name="lblTrajColorBy">
                  <property name="text"><string>Color By:</string></property>
                  <property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QComboBox" name="cmbTrajColorBy">
                  <item><property name="text"><string>Well (Unique)</string></property></item>
                  <item><property name="text"><string>Log Curve</string></property></item>
                  <item><property name="text"><string>Formation Zone</string></property></item>
                  <item><property name="text"><string>Vshale</string></property></item>
                  <item><property name="text"><string>Porosity (PHIE)</string></property></item>
                  <item><property name="text"><string>Water Sat. (Sw)</string></property></item>
                  <item><property name="text"><string>Permeability (K)</string></property></item>
                  <item><property name="text"><string>Net Pay Flag</string></property></item>
                 </widget>
                </item>
               </layout>
              </item>
             </layout>
            </widget>
           </item>

           <!-- Background -->
           <item>
            <widget class="QGroupBox" name="grpBackground">
             <property name="title"><string>Scene Background</string></property>
             <layout class="QVBoxLayout">
              <property name="spacing"><number>5</number></property>
             <property name="contentsMargins"><rect><x>9</x><y>9</y><width>9</width><height>7</height></rect></property>
              <item>
               <layout class="QHBoxLayout">
                <item>
                 <widget class="QRadioButton" name="rdoBgDark">
                  <property name="text"><string>Dark</string></property>
                  <property name="checked"><bool>true</bool></property>
                 </widget>
                </item>
                <item>
                 <widget class="QRadioButton" name="rdoBgLight">
                  <property name="text"><string>Light</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QRadioButton" name="rdoBgGradient">
                  <property name="text"><string>Gradient</string></property>
                 </widget>
                </item>
               </layout>
              </item>
              <item>
               <layout class="QHBoxLayout">
                <item>
                 <widget class="QLabel" name="lblOpacity">
                  <property name="text"><string>Scene Opacity:</string></property>
                  <property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QSlider" name="sliderOpacity">
                  <property name="orientation"><enum>Qt::Horizontal</enum></property>
                  <property name="minimum"><number>20</number></property>
                  <property name="maximum"><number>100</number></property>
                  <property name="value"><number>100</number></property>
                 </widget>
                </item>
                <item>
                 <widget class="QLabel" name="lblOpacityVal">
                  <property name="text"><string>100%</string></property>
                  <property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:30px;</string></property>
                 </widget>
                </item>
               </layout>
              </item>
             </layout>
            </widget>
           </item>

           <!-- Labels & Annotations -->
           <item>
            <widget class="QGroupBox" name="grpLabels">
             <property name="title"><string>Labels &amp; Annotations</string></property>
             <layout class="QVBoxLayout">
              <property name="spacing"><number>4</number></property>
             <property name="contentsMargins"><rect><x>9</x><y>9</y><width>9</width><height>7</height></rect></property>
              <item>
               <widget class="QCheckBox" name="chkShowWellNames">
                <property name="text"><string>Well Names</string></property>
                <property name="checked"><bool>true</bool></property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="chkShowDepthLabels">
                <property name="text"><string>Depth Labels (MD/TVD)</string></property>
                <property name="checked"><bool>true</bool></property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="chkShowFormationLabels">
                <property name="text"><string>Formation Names</string></property>
                <property name="checked"><bool>false</bool></property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="chkShowValueLabels">
                <property name="text"><string>Log Values at Cursor</string></property>
                <property name="checked"><bool>true</bool></property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>

           <item>
            <spacer>
             <property name="orientation"><enum>Qt::Vertical</enum></property>
             <property name="sizeType"><enum>QSizePolicy::Expanding</enum></property>
            </spacer>
           </item>

          </layout>
         </widget>

         <!-- ─── TAB 2: Color Map ────────────────────────── -->
         <widget class="QWidget" name="tabColorMap">
          <attribute name="title"><string>Color Map</string></attribute>
          <layout class="QVBoxLayout">
           <property name="spacing"><number>6</number></property>
           <property name="contentsMargins"><rect><x>4</x><y>6</y><width>4</width><height>4</height></rect></property>

           <item>
            <widget class="QGroupBox" name="grpColorMapping">
             <property name="title"><string>Property Color Mapping</string></property>
             <layout class="QVBoxLayout">
              <property name="spacing"><number>6</number></property>
             <property name="contentsMargins"><rect><x>9</x><y>9</y><width>9</width><height>7</height></rect></property>

              <!-- Property -->
              <item>
               <layout class="QHBoxLayout">
                <item>
                 <widget class="QLabel" name="lblCmapProperty">
                  <property name="text"><string>Property:</string></property>
                  <property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property>
