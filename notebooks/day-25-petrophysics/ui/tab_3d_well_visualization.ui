           <!-- CURVE RANGE -->
           <item>
            <widget class="QGroupBox" name="grpCurveRange">
             <property name="title"><string>Curve Range</string></property>
             <layout class="QVBoxLayout">
              <property name="spacing"><number>5</number></property>
              <property name="leftMargin"><number>9</number></property>
              <property name="topMargin"><number>9</number></property>
              <property name="rightMargin"><number>9</number></property>
              <property name="bottomMargin"><number>7</number></property>
              <item>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel" name="lblCmapMin">
                 <property name="text"><string>Min:</string></property>
                 <property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property>
                </widget></item>
