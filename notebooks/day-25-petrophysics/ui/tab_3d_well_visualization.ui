               </layout>
              </item>

              <item><widget class="QCheckBox" name="chkShadows">
               <property name="text"><string>Smooth Curves</string></property>
               <property name="checked"><bool>true</bool></property>
              </widget></item>

              <!-- Background -->
              <item>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel">
                 <property name="text"><string>Background:</string></property>
