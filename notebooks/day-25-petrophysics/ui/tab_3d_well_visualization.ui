            </layout>
           </widget>
          </item>

         </layout>
        </widget>
       </item>

       <!-- ─── BOTTOM CONTROLS PANEL ─────────────────────── -->
       <item>
        <widget class="QFrame" name="bottomControlFrame">
         <property name="maximumHeight"><number>118</number></property>
         <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
         <layout class="QVBoxLayout" name="bottomControlLayout">
          <property name="spacing"><number>5</number></property>
          <property name="leftMargin"><number>12</number></property>
          <property name="topMargin"><number>6</number></property>
          <property name="rightMargin"><number>12</number></property>
          <property name="bottomMargin"><number>6</number></property>

          <!-- Row 1: Depth Range -->
          <item>
           <layout class="QHBoxLayout" name="depthRangeLayout">
            <property name="spacing"><number>6</number></property>
            <item><widget class="QLabel" name="lblDepthRange">
             <property name="text"><string>Depth (m): </string></property>
