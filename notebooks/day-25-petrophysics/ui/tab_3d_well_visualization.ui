                  <item><property name="text"><string>Porosity (PHIE)</string></property></item>
                  <item><property name="text"><string>Water Sat. (Sw)</string></property></item>
                  <item><property name="text"><string>Permeability (K)</string></property></item>
                  <item><property name="text"><string>Net Pay Flag</string></property></item>
                 </widget>
                </item>
               </layout>
              </item>

              <!-- Colormap -->
              <item>
               <layout class="QHBoxLayout">
                <item>
                 <widget class="QLabel" name="lblColormap">
                  <property name="text"><string>Colormap:</string></property>
                  <property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QComboBox" name="cmbColormap">
                  <item><property name="text"><string>Rainbow</string></property></item>
                  <item><property name="text"><string>Jet</string></property></item>
                  <item><property name="text"><string>Viridis</string></property></item>
                  <item><property name="text"><string>Plasma</string></property></item>
                  <item><property name="text"><string>Inferno</string></property></item>
                  <item><property name="text"><string>Hot</string></property></item>
                  <item><property name="text"><string>RdYlGn</string></property></item>
                  <item><property name="text"><string>Seismic</string></property></item>
                  <item><property name="text"><string>Petro (Custom)</string></property></item>
                 </widget>
                </item>
               </layout>
              </item>

              <!-- Colormap Preview Bar -->
              <item>
               <widget class="QLabel" name="lblColormapPreview">
                <property name="text"><string></string></property>
                <property name="minimumHeight"><number>24</number></property>
                <property name="toolTip"><string>Colormap preview — updates on selection</string></property>
                <property name="styleSheet">
                 <string>background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
                  stop:0 #0000FF, stop:0.25 #00FFFF,
                  stop:0.5 #00FF00, stop:0.75 #FFFF00,
                  stop:1 #FF0000);
                  border-radius: 3px;
                  border: 1px solid #C8D3E0;</string>
                </property>
               </widget>
              </item>

              <!-- Range -->
              <item>
               <layout class="QHBoxLayout">
                <item>
                 <widget class="QLabel" name="lblCmapMin">
                  <property name="text"><string>Min:</string></property>
                  <property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QDoubleSpinBox" name="spinCmapMin">
                  <property name="value"><double>0.0</double></property>
                  <property name="maximum"><double>99999.0</double></property>
                  <property name="decimals"><number>2</number></property>
                  <property name="toolTip"><string>Colormap lower bound</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QLabel" name="lblCmapMax">
                  <property name="text"><string>Max:</string></property>
                  <property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QDoubleSpinBox" name="spinCmapMax">
                  <property name="value"><double>150.0</double></property>
                  <property name="maximum"><double>99999.0</double></property>
                  <property name="decimals"><number>2</number></property>
                  <property name="toolTip"><string>Colormap upper bound</string></property>
                 </widget>
                </item>
               </layout>
              </item>

              <item>
               <widget class="QPushButton" name="btnAutoRange">
                <property name="text"><string>⊙  Auto Range from Loaded Data</string></property>
                <property name="maximumHeight"><number>26</number></property>
                <property name="toolTip"><string>Compute min/max from loaded well curves</string></property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="chkInvertCmap">
                <property name="text"><string>Invert Colormap</string></property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="chkLogScale">
                <property name="text"><string>Logarithmic Scale (e.g. Rt, K)</string></property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="chkShowColorbar">
                <property name="text"><string>Show Colorbar Legend</string></property>
                <property name="checked"><bool>true</bool></property>
               </widget>
              </item>

             </layout>
            </widget>
           </item>

           <item>
            <spacer>
             <property name="orientation"><enum>Qt::Vertical</enum></property>
             <property name="sizeType"><enum>QSizePolicy::Expanding</enum></property>
            </spacer>
           </item>

          </layout>
         </widget>

         <!-- ─── TAB 3: Camera / Lighting ───────────────── -->
         <widget class="QWidget" name="tabCamera">
          <attribute name="title"><string>Camera</string></attribute>
          <layout class="QVBoxLayout">
           <property name="spacing"><number>6</number></property>
           <property name="contentsMargins"><rect><x>4</x><y>6</y><width>4</width><height>4</height></rect></property>

           <!-- Camera Position -->
           <item>
            <widget class="QGroupBox" name="grpCameraPosition">
             <property name="title"><string>Camera Position</string></property>
             <layout class="QVBoxLayout">
              <property name="spacing"><number>6</number></property>
             <property name="contentsMargins"><rect><x>9</x><y>9</y><width>9</width><height>7</height></rect></property>
              <item>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel" name="lblAzimuth"><property name="text"><string>Azimuth:</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:58px;</string></property></widget></item>
                <item><widget class="QSlider" name="sliderAzimuth"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="minimum"><number>0</number></property><property name="maximum"><number>360</number></property><property name="value"><number>45</number></property><property name="toolTip"><string>Camera azimuth (0–360°)</string></property></widget></item>
                <item><widget class="QLabel" name="lblAzimuthVal"><property name="text"><string>45°</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:28px;</string></property></widget></item>
               </layout>
              </item>
              <item>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel" name="lblElevation"><property name="text"><string>Elevation:</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:58px;</string></property></widget></item>
                <item><widget class="QSlider" name="sliderElevation"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="minimum"><number>-90</number></property><property name="maximum"><number>90</number></property><property name="value"><number>30</number></property><property name="toolTip"><string>Camera elevation angle</string></property></widget></item>
                <item><widget class="QLabel" name="lblElevationVal"><property name="text"><string>30°</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:28px;</string></property></widget></item>
               </layout>
              </item>
              <item>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel" name="lblFOV"><property name="text"><string>Field of View:</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:58px;</string></property></widget></item>
                <item><widget class="QSlider" name="sliderFOV"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="minimum"><number>10</number></property><property name="maximum"><number>120</number></property><property name="value"><number>60</number></property><property name="toolTip"><string>Field of view (degrees)</string></property></widget></item>
                <item><widget class="QLabel" name="lblFOVVal"><property name="text"><string>60°</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:28px;</string></property></widget></item>
               </layout>
              </item>
              <item>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel" name="lblZoomLevel"><property name="text"><string>Zoom:</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:58px;</string></property></widget></item>
                <item><widget class="QSlider" name="sliderZoom"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="minimum"><number>10</number></property><property name="maximum"><number>500</number></property><property name="value"><number>100</number></property><property name="toolTip"><string>Zoom level (%)</string></property></widget></item>
                <item><widget class="QLabel" name="lblZoomVal"><property name="text"><string>100%</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:28px;</string></property></widget></item>
               </layout>
              </item>
             </layout>
            </widget>
           </item>

           <!-- Lighting -->
           <item>
            <widget class="QGroupBox" name="grpLighting">
             <property name="title"><string>Scene Lighting</string></property>
             <layout class="QVBoxLayout">
              <property name="spacing"><number>5</number></property>
             <property name="contentsMargins"><rect><x>9</x><y>9</y><width>9</width><height>7</height></rect></property>
              <item>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel" name="lblAmbient"><property name="text"><string>Ambient:</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:55px;</string></property></widget></item>
                <item><widget class="QSlider" name="sliderAmbient"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="minimum"><number>0</number></property><property name="maximum"><number>100</number></property><property name="value"><number>40</number></property></widget></item>
                <item><widget class="QLabel" name="lblAmbientVal"><property name="text"><string>40%</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:28px;</string></property></widget></item>
               </layout>
              </item>
              <item>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel" name="lblDiffuse"><property name="text"><string>Diffuse:</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:55px;</string></property></widget></item>
                <item><widget class="QSlider" name="sliderDiffuse"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="minimum"><number>0</number></property><property name="maximum"><number>100</number></property><property name="value"><number>70</number></property></widget></item>
                <item><widget class="QLabel" name="lblDiffuseVal"><property name="text"><string>70%</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:28px;</string></property></widget></item>
               </layout>
              </item>
              <item>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel" name="lblSpecular"><property name="text"><string>Specular:</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:55px;</string></property></widget></item>
                <item><widget class="QSlider" name="sliderSpecular"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="minimum"><number>0</number></property><property name="maximum"><number>100</number></property><property name="value"><number>25</number></property></widget></item>
                <item><widget class="QLabel" name="lblSpecularVal"><property name="text"><string>25%</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;min-width:28px;</string></property></widget></item>
               </layout>
              </item>
              <item>
               <widget class="QCheckBox" name="chkShadows">
                <property name="text"><string>Enable Soft Shadows</string></property>
                <property name="checked"><bool>false</bool></property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="chkSSAO">
                <property name="text"><string>Ambient Occlusion (SSAO)</string></property>
                <property name="checked"><bool>false</bool></property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>

           <item>
            <spacer>
             <property name="orientation"><enum>Qt::Vertical</enum></property>
             <property name="sizeType"><enum>QSizePolicy::Expanding</enum></property>
            </spacer>
           </item>

          </layout>
         </widget>

         <!-- ─── TAB 4: Well Info (Pick Panel) ──────────── -->
         <widget class="QWidget" name="tabWellInfo">
          <attribute name="title"><string>Well Info</string></attribute>
          <layout class="QVBoxLayout">
           <property name="spacing"><number>6</number></property>
           <property name="contentsMargins"><rect><x>4</x><y>6</y><width>4</width><height>4</height></rect></property>

           <item>
            <widget class="QLabel" name="lblPickInfoHeader">
             <property name="text"><string>  PICKED POINT INFO</string></property>
             <property name="sectionHeader" stdset="0"><bool>true</bool></property>
            </widget>
           </item>

           <!-- Picked Location -->
           <item>
            <widget class="QGroupBox" name="grpPickedLocation">
             <property name="title"><string>Location</string></property>
             <layout class="QFormLayout">
              <property name="horizontalSpacing"><number>8</number></property>
              <property name="verticalSpacing"><number>5</number></property>
             <property name="contentsMargins"><rect><x>9</x><y>9</y><width>9</width><height>7</height></rect></property>
              <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Well:</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property></widget></item>
              <item row="0" column="1"><widget class="QLabel" name="lblPickWell"><property name="text"><string>--</string></property><property name="styleSheet"><string>font-size:10px;color:#1B3A6B;font-weight:bold;</string></property></widget></item>
              <item row="1" column="0"><widget class="QLabel"><property name="text"><string>MD (m):</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property></widget></item>
              <item row="1" column="1"><widget class="QLabel" name="lblPickMD"><property name="text"><string>--</string></property><property name="styleSheet"><string>font-size:10px;font-weight:bold;</string></property></widget></item>
              <item row="2" column="0"><widget class="QLabel"><property name="text"><string>TVD (m):</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property></widget></item>
              <item row="2" column="1"><widget class="QLabel" name="lblPickTVD"><property name="text"><string>--</string></property><property name="styleSheet"><string>font-size:10px;font-weight:bold;</string></property></widget></item>
              <item row="3" column="0"><widget class="QLabel"><property name="text"><string>TVDSS (m):</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property></widget></item>
              <item row="3" column="1"><widget class="QLabel" name="lblPickTVDSS"><property name="text"><string>--</string></property><property name="styleSheet"><string>font-size:10px;font-weight:bold;</string></property></widget></item>
              <item row="4" column="0"><widget class="QLabel"><property name="text"><string>Formation:</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property></widget></item>
              <item row="4" column="1"><widget class="QLabel" name="lblPickFormation"><property name="text"><string>--</string></property><property name="styleSheet"><string>font-size:10px;font-weight:bold;color:#6B4EFF;</string></property></widget></item>
             </layout>
            </widget>
           </item>

           <!-- Picked Log Values -->
           <item>
            <widget class="QGroupBox" name="grpPickedLogValues">
             <property name="title"><string>Log Values at Point</string></property>
             <layout class="QFormLayout">
              <property name="horizontalSpacing"><number>8</number></property>
              <property name="verticalSpacing"><number>5</number></property>
             <property name="contentsMargins"><rect><x>9</x><y>9</y><width>9</width><height>7</height></rect></property>
              <item row="0" column="0"><widget class="QLabel"><property name="text"><string>GR:</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property></widget></item>
              <item row="0" column="1"><widget class="QLabel" name="lblPickGR"><property name="text"><string>--  API</string></property><property name="styleSheet"><string>font-size:10px;font-weight:bold;</string></property></widget></item>
              <item row="1" column="0"><widget class="QLabel"><property name="text"><string>RHOB:</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property></widget></item>
              <item row="1" column="1"><widget class="QLabel" name="lblPickRHOB"><property name="text"><string>--  g/cc</string></property><property name="styleSheet"><string>font-size:10px;font-weight:bold;</string></property></widget></item>
              <item row="2" column="0"><widget class="QLabel"><property name="text"><string>NPHI:</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property></widget></item>
              <item row="2" column="1"><widget class="QLabel" name="lblPickNPHI"><property name="text"><string>--  v/v</string></property><property name="styleSheet"><string>font-size:10px;font-weight:bold;</string></property></widget></item>
              <item row="3" column="0"><widget class="QLabel"><property name="text"><string>Vshale:</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property></widget></item>
              <item row="3" column="1"><widget class="QLabel" name="lblPickVsh"><property name="text"><string>--  v/v</string></property><property name="styleSheet"><string>font-size:10px;font-weight:bold;</string></property></widget></item>
              <item row="4" column="0"><widget class="QLabel"><property name="text"><string>PHIE:</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property></widget></item>
              <item row="4" column="1"><widget class="QLabel" name="lblPickPHIE"><property name="text"><string>--  v/v</string></property><property name="styleSheet"><string>font-size:10px;font-weight:bold;</string></property></widget></item>
              <item row="5" column="0"><widget class="QLabel"><property name="text"><string>Sw:</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property></widget></item>
              <item row="5" column="1"><widget class="QLabel" name="lblPickSw"><property name="text"><string>--  v/v</string></property><property name="styleSheet"><string>font-size:10px;font-weight:bold;</string></property></widget></item>
              <item row="6" column="0"><widget class="QLabel"><property name="text"><string>K (mD):</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property></widget></item>
              <item row="6" column="1"><widget class="QLabel" name="lblPickK"><property name="text"><string>--  mD</string></property><property name="styleSheet"><string>font-size:10px;font-weight:bold;</string></property></widget></item>
              <item row="7" column="0"><widget class="QLabel"><property name="text"><string>Net Pay:</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property></widget></item>
              <item row="7" column="1"><widget class="QLabel" name="lblPickNetPay"><property name="text"><string>--</string></property><property name="styleSheet"><string>font-size:10px;font-weight:bold;</string></property></widget></item>
             </layout>
            </widget>
           </item>

           <item>
            <spacer>
             <property name="orientation"><enum>Qt::Vertical</enum></property>
             <property name="sizeType"><enum>QSizePolicy::Expanding</enum></property>
            </spacer>
           </item>

          </layout>
         </widget>

        </widget>
       </item>

       <!-- Render / Update Button -->
       <item>
        <widget class="QPushButton" name="btnRenderUpdate">
         <property name="text"><string>▶  Render / Update 3D Scene</string></property>
         <property name="minimumHeight"><number>34</number></property>
         <property name="toolTip"><string>Apply all settings and re-render the 3D scene</string></property>
        </widget>
       </item>

      </layout>
     </widget>

    </widget>
   </item>

   <!-- ───────────── BOTTOM STATUS BAR ─────────────────── -->
   <item>
    <widget class="QFrame" name="statusBar">
     <property name="maximumHeight"><number>22</number></property>
     <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
     <layout class="QHBoxLayout" name="statusBarLayout">
      <property name="spacing"><number>18</number></property>
      <property name="contentsMargins"><rect><x>8</x><y>0</y><width>8</width><height>0</height></rect></property>
      <item>
