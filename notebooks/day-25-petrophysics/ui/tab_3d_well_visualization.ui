              <item row="3" column="0"><widget class="QLabel"><property name="text"><string>TVDSS (m):</string></property><property name="styleSheet"><string>font-size:10px;color:#4A5568;</string></property></widget></item>
              <item row="3" column="1"><widget class="QLabel" name="lblPickTVDSS"><property name="text"><string>--</string></property><property name="styleSheet"><string>font-size:10px;font-weight:bold;</string></property></widget></item>
