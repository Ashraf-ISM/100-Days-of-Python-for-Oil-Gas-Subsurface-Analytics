       <!-- Trajectories Group -->
       <item>
        <widget class="QGroupBox" name="grpTrajectories">
         <property name="title"><string>Trajectories</string></property>
         <layout class="QVBoxLayout">
          <property name="spacing"><number>4</number></property>
          <property name="contentsMargins"><rect><x>9</x><y>8</y><width>9</width><height>7</height></rect></property>
