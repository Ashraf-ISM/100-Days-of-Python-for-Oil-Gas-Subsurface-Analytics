<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Tab3DWellVisualization</class>
 <widget class="QWidget" name="Tab3DWellVisualization">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1440</width><height>820</height></rect>
  </property>
  <property name="windowTitle">
   <string>3D Well Visualization</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
/* ─── Root ─────────────────────────────────────────── */
QWidget#Tab3DWellVisualization {
  background-color: #F0F4F8;
  font-family: "Segoe UI", Arial, sans-serif;
}

/* ─── Toolbar ───────────────────────────────────────── */
QFrame#toolbarFrame {
  background-color: #1B3A6B;
  border-radius: 5px;
}
QPushButton[toolbtn="true"] {
  background-color: transparent;
  color: #C9DDF2;
  border: 1px solid transparent;
  border-radius: 4px;
  padding: 4px 9px;
  font-size: 11px;
  font-weight: 500;
}
QPushButton[toolbtn="true"]:hover {
  background-color: rgba(255,255,255,0.14);
  border-color: rgba(255,255,255,0.25);
  color: #FFFFFF;
}
QPushButton[toolbtn="true"]:checked {
  background-color: #2E7BB8;
  border-color: #4A9DD4;
  color: #FFFFFF;
}

/* ─── Side Panels ───────────────────────────────────── */
QFrame#leftPanel, QFrame#rightPanel {
  background-color: #FFFFFF;
  border: 1px solid #D4DCE8;
  border-radius: 6px;
}

/* ─── Section Headers ───────────────────────────────── */
QLabel[sectionHeader="true"] {
  background-color: #1B3A6B;
  color: #FFFFFF;
  font-weight: bold;
  font-size: 10px;
  letter-spacing: 1px;
  padding: 5px 10px;
  border-radius: 4px;
}

/* ─── GroupBox ──────────────────────────────────────── */
QGroupBox {
  font-weight: bold;
  font-size: 10px;
  color: #1B3A6B;
  border: 1px solid #D4DCE8;
  border-radius: 5px;
  margin-top: 10px;
  padding-top: 6px;
  background-color: #FAFBFD;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 5px;
  color: #1B3A6B;
}

/* ─── Viewport ──────────────────────────────────────── */
QFrame#viewportFrame {
  background-color: #07101E;
  border: 2px solid #1B3A6B;
  border-radius: 6px;
}
QOpenGLWidget#glWidget3D {
  background-color: #07101E;
}
QFrame#viewportInfoBar {
  background-color: rgba(11, 25, 50, 0.88);
  border-top: 1px solid #1B3A6B;
}

/* ─── Bottom Controls ───────────────────────────────── */
QFrame#bottomControlFrame {
  background-color: #FFFFFF;
  border: 1px solid #D4DCE8;
  border-radius: 5px;
}

/* ─── Sliders ───────────────────────────────────────── */
QSlider::groove:horizontal {
  height: 4px;
  background: #D4DCE8;
  border-radius: 2px;
}
QSlider::handle:horizontal {
  background: #1B6CA8;
  width: 14px;
  height: 14px;
  border-radius: 7px;
  margin: -5px 0;
}
QSlider::sub-page:horizontal {
  background: #1B6CA8;
  border-radius: 2px;
}

/* ─── ComboBox ──────────────────────────────────────── */
QComboBox {
  border: 1px solid #C8D3E0;
  border-radius: 4px;
  padding: 3px 8px;
  background: #FFFFFF;
  font-size: 10px;
  color: #2D3748;
  selection-background-color: #E3F0FB;
}
QComboBox:focus { border-color: #1B6CA8; }
QComboBox::drop-down {
  border: none;
  padding-right: 4px;
}

/* ─── CheckBox / RadioButton ────────────────────────── */
QCheckBox, QRadioButton {
  font-size: 10px;
  color: #2D3748;
  spacing: 6px;
}
QCheckBox::indicator {
  width: 13px; height: 13px;
  border: 1px solid #B0BEC5;
  border-radius: 3px;
  background: #FFFFFF;
}
QCheckBox::indicator:checked {
  background-color: #1B6CA8;
  border-color: #1B6CA8;
}
QRadioButton::indicator {
  width: 13px; height: 13px;
  border: 1px solid #B0BEC5;
  border-radius: 7px;
  background: #FFFFFF;
}
QRadioButton::indicator:checked {
  background-color: #1B6CA8;
  border-color: #1B6CA8;
}

/* ─── SpinBox ───────────────────────────────────────── */
QDoubleSpinBox, QSpinBox {
  border: 1px solid #C8D3E0;
  border-radius: 4px;
  padding: 3px 6px;
  font-size: 10px;
  background: #FFFFFF;
}
QDoubleSpinBox:focus, QSpinBox:focus { border-color: #1B6CA8; }

/* ─── ListWidget ────────────────────────────────────── */
QListWidget {
  border: 1px solid #D4DCE8;
  border-radius: 4px;
  background: #FAFBFC;
  font-size: 10px;
  outline: none;
}
QListWidget::item { padding: 4px 8px; }
QListWidget::item:selected {
  background-color: #E3F0FB;
  color: #1B3A6B;
}
QListWidget::item:hover { background-color: #F0F7FD; }

/* ─── Tab Widget ────────────────────────────────────── */
QTabWidget::pane {
  border: 1px solid #D4DCE8;
  border-top: none;
  border-radius: 0 0 5px 5px;
  background: #FAFBFD;
}
QTabBar::tab {
  background: #EDF1F7;
  color: #4A5568;
  border: 1px solid #D4DCE8;
  border-bottom: none;
  padding: 4px 10px;
  font-size: 10px;
  min-width: 48px;
}
QTabBar::tab:selected {
  background: #1B6CA8;
  color: #FFFFFF;
  border-color: #1B6CA8;
}
QTabBar::tab:hover:!selected { background: #D8E8F5; }

/* ─── Status Bar ────────────────────────────────────── */
QFrame#statusBar {
  background-color: #1B3A6B;
  border-radius: 4px;
}
QFrame#statusBar QLabel {
  color: #8BB8D8;
  font-size: 10px;
  padding: 2px 6px;
}

/* ─── Render Button ─────────────────────────────────── */
QPushButton#btnRenderUpdate {
  background-color: #1B6CA8;
  color: #FFFFFF;
  border: none;
  border-radius: 5px;
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 0.5px;
}
QPushButton#btnRenderUpdate:hover  { background-color: #1558A0; }
QPushButton#btnRenderUpdate:pressed{ background-color: #0E4080; }

/* ─── Utility Buttons ───────────────────────────────── */
QPushButton#btnSelectAllWells {
  background:#E3F0FB; color:#1B3A6B;
  border:1px solid #B8D4EE; border-radius:3px; font-size:10px;
}
QPushButton#btnClearWells {
  background:#FEE2E2; color:#C0392B;
  border:1px solid #FAA; border-radius:3px; font-size:10px;
}
QPushButton#btnAutoRange {
  background:#E3F0FB; color:#1B3A6B;
  border:1px solid #B8D4EE; border-radius:3px; font-size:10px;
}
QPushButton#btnAnimPlay  { background:#27AE60; color:#FFFFFF; border:none; border-radius:3px; font-size:10px; }
QPushButton#btnAnimStop  { background:#E74C3C; color:#FFFFFF; border:none; border-radius:3px; font-size:10px; }
   </string>
  </property>

  <!-- ═══════════════════════════════════════════════════════
       MAIN VERTICAL LAYOUT
       ═══════════════════════════════════════════════════════ -->
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing"><number>5</number></property>
   <property name="contentsMargins"><rect><x>8</x><y>6</y><width>8</width><height>6</height></rect></property>

   <!-- ───────────── TOP TOOLBAR ───────────────────────── -->
   <item>
    <widget class="QFrame" name="toolbarFrame">
     <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
