   <string notr="true">
/* ─── Root ─── */
QWidget#HomeDashboard {
    background-color: #eef1f6;
    font-family: "Segoe UI", "Inter", Arial, sans-serif;
}
/* ─── Scroll ─── */
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical {
    background: #dde3ed; width: 5px; border-radius: 2px; margin: 0;
}
QScrollBar::handle:vertical {
    background: #b0bac8; border-radius: 2px; min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
/* ─── Sidebar ─── */
QWidget#sidebarWidget {
    background: #ffffff;
    border-left: 1px solid #dde3ed;
}
/* ─── Table ─── */
QTableWidget {
    background: #ffffff;
    border: none;
    gridline-color: #eef1f6;
    color: #374151;
    font-size: 12px;
    selection-background-color: #eff6ff;
    selection-color: #1d4ed8;
    outline: none;
}
QTableWidget::item { padding: 9px 12px; border-bottom: 1px solid #f3f4f6; }
QTableWidget::item:hover { background: #f9fafb; }
QHeaderView::section {
    background: #f9fafb;
    color: #9ca3af;
    font-size: 10px; font-weight: 700;
    letter-spacing: 1.2px;
    padding: 9px 12px;
    border: none;
    border-bottom: 2px solid #e5e7eb;
}
   </string>
