  <property name="windowTitle">
   <string>3D Well Workspace</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QWidget#ThreeDWellPage {
    background: #F3F7FC;
}
QFrame#heroCard, QFrame#panelCard {
    background: #FFFFFF;
    border: 1px solid #D5E1EC;
    border-radius: 16px;
}
QFrame#heroBanner {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #153B63, stop:0.55 #245A8C, stop:1 #3E7DB1);
    border-radius: 18px;
}
QLabel#heroTitle {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: 800;
}
QLabel#heroSubtitle {
    color: rgba(255, 255, 255, 0.86);
    font-size: 12px;
}
QLabel#heroPill {
    background: rgba(255, 255, 255, 0.14);
    color: #EAF4FF;
    border: 1px solid rgba(255, 255, 255, 0.20);
    border-radius: 11px;
    padding: 7px 12px;
    font-size: 11px;
    font-weight: 700;
}
QLabel#sectionTitle {
    color: #274B72;
    font-size: 14px;
    font-weight: 800;
}
QLabel#sectionSubtle {
    color: #667C94;
    font-size: 11px;
}
QLabel#metricLabel {
    color: #6A8098;
    font-size: 11px;
    font-weight: 600;
}
QLabel#metricValue {
    color: #173B61;
    font-size: 20px;
    font-weight: 800;
}
QLabel#statusValue {
    color: #0E7A63;
    font-size: 11px;
    font-weight: 700;
}
QPushButton#btnPrimary {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3B78B8, stop:1 #245A8C);
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    padding: 10px 14px;
    font-size: 11px;
    font-weight: 700;
    min-height: 22px;
}
QPushButton#btnPrimary:hover {
    background: #2E6EA8;
}
QPushButton#btnSecondary {
    background: #F6FAFE;
    color: #274B72;
    border: 1px solid #C9D8E7;
    border-radius: 12px;
    padding: 9px 12px;
    font-size: 11px;
    font-weight: 700;
    min-height: 22px;
}
QPushButton#btnSecondary:hover {
    background: #E8F1F9;
}
QFrame#plotViewport {
    background: #F8FBFE;
    border: 1px dashed #C8D8E8;
    border-radius: 14px;
}
QFrame#metricTile {
    background: #F8FBFE;
    border: 1px solid #D9E5F1;
    border-radius: 12px;
}
QTableWidget, QListWidget {
    background: #F9FBFD;
    border: 1px solid #D5E1EC;
    border-radius: 12px;
    alternate-background-color: #F2F7FB;
}
QHeaderView::section {
    background: #EAF1F8;
    color: #274B72;
    border: none;
    border-right: 1px solid #D5E1EC;
    border-bottom: 1px solid #D5E1EC;
    padding: 6px 8px;
    font-size: 11px;
    font-weight: 700;
}
QComboBox, QLineEdit {
    background: #FFFFFF;
    border: 1px solid #C8D7E6;
    border-radius: 10px;
    padding: 7px 10px;
    min-height: 20px;
}
QCheckBox {
    color: #355575;
    font-size: 11px;
    font-weight: 600;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
}
QCheckBox::indicator:unchecked {
    border: 1px solid #AFC4D9;
    border-radius: 4px;
    background: #FFFFFF;
}
QCheckBox::indicator:checked {
    border: 1px solid #2C6AA6;
    border-radius: 4px;
    background: #2C6AA6;
}
</string>
