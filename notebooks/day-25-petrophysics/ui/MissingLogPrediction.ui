/* ====================== GLOBAL ====================== */
QWidget { font-family: 'Segoe UI', Arial, sans-serif; font-size: 12px; }
QWidget#MissingLogPrediction { background-color: #EEF2F7; }

/* ====================== FRAMES ====================== */
QFrame#headerFrame {
    background-color: #FFFFFF;
    border-bottom: 2px solid #E2E8F0;
    min-height: 60px; max-height: 60px;
}
QFrame#stepsFrame {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    min-height: 68px; max-height: 68px;
}
QFrame#bottomBar {
    background-color: #FFFFFF;
    border-top: 2px solid #E2E8F0;
    min-height: 60px; max-height: 60px;
}
QFrame#contentArea { background-color: transparent; }
QFrame#stepDivider {
    background-color: #CBD5E1;
    min-height: 2px; max-height: 2px;
    min-width: 40px;
}

/* ====================== GROUPBOX ====================== */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #DDE3EE;
    border-radius: 10px;
    margin-top: 18px;
    padding: 10px 8px 8px 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px;
    background-color: #FFFFFF;
    color: #1E293B;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2px;
}

/* ====================== LABELS ====================== */
QLabel { color: #374151; background: transparent; }
QLabel#lblPageTitle {
    font-size: 20px; font-weight: 700; color: #1E293B;
}
QLabel#lblPageSub { font-size: 11px; color: #64748B; }
QLabel#lblHelpBtn {
    color: #2563EB; font-size: 11px; font-weight: 600;
    padding: 4px 10px;
    border: 1px solid #BFDBFE;
    border-radius: 5px;
    background-color: #EFF6FF;
}

/* Step circle - active */
QLabel#stepCircleActive {
    background-color: #2563EB; color: #FFFFFF;
    border-radius: 14px; font-size: 12px; font-weight: 700;
    min-width: 28px; max-width: 28px;
    min-height: 28px; max-height: 28px;
    qproperty-alignment: AlignCenter;
}
/* Step circle - inactive */
QLabel#stepCircleInactive {
    background-color: #CBD5E1; color: #FFFFFF;
    border-radius: 14px; font-size: 12px; font-weight: 700;
    min-width: 28px; max-width: 28px;
    min-height: 28px; max-height: 28px;
    qproperty-alignment: AlignCenter;
}
QLabel#stepTitleActive { font-size: 11px; font-weight: 700; color: #1E293B; }
QLabel#stepTitleInactive { font-size: 11px; font-weight: 600; color: #94A3B8; }
QLabel#stepSubActive { font-size: 10px; color: #2563EB; font-weight: 600; }
QLabel#stepSubInactive { font-size: 10px; color: #CBD5E1; }

/* Section number bubble */
QLabel#secNum {
    background-color: #2563EB; color: white;
    border-radius: 10px; font-size: 10px; font-weight: 700;
    min-width: 20px; max-width: 20px;
    min-height: 20px; max-height: 20px;
    qproperty-alignment: AlignCenter;
}
QLabel#secTitle { font-size: 11px; font-weight: 700; color: #1E293B; }
QLabel#secSub { font-size: 10px; color: #64748B; }

/* Metric labels */
QLabel#metricValGreen { font-size: 26px; font-weight: 700; color: #10B981; }
QLabel#metricValBlue  { font-size: 26px; font-weight: 700; color: #2563EB; }
QLabel#metricValOrange{ font-size: 24px; font-weight: 700; color: #F59E0B; }
QLabel#metricValSm    { font-size: 18px; font-weight: 700; color: #2563EB; }
QLabel#metricValSmGreen{ font-size: 18px; font-weight: 700; color: #10B981; }
QLabel#metricUnit     { font-size: 10px; color: #94A3B8; }
QLabel#metricKey      { font-size: 11px; color: #64748B; font-weight: 600; }
QLabel#metricVal      { font-size: 11px; color: #1E293B; font-weight: 700; }

/* Status / Badge labels */
QLabel#statusCompleted {
    color: #10B981; font-size: 11px; font-weight: 700;
}
QLabel#badgeRed {
    background-color: #FEF2F2; color: #DC2626;
    border: 1px solid #FECACA; border-radius: 4px;
    font-size: 10px; font-weight: 700; padding: 1px 6px;
}
QLabel#badgeGreen {
    background-color: #F0FDF4; color: #059669;
    border: 1px solid #BBF7D0; border-radius: 4px;
    font-size: 10px; font-weight: 700; padding: 1px 6px;
}
QLabel#badgeBlue {
    background-color: #EFF6FF; color: #1D4ED8;
    border: 1px solid #BFDBFE; border-radius: 4px;
    font-size: 10px; font-weight: 600; padding: 1px 6px;
}
QLabel#badgeOrange {
    background-color: #FFFBEB; color: #D97706;
    border: 1px solid #FDE68A; border-radius: 4px;
    font-size: 10px; font-weight: 600; padding: 1px 6px;
}
QLabel#lblMissingCount {
    color: #DC2626; font-size: 11px; font-weight: 600;
}
QLabel#lblDataPoints { font-size: 11px; color: #374151; }
QLabel#lblDepthRange { font-size: 11px; color: #374151; }

/* Pipeline steps */
QLabel#pipelineStepNormal {
    background-color: #F1F5F9; color: #475569;
    border: 1px solid #CBD5E1; border-radius: 5px;
    font-size: 10px; font-weight: 600; padding: 5px 8px;
    qproperty-alignment: AlignCenter;
}
QLabel#pipelineStepActive {
    background-color: #2563EB; color: #FFFFFF;
    border-radius: 5px;
    font-size: 10px; font-weight: 700; padding: 5px 8px;
    qproperty-alignment: AlignCenter;
}
QLabel#pipelineArrow { color: #94A3B8; font-size: 14px; font-weight: 700; }

/* SHAP bars */
QLabel#shapBarBg {
    background-color: #E2E8F0; border-radius: 3px;
    min-height: 10px; max-height: 10px;
}
QLabel#shapBarFill {
    background-color: #2563EB; border-radius: 3px;
    min-height: 10px; max-height: 10px;
}
QLabel#shapBarNeg {
    background-color: #F87171; border-radius: 3px;
    min-height: 10px; max-height: 10px;
}
QLabel#shapLbl { font-size: 10px; color: #374151; }
QLabel#shapVal { font-size: 10px; color: #64748B; font-weight: 600; }

/* Well log track placeholder */
QLabel#wellLogTrack {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 4px;
    color: #94A3B8;
    font-size: 10px;
    qproperty-alignment: AlignCenter;
}
QLabel#wellLogHeader {
    background-color: #1E293B; color: #FFFFFF;
    font-size: 9px; font-weight: 700;
    qproperty-alignment: AlignCenter;
    padding: 3px;
    border-radius: 3px;
}
QLabel#wellLogHeaderGR  { background-color: #374151; }
QLabel#wellLogHeaderRHOB{ background-color: #1D4ED8; }

/* Plot placeholder frames */
QFrame#plotFrame {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    min-height: 140px;
}
QFrame#residualPlotFrame {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
}
QFrame#histFrame {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
}

/* Leaderboard */
QFrame#lbRow1 { background-color: #FFFBEB; border-radius: 5px; padding: 2px; }
QFrame#lbRowNormal { background-color: #FAFAFA; border-radius: 4px; }
QLabel#lbRank1  { color: #F59E0B; font-weight: 800; font-size: 12px; }
QLabel#lbRankN  { color: #94A3B8; font-weight: 600; font-size: 11px; }
QLabel#lbModel  { color: #1E293B; font-size: 11px; font-weight: 600; }
QLabel#lbScore  { color: #10B981; font-size: 11px; font-weight: 700; }
QLabel#lbScoreN { color: #374151; font-size: 11px; }

/* ====================== BUTTONS ====================== */
QPushButton { border-radius: 6px; padding: 6px 14px; font-size: 11px; font-weight: 600; border: none; cursor: pointer; }
QPushButton#btnPrimary   { background-color: #2563EB; color: #FFFFFF; }
QPushButton#btnPrimary:hover { background-color: #1D4ED8; }
QPushButton#btnSuccess   { background-color: #10B981; color: #FFFFFF; }
QPushButton#btnSuccess:hover { background-color: #059669; }
QPushButton#btnOutline   { background-color: transparent; color: #2563EB; border: 1px solid #2563EB; }
QPushButton#btnOutline:hover { background-color: #EFF6FF; }
QPushButton#btnSecondary { background-color: #F8FAFC; color: #374151; border: 1px solid #CBD5E1; }
QPushButton#btnSecondary:hover { background-color: #F1F5F9; }
QPushButton#btnPreview   { background-color: #2563EB; color: #FFFFFF; font-size: 12px; padding: 10px 22px; border-radius: 8px; }
QPushButton#btnApply     { background-color: #1E3A8A; color: #FFFFFF; font-size: 12px; padding: 10px 22px; border-radius: 8px; }
QPushButton#btnApply:hover { background-color: #1E40AF; }
QPushButton#btnBack      { background-color: #F1F5F9; color: #374151; border: 1px solid #CBD5E1; font-size: 12px; padding: 10px 20px; border-radius: 8px; }
QPushButton#btnReset     { background-color: #FEF2F2; color: #DC2626; border: 1px solid #FECACA; font-size: 12px; padding: 10px 18px; border-radius: 8px; }
QPushButton#btnExport    { background-color: #F8FAFC; color: #374151; border: 1px solid #CBD5E1; font-size: 12px; padding: 10px 18px; border-radius: 8px; }
QPushButton#btnAutoSel   { background-color: #EFF6FF; color: #1D4ED8; border: 1px solid #BFDBFE; }
QPushButton#btnFeatEng   { background-color: #F0FDF4; color: #059669; border: 1px solid #BBF7D0; }
QPushButton#btnViewLog   { background-color: #F8FAFC; color: #374151; border: 1px solid #CBD5E1; font-size: 11px; padding: 4px 10px; }
QPushButton#btnSaveModel { background-color: #2563EB; color: #FFFFFF; padding: 7px 12px; font-size: 11px; }
QPushButton#btnLoadModel { background-color: #F8FAFC; color: #374151; border: 1px solid #CBD5E1; padding: 7px 12px; font-size: 11px; }
QPushButton#btnBatch     { background-color: #F8FAFC; color: #374151; border: 1px solid #CBD5E1; padding: 7px 12px; font-size: 11px; }
QPushButton#btnDeploy    { background-color: #10B981; color: #FFFFFF; padding: 7px 12px; font-size: 11px; }
QPushButton#btnOptimize  { background-color: #7C3AED; color: #FFFFFF; padding: 5px 12px; font-size: 11px; }
QPushButton#btnViewResults{ background-color: #F0FDF4; color: #059669; border: 1px solid #BBF7D0; padding: 5px 12px; font-size: 11px; }
QPushButton#btnViewDrift { background-color: #F8FAFC; color: #374151; border: 1px solid #CBD5E1; padding: 5px 12px; font-size: 11px; }
QPushButton#btnCompare   { background-color: #EFF6FF; color: #1D4ED8; border: 1px solid #BFDBFE; padding: 5px 12px; font-size: 11px; }
QPushButton#btnExplainAI { background-color: #F5F3FF; color: #7C3AED; border: 1px solid #DDD6FE; padding: 5px 12px; font-size: 11px; }
QPushButton#btnViewIntervals { color: #2563EB; font-size: 11px; background: transparent; padding: 3px 6px; }
QPushButton#btnDetailedMetrics{ background-color: #EFF6FF; color: #1D4ED8; border: 1px solid #BFDBFE; padding: 4px 10px; font-size: 10px; }
QPushButton#btnEditPipeline { background-color: #F8FAFC; color: #374151; border: 1px solid #CBD5E1; padding: 5px 12px; font-size: 11px; }
QPushButton#btnExportPkg { background-color: #F8FAFC; color: #374151; border: 1px solid #CBD5E1; padding: 5px 10px; font-size: 11px; }

/* ====================== INPUTS ====================== */
QComboBox {
    border: 1px solid #CBD5E1; border-radius: 6px;
    padding: 5px 10px; background-color: #FFFFFF;
    color: #374151; font-size: 12px; min-height: 30px;
}
QComboBox:focus { border-color: #2563EB; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow { image: none; }

QCheckBox { spacing: 8px; color: #374151; font-size: 11px; }
QCheckBox::indicator { width: 15px; height: 15px; border-radius: 3px; border: 2px solid #CBD5E1; background: #FFFFFF; }
QCheckBox::indicator:checked { background-color: #2563EB; border-color: #2563EB; }

QSlider::groove:horizontal { height: 5px; background: #E2E8F0; border-radius: 3px; }
QSlider::handle:horizontal { width: 16px; height: 16px; background: #2563EB; border-radius: 8px; margin: -6px 0; }
QSlider::sub-page:horizontal { background: #2563EB; border-radius: 3px; }

QSpinBox, QDoubleSpinBox {
    border: 1px solid #CBD5E1; border-radius: 6px;
    padding: 4px 8px; background-color: #FFFFFF;
    color: #374151; font-size: 12px;
}

QLineEdit {
    border: 1px solid #CBD5E1; border-radius: 6px;
    padding: 5px 8px; background-color: #FFFFFF;
    color: #374151; font-size: 12px;
}

/* ====================== TABLE ====================== */
QTableWidget {
    border: 1px solid #E2E8F0; border-radius: 6px;
    background-color: #FFFFFF; gridline-color: #F1F5F9;
    selection-background-color: #EFF6FF; font-size: 11px;
}
QTableWidget::item { padding: 4px 8px; color: #374151; border-bottom: 1px solid #F1F5F9; }
QTableWidget::item:selected { background-color: #EFF6FF; color: #1D4ED8; }
QHeaderView::section {
    background-color: #F8FAFC; border: none;
    border-bottom: 2px solid #E2E8F0;
    padding: 5px 8px; font-size: 11px; font-weight: 700; color: #64748B;
}

/* ====================== SCROLLAREA ====================== */
QScrollArea { border: none; background-color: transparent; }
QScrollBar:vertical { background: #F1F5F9; width: 8px; border-radius: 4px; }
QScrollBar::handle:vertical { background: #CBD5E1; border-radius: 4px; min-height: 20px; }
QScrollBar::handle:vertical:hover { background: #94A3B8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }

/* ====================== PROGRESS ====================== */
QProgressBar { border: 1px solid #E2E8F0; border-radius: 4px; background-color: #F1F5F9; max-height: 8px; text-align: center; font-size: 0px; }
QProgressBar::chunk { background-color: #10B981; border-radius: 4px; }
