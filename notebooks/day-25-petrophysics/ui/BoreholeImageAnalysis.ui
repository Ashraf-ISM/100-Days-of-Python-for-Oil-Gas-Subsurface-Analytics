  <!-- ═══════════════════════════════
       MAIN TOOLBAR
       ═══════════════════════════════ -->
  <widget class="QToolBar" name="mainToolBar">
   <property name="windowTitle"><string>Main Toolbar</string></property>
   <property name="movable"><bool>false</bool></property>
   <property name="floatable"><bool>false</bool></property>
   <property name="iconSize">
    <size><width>18</width><height>18</height></size>
   </property>
   <attribute name="toolBarArea"><enum>TopToolBarArea</enum></attribute>

   <!-- File Operations -->
   <widget class="QToolButton" name="btnNewProject">
    <property name="text"><string>⊕ New</string></property>
    <property name="toolTip"><string>New Project (Ctrl+N)</string></property>
    <property name="shortcut"><string>Ctrl+N</string></property>
   </widget>
   <widget class="QToolButton" name="btnOpenProject">
    <property name="text"><string>📂 Open</string></property>
    <property name="toolTip"><string>Open Project (Ctrl+O)</string></property>
   </widget>
   <widget class="QToolButton" name="btnSaveProject">
    <property name="text"><string>💾 Save</string></property>
    <property name="toolTip"><string>Save Project (Ctrl+S)</string></property>
   </widget>
   <addaction name="separator"/>

   <!-- Import -->
   <widget class="QToolButton" name="btnImportLAS">
