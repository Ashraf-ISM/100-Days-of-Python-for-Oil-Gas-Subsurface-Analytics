  <!-- ═══════════════════════════════
       STATUS BAR
       ═══════════════════════════════ -->
  <widget class="QStatusBar" name="statusBar">
   <widget class="QLabel" name="lblStatusMsg">
    <property name="text"><string>Ready</string></property>
    <property name="styleSheet"><string>color:#8FA8C0;</string></property>
   </widget>
   <widget class="QLabel" name="lblStatusDepth">
