<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>BoreholeImageAnalysis</class>
 <widget class="QMainWindow" name="BoreholeImageAnalysis">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1680</width>
    <height>980</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>PetroSight Pro — Borehole Image Analysis  |  v3.1.0</string>
