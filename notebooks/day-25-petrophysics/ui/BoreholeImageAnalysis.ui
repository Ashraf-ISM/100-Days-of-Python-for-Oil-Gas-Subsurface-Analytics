           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnExportExcel">
            <property name="text"><string>⬆ Excel</string></property>
            <property name="toolTip"><string>Export picks to Excel workbook</string></property>
            <property name="objectName"><string>accentBtn</string></property>
            <property name="maximumHeight"><number>22</number></property>
           </widget>
          </item>

         </layout>
        </widget>
       </item>

       <!-- Picks Table -->
       <item>
        <widget class="QTableWidget" name="picksTable">
         <property name="alternatingRowColors"><bool>true</bool></property>
         <property name="selectionMode"><enum>QAbstractItemView::ExtendedSelection</enum></property>
         <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
         <property name="sortingEnabled"><bool>true</bool></property>
         <property name="showGrid"><bool>true</bool></property>
         <property name="cornerButtonEnabled"><bool>false</bool></property>
         <property name="editTriggers"><set>QAbstractItemView::DoubleClicked|QAbstractItemView::SelectedClicked</set></property>
         <column>
          <property name="text"><string>#</string></property>
          <property name="toolTip"><string>Pick Index</string></property>
         </column>
         <column>
          <property name="text"><string>Depth MD (m)</string></property>
          <property name="toolTip"><string>Measured Depth in meters</string></property>
         </column>
         <column>
          <property name="text"><string>TVD (m)</string></property>
          <property name="toolTip"><string>True Vertical Depth</string></property>
         </column>
         <column>
          <property name="text"><string>Type</string></property>
          <property name="toolTip"><string>Feature Type</string></property>
         </column>
         <column>
          <property name="text"><string>Sub-Type</string></property>
          <property name="toolTip"><string>Feature Sub-Classification</string></property>
         </column>
         <column>
          <property name="text"><string>Dip (°)</string></property>
          <property name="toolTip"><string>Dip Angle in degrees</string></property>
         </column>
         <column>
          <property name="text"><string>Azimuth (°)</string></property>
          <property name="toolTip"><string>Dip Azimuth in degrees (0–360)</string></property>
         </column>
         <column>
          <property name="text"><string>Aperture (mm)</string></property>
          <property name="toolTip"><string>Fracture aperture (mm)</string></property>
         </column>
         <column>
          <property name="text"><string>Confidence</string></property>
          <property name="toolTip"><string>Interpretation Confidence Level</string></property>
         </column>
         <column>
          <property name="text"><string>Interpreter</string></property>
          <property name="toolTip"><string>Geologist / Interpreter ID</string></property>
         </column>
         <column>
          <property name="text"><string>Timestamp</string></property>
          <property name="toolTip"><string>Pick creation date/time</string></property>
         </column>
         <column>
          <property name="text"><string>Notes</string></property>
          <property name="toolTip"><string>Free-text observations</string></property>
         </column>
        </widget>
       </item>

      </layout>
     </widget>
    </item>
    <!-- END BOTTOM PANEL -->

   </layout>
