   </widget>
   <widget class="QLabel" name="lblStatusAzimuth">
    <property name="text"><string>Az: —°</string></property>
   </widget>
   <widget class="QLabel" name="lblStatusDip">
    <property name="text"><string>Dip: —°</string></property>
   </widget>
   <widget class="QLabel" name="lblStatusPixel">
    <property name="text"><string>Value: —</string></property>
   </widget>
   <widget class="QLabel" name="lblStatusPicks">
    <property name="text"><string>Picks: 0</string></property>
   </widget>
   <widget class="QLabel" name="lblStatusZoom">
