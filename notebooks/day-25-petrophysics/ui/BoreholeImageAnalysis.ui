           <property name="spacing"><number>0</number></property>
           <property name="contentsMargins">
            <rect><x>0</x><y>0</y><width>0</width><height>0</height></rect>
           </property>

           <!-- Depth Track -->
           <item>
            <widget class="QGraphicsView" name="depthTrackView">
             <property name="objectName"><string>depthTrackView</string></property>
             <property name="toolTip"><string>Depth Track — shows MD, TVD, and deviation</string></property>
             <property name="verticalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
             <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
             <property name="renderHints">
              <set>QPainter::Antialiasing|QPainter::TextAntialiasing|QPainter::SmoothPixmapTransform</set>
             </property>
            </widget>
           </item>

           <!-- Main Image Log Canvas -->
           <item>
            <widget class="QGraphicsView" name="imageLogCanvas">
             <property name="toolTip"><string>Borehole Image Canvas — scroll to navigate depth, drag to pan</string></property>
             <property name="sizePolicy">
              <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
               <horstretch>1</horstretch><verstretch>1</verstretch>
              </sizepolicy>
