    <!-- ─────────────────────────────
         BOTTOM PICKS TABLE PANEL
         ───────────────────────────── -->
    <item>
     <widget class="QFrame" name="bottomPanel">
      <layout class="QVBoxLayout" name="bottomVLayout">
       <property name="spacing"><number>0</number></property>
       <property name="contentsMargins">
        <rect><x>0</x><y>0</y><width>0</width><height>0</height></rect>
       </property>

       <!-- Picks Table Header -->
       <item>
        <widget class="QFrame" name="sectionHeaderPicks">
         <property name="objectName"><string>sectionHeader</string></property>
         <layout class="QHBoxLayout" name="hdrPicksLayout">
          <property name="contentsMargins">
           <rect><x>8</x><y>0</y><width>8</width><height>0</height></rect>
          </property>
          <property name="spacing"><number>4</number></property>
          <item>
           <widget class="QLabel" name="lblSecPicks">
            <property name="objectName"><string>sectionLabel</string></property>
            <property name="text"><string>PICKS TABLE</string></property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="lblPickCountBadge">
            <property name="text"><string>0 picks</string></property>
            <property name="styleSheet"><string>
             background-color:#1A73E8;color:#FFFFFF;
             font-size:9px;font-weight:700;
             border-radius:8px;padding:1px 7px;
            </string></property>
           </widget>
          </item>
          <item>
           <spacer>
            <property name="orientation"><enum>Qt::Horizontal</enum></property>
            <property name="sizeHint" stdset="0"><size><width>20</width><height>0</height></size></property>
           </spacer>
          </item>

          <!-- Table Action Buttons -->
          <item>
           <widget class="QPushButton" name="btnAddPick">
            <property name="text"><string>⊕ Add Pick</string></property>
            <property name="toolTip"><string>Add new manual pick at current depth</string></property>
            <property name="objectName"><string>primaryBtn</string></property>
            <property name="maximumHeight"><number>22</number></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnDeletePick">
            <property name="text"><string>⊖ Delete</string></property>
            <property name="toolTip"><string>Delete selected picks (Del)</string></property>
            <property name="objectName"><string>dangerBtn</string></property>
            <property name="maximumHeight"><number>22</number></property>
            <property name="shortcut"><string>Del</string></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnClearAll">
            <property name="text"><string>✕ Clear All</string></property>
            <property name="toolTip"><string>Clear all picks in current interval</string></property>
            <property name="objectName"><string>dangerBtn</string></property>
            <property name="maximumHeight"><number>22</number></property>
           </widget>
          </item>

          <item>
           <widget class="QFrame" name="btnSep1">
            <property name="frameShape"><enum>QFrame::VLine</enum></property>
            <property name="frameShadow"><enum>QFrame::Sunken</enum></property>
            <property name="styleSheet"><string>color:#C0CCD8;</string></property>
            <property name="maximumWidth"><number>2</number></property>
           </widget>
          </item>

          <!-- Filter -->
          <item>
           <widget class="QLabel" name="lblFilterType">
            <property name="text"><string>Filter:</string></property>
            <property name="styleSheet"><string>color:#546E7A;font-size:11px;</string></property>
           </widget>
          </item>
          <item>
           <widget class="QComboBox" name="cbTableFilter">
            <property name="maximumHeight"><number>22</number></property>
            <property name="minimumWidth"><number>130</number></property>
            <item><property name="text"><string>All Types</string></property></item>
            <item><property name="text"><string>Fractures Only</string></property></item>
            <item><property name="text"><string>Bedding Only</string></property></item>
            <item><property name="text"><string>Faults Only</string></property></item>
            <item><property name="text"><string>High Confidence</string></property></item>
            <item><property name="text"><string>Current View</string></property></item>
           </widget>
          </item>

          <item>
           <widget class="QFrame" name="btnSep2">
            <property name="frameShape"><enum>QFrame::VLine</enum></property>
            <property name="frameShadow"><enum>QFrame::Sunken</enum></property>
            <property name="styleSheet"><string>color:#C0CCD8;</string></property>
            <property name="maximumWidth"><number>2</number></property>
           </widget>
          </item>

          <!-- Export -->
          <item>
           <widget class="QPushButton" name="btnExportCSV">
            <property name="text"><string>⬆ CSV</string></property>
            <property name="toolTip"><string>Export picks to CSV</string></property>
            <property name="objectName"><string>accentBtn</string></property>
            <property name="maximumHeight"><number>22</number></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnExportLAS">
            <property name="text"><string>⬆ LAS</string></property>
            <property name="toolTip"><string>Export picks to LAS format</string></property>
            <property name="objectName"><string>accentBtn</string></property>
