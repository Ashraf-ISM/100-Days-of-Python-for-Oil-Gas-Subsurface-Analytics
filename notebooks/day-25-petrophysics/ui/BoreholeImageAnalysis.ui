   </widget>
   <widget class="QLabel" name="lblStatusWell">
    <property name="text"><string>No well loaded</string></property>
   </widget>
  </widget>

  <!-- ═══════════════════════════════
       CENTRAL WIDGET + MAIN SPLITTER
       ═══════════════════════════════ -->
  <widget class="QWidget" name="centralWidget">
   <layout class="QVBoxLayout" name="mainVLayout">
    <property name="spacing"><number>0</number></property>
    <property name="contentsMargins">
     <rect><x>0</x><y>0</y><width>0</width><height>0</height></rect>
    </property>
    <item>
     <widget class="QSplitter" name="mainSplitter">
      <property name="orientation"><enum>Qt::Horizontal</enum></property>
      <property name="childrenCollapsible"><bool>false</bool></property>

      <!-- ─────────────────────────────
           LEFT PANEL
           ───────────────────────────── -->
      <widget class="QFrame" name="leftPanel">
       <layout class="QVBoxLayout" name="leftVLayout">
        <property name="spacing"><number>0</number></property>
        <property name="contentsMargins">
         <rect><x>0</x><y>0</y><width>0</width><height>0</height></rect>
        </property>

        <!-- Well Information -->
        <item>
         <widget class="QFrame" name="sectionHeaderWell">
          <property name="objectName"><string>sectionHeader</string></property>
          <layout class="QHBoxLayout" name="hdrWellLayout">
           <property name="contentsMargins">
            <rect><x>8</x><y>0</y><width>8</width><height>0</height></rect>
           </property>
           <item>
            <widget class="QLabel" name="lblSecWell">
             <property name="objectName"><string>sectionLabel</string></property>
             <property name="text"><string>WELL INFORMATION</string></property>
            </widget>
           </item>
           <item>
            <spacer>
             <property name="orientation"><enum>Qt::Horizontal</enum></property>
             <property name="sizeHint" stdset="0"><size><width>40</width><height>0</height></size></property>
            </spacer>
           </item>
          </layout>
         </widget>
        </item>

        <item>
         <widget class="QScrollArea" name="leftScrollArea">
          <property name="widgetResizable"><bool>true</bool></property>
          <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
          <widget class="QWidget" name="leftScrollContents">
           <layout class="QVBoxLayout" name="leftContentLayout">
            <property name="spacing"><number>6</number></property>
            <property name="contentsMargins">
             <rect><x>8</x><y>8</y><width>8</width><height>8</height></rect>
            </property>

            <!-- Well Info Group -->
            <item>
             <widget class="QGroupBox" name="gbWellInfo">
              <property name="title"><string>Well Metadata</string></property>
              <layout class="QFormLayout" name="frmWellInfo">
               <property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property>
               <property name="fieldGrowthPolicy"><enum>QFormLayout::AllNonFixedFieldsGrow</enum></property>
               <property name="horizontalSpacing"><number>8</number></property>
               <property name="verticalSpacing"><number>5</number></property>
               <item row="0" column="0">
                <widget class="QLabel" name="lblWellName">
                 <property name="text"><string>Well Name:</string></property>
                 <property name="objectName"><string>fieldLabel</string></property>
                </widget>
               </item>
               <item row="0" column="1">
                <widget class="QLineEdit" name="leWellName">
                 <property name="placeholderText"><string>e.g. WELL-A-01</string></property>
                </widget>
               </item>
               <item row="1" column="0">
                <widget class="QLabel" name="lblField">
                 <property name="text"><string>Field:</string></property>
                 <property name="objectName"><string>fieldLabel</string></property>
                </widget>
               </item>
               <item row="1" column="1">
                <widget class="QLineEdit" name="leField">
                 <property name="placeholderText"><string>Field / Block</string></property>
                </widget>
               </item>
               <item row="2" column="0">
                <widget class="QLabel" name="lblCountry">
                 <property name="text"><string>Country:</string></property>
                 <property name="objectName"><string>fieldLabel</string></property>
                </widget>
               </item>
               <item row="2" column="1">
                <widget class="QLineEdit" name="leCountry">
                 <property name="placeholderText"><string>Country / Basin</string></property>
                </widget>
               </item>
               <item row="3" column="0">
                <widget class="QLabel" name="lblOperator">
                 <property name="text"><string>Operator:</string></property>
                 <property name="objectName"><string>fieldLabel</string></property>
                </widget>
               </item>
               <item row="3" column="1">
                <widget class="QLineEdit" name="leOperator">
                 <property name="placeholderText"><string>Operating Company</string></property>
                </widget>
               </item>
               <item row="4" column="0">
                <widget class="QLabel" name="lblToolType">
                 <property name="text"><string>Tool Type:</string></property>
                 <property name="objectName"><string>fieldLabel</string></property>
                </widget>
               </item>
               <item row="4" column="1">
                <widget class="QComboBox" name="cbToolType">
                 <item><property name="text"><string>FMI (Schlumberger)</string></property></item>
                 <item><property name="text"><string>FMS (Schlumberger)</string></property></item>
                 <item><property name="text"><string>OBMI (Schlumberger)</string></property></item>
                 <item><property name="text"><string>STAR (Halliburton)</string></property></item>
                 <item><property name="text"><string>XRMI (Halliburton)</string></property></item>
                 <item><property name="text"><string>RAB / GVR</string></property></item>
                 <item><property name="text"><string>ARI (Schlumberger)</string></property></item>
                 <item><property name="text"><string>UBI (Schlumberger)</string></property></item>
                 <item><property name="text"><string>Custom</string></property></item>
                </widget>
               </item>
               <item row="5" column="0">
                <widget class="QLabel" name="lblRunDate">
                 <property name="text"><string>Run Date:</string></property>
                 <property name="objectName"><string>fieldLabel</string></property>
                </widget>
               </item>
               <item row="5" column="1">
                <widget class="QLineEdit" name="leRunDate">
                 <property name="placeholderText"><string>YYYY-MM-DD</string></property>
                </widget>
               </item>
               <item row="6" column="0">
                <widget class="QLabel" name="lblBitSize">
                 <property name="text"><string>Bit Size:</string></property>
                 <property name="objectName"><string>fieldLabel</string></property>
                </widget>
               </item>
               <item row="6" column="1">
                <widget class="QDoubleSpinBox" name="sbBitSize">
                 <property name="suffix"><string>" (in)</string></property>
                 <property name="minimum"><double>3.0</double></property>
                 <property name="maximum"><double>36.0</double></property>
                 <property name="value"><double>8.5</double></property>
                 <property name="singleStep"><double>0.5</double></property>
                 <property name="decimals"><number>3</number></property>
                </widget>
               </item>
              </layout>
             </widget>
            </item>

            <!-- Depth Range Group -->
            <item>
             <widget class="QGroupBox" name="gbDepthRange">
              <property name="title"><string>Depth Navigation</string></property>
              <layout class="QFormLayout" name="frmDepth">
               <property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property>
               <property name="horizontalSpacing"><number>8</number></property>
               <property name="verticalSpacing"><number>5</number></property>
               <item row="0" column="0">
                <widget class="QLabel" name="lblTopDepth">
                 <property name="text"><string>Top Depth:</string></property>
                 <property name="objectName"><string>fieldLabel</string></property>
                </widget>
               </item>
               <item row="0" column="1">
                <widget class="QDoubleSpinBox" name="sbTopDepth">
                 <property name="suffix"><string> m</string></property>
                 <property name="minimum"><double>0.0</double></property>
                 <property name="maximum"><double>20000.0</double></property>
                 <property name="value"><double>1000.0</double></property>
                 <property name="decimals"><number>2</number></property>
                 <property name="singleStep"><double>1.0</double></property>
                </widget>
               </item>
               <item row="1" column="0">
                <widget class="QLabel" name="lblBottomDepth">
                 <property name="text"><string>Base Depth:</string></property>
                 <property name="objectName"><string>fieldLabel</string></property>
                </widget>
               </item>
               <item row="1" column="1">
                <widget class="QDoubleSpinBox" name="sbBottomDepth">
                 <property name="suffix"><string> m</string></property>
                 <property name="minimum"><double>0.0</double></property>
                 <property name="maximum"><double>20000.0</double></property>
                 <property name="value"><double>1100.0</double></property>
                 <property name="decimals"><number>2</number></property>
                 <property name="singleStep"><double>1.0</double></property>
                </widget>
               </item>
               <item row="2" column="0">
                <widget class="QLabel" name="lblGotoDepth">
                 <property name="text"><string>Go To:</string></property>
                 <property name="objectName"><string>fieldLabel</string></property>
                </widget>
               </item>
               <item row="2" column="1">
                <layout class="QHBoxLayout" name="hGotoLayout">
                 <item>
                  <widget class="QDoubleSpinBox" name="sbGotoDepth">
                   <property name="suffix"><string> m</string></property>
                   <property name="minimum"><double>0.0</double></property>
                   <property name="maximum"><double>20000.0</double></property>
                   <property name="value"><double>1050.0</double></property>
                   <property name="decimals"><number>2</number></property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QPushButton" name="btnGotoDepth">
                   <property name="text"><string>Go</string></property>
                   <property name="objectName"><string>primaryBtn</string></property>
                   <property name="maximumWidth"><number>38</number></property>
                  </widget>
                 </item>
                </layout>
               </item>
               <item row="3" column="0">
