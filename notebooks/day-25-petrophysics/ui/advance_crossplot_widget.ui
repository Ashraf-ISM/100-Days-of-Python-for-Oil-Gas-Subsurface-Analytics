<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>CrossplotWidget</class>
 <widget class="QWidget" name="CrossplotWidget">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1400</width>
    <height>780</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>PetroARX — Crossplot Analysis</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
/* ── Global ── */
QWidget {
    background-color: #F4F6FA;
    color: #1A2340;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 12px;
}

/* ── Side panels ── */
#leftPanel, #rightPanel {
    background-color: #FFFFFF;
    border: 1px solid #D8DEE9;
    border-radius: 6px;
}

/* ── Section labels ── */
#lblCrossplotSetup, #lblTemplates, #lblPlotStatistics, #lblExportPlot {
    color: #1A56DB;
    font-size: 13px;
    font-weight: bold;
    padding: 4px 0px 2px 0px;
    border-bottom: 2px solid #1A56DB;
}

#lblAxisOptions, #lblDisplayOptions {
    color: #1A2340;
    font-size: 12px;
    font-weight: bold;
    padding: 4px 0px 2px 0px;
}

/* ── Field labels ── */
QLabel {
    color: #374151;
    font-size: 11px;
}

/* ── ComboBoxes ── */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 4px 8px;
    color: #1A2340;
    selection-background-color: #1A56DB;
    min-height: 26px;
}
QComboBox:hover  { border-color: #1A56DB; }
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #6B7280;
    width: 0; height: 0;
    margin-right: 5px;
}

/* ── CheckBoxes ── */
QCheckBox {
    spacing: 6px;
    color: #374151;
    font-size: 11px;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #9CA3AF;
    border-radius: 3px;
    background: #FFFFFF;
}
QCheckBox::indicator:checked {
    background-color: #1A56DB;
    border-color: #1A56DB;
}

/* ── Plot style toggle buttons ── */
#btnScatter, #btnHexbin {
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 5px 0px;
    font-size: 11px;
    font-weight: 500;
    min-height: 28px;
}
#btnScatter {
    background-color: #1A56DB;
    color: #FFFFFF;
    border-color: #1A56DB;
}
#btnHexbin {
    background-color: #FFFFFF;
    color: #374151;
}
#btnScatter:hover { background-color: #1648C0; }
#btnHexbin:hover  { background-color: #F1F5F9; }

/* ── Plot Crossplot button ── */
#btnPlotCrossplot {
    background-color: #1A56DB;
    color: #FFFFFF;
    border: none;
    border-radius: 5px;
    font-size: 13px;
    font-weight: bold;
    padding: 8px 0px;
    min-height: 38px;
}
#btnPlotCrossplot:hover  { background-color: #1648C0; }
#btnPlotCrossplot:pressed { background-color: #133AAA; }

/* ── Toolbar ── */
#plotToolbar {
    background-color: #F8FAFC;
    border-bottom: 1px solid #E2E8F0;
    padding: 2px 4px;
}
#plotToolbar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 6px;
    color: #374151;
    font-size: 14px;
}
#plotToolbar QToolButton:hover  { background: #E8EFF9; border-color: #B0C4DE; }
#plotToolbar QToolButton:pressed { background: #D0DCF5; }

/* ── Plot title bar ── */
#lblPlotTitle {
    color: #1A2340;
    font-size: 13px;
    font-weight: bold;
    padding: 6px 0px;
    qproperty-alignment: AlignCenter;
}

/* ── Plot canvas frame ── */
#plotFrame {
    background-color: #FFFFFF;
    border: 1px solid #D8DEE9;
    border-radius: 6px;
}

/* ── Template list ── */
QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #D8DEE9;
    border-radius: 4px;
    outline: none;
}
QListWidget::item {
    padding: 8px 10px;
    border-bottom: 1px solid #F1F5F9;
    color: #374151;
    font-size: 11px;
}
QListWidget::item:selected {
    background-color: #1A56DB;
    color: #FFFFFF;
    border-radius: 3px;
}
QListWidget::item:hover:!selected { background-color: #EBF2FF; }

/* ── Statistics table ── */
#statsTable {
    background-color: #FFFFFF;
    border: 1px solid #D8DEE9;
    border-radius: 4px;
    gridline-color: #F1F5F9;
}
#statsTable QHeaderView::section {
    background-color: #F4F6FA;
    border: none;
    border-bottom: 1px solid #D8DEE9;
    font-weight: bold;
    font-size: 10px;
    padding: 4px;
    color: #6B7280;
}
#statsTable::item { padding: 4px 8px; font-size: 11px; }
#statsTable::item:alternate { background-color: #F8FAFC; }

/* ── Quick info box ── */
#quickInfoFrame {
    background-color: #EFF6FF;
    border: 1px solid #BFDBFE;
    border-radius: 5px;
    padding: 6px;
}
#lblQuickInfoTitle {
    color: #1A56DB;
    font-size: 11px;
    font-weight: bold;
}
#lblQuickInfoBody {
    color: #1E3A6E;
    font-size: 10px;
    qproperty-wordWrap: true;
}

/* ── Export buttons ── */
#btnExportPNG, #btnExportPDF, #btnExportSVG, #btnExportCSV {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 5px;
    color: #374151;
    font-size: 10px;
    font-weight: 500;
    padding: 6px 2px;
    min-height: 46px;
}
#btnExportPNG:hover, #btnExportPDF:hover,
#btnExportSVG:hover, #btnExportCSV:hover {
    background-color: #EBF2FF;
    border-color: #1A56DB;
    color: #1A56DB;
}

/* ── Separators ── */
QFrame[frameShape="4"],   /* HLine */
QFrame[frameShape="5"] {  /* VLine */
    color: #E2E8F0;
}

/* ── Scrollbars ── */
QScrollBar:vertical {
    width: 8px;
    background: #F4F6FA;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
   </string>
  </property>

  <!-- ═══════════════════════════════════════════════════════════
       ROOT HORIZONTAL LAYOUT  [Left | Center | Right]
       ═══════════════════════════════════════════════════════════ -->
  <layout class="QHBoxLayout" name="rootLayout">
   <property name="spacing"><number>8</number></property>
   <property name="leftMargin"><number>8</number></property>
   <property name="topMargin"><number>8</number></property>
   <property name="rightMargin"><number>8</number></property>
