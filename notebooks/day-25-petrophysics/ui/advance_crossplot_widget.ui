        <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
        <property name="selectionMode"><enum>QAbstractItemView::NoSelection</enum></property>
        <attribute name="horizontalHeaderVisible"><bool>false</bool></attribute>
        <attribute name="verticalHeaderVisible"><bool>false</bool></attribute>
        <!-- Row 0 -->
        <item row="0" column="0"><property name="text"><string>Points Plotted</string></property></item>
        <item row="0" column="1"><property name="text"><string>4,821</string></property></item>
        <!-- Row 1 -->
        <item row="1" column="0"><property name="text"><string>X Range (v/v)</string></property></item>
        <item row="1" column="1"><property name="text"><string>-0.15 – 0.60</string></property></item>
        <!-- Row 2 -->
        <item row="2" column="0"><property name="text"><string>Y Range (g/cc)</string></property></item>
        <item row="2" column="1"><property name="text"><string>1.60 – 3.20</string></property></item>
        <!-- Row 3 -->
        <item row="3" column="0"><property name="text"><string>Mean NPHI (v/v)</string></property></item>
        <item row="3" column="1"><property name="text"><string>0.18</string></property></item>
        <!-- Row 4 -->
        <item row="4" column="0"><property name="text"><string>Mean RHOB (g/cc)</string></property></item>
        <item row="4" column="1"><property name="text"><string>2.35</string></property></item>
        <!-- Row 5 -->
        <item row="5" column="0"><property name="text"><string>Std Dev RHOB</string></property></item>
        <item row="5" column="1"><property name="text"><string>0.22</string></property></item>
       </widget>
