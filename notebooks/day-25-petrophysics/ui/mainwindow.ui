         <property name="styleSheet">
          <string>QFrame#frameWCSidebar{background:#FFFFFF;border:1px solid #D7E2EE;border-radius:12px;}
QGroupBox{font-weight:700;color:#2A4E77;border:1px solid #E3EAF3;border-radius:10px;margin-top:14px;background:#FAFCFF;font-size:11px;}
QGroupBox::title{subcontrol-origin:margin;left:12px;padding:0 6px;color:#2A4E77;}
QLabel{color:#3B5068;border:none;}
QCheckBox{color:#3F5164;spacing:7px;}
QCheckBox::indicator{width:15px;height:15px;border-radius:4px;border:1.5px solid #B8C9DA;}
QCheckBox::indicator:checked{background:#2F6FB3;border-color:#2F6FB3;}
QComboBox{background:#F7FAFD;border:1px solid #C6D6E8;border-radius:6px;padding:4px 8px;color:#2A3F55;min-height:24px;}
QComboBox::drop-down{border:none;width:20px;}
QComboBox::down-arrow{border-left:4px solid transparent;border-right:4px solid transparent;border-top:5px solid #5C7A96;margin-right:6px;}
QComboBox QAbstractItemView{background:#FFFFFF;border:1px solid #2F6FB3;selection-background-color:#2F6FB3;selection-color:#FFFFFF;color:#2A3F55;}
QDoubleSpinBox{background:#F7FAFD;border:1px solid #C6D6E8;border-radius:6px;padding:4px 8px;color:#2A3F55;min-height:24px;}
QLineEdit{background:#F7FAFD;border:1px solid #C6D6E8;border-radius:6px;padding:4px 10px;color:#2A3F55;}
QLineEdit:focus{border-color:#2F6FB3;}</string>
         </property>
