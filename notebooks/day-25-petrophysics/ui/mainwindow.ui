   <widget class="QWidget" name="tabDataInfoStats">
    <attribute name="title">
     <string>Data Info &amp; Stats</string>
    </attribute>
    <layout class="QVBoxLayout" name="layoutDIS">
     <property name="spacing">
      <number>5</number>
     </property>
     <item>
