                 <property name="checked"><bool>true</bool></property>
                </widget>
               </item>
               <item>
                <widget class="QCheckBox" name="chkShowPickValues">
                 <property name="text"><string>Show pick depth values</string></property>
                 <property name="checked"><bool>true</bool></property>
                </widget>
               </item>
               <item>
                <layout class="QFormLayout" name="labelSizeLayout">
                 <property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property>
                 <property name="horizontalSpacing"><number>8</number></property>
                 <property name="verticalSpacing"><number>4</number></property>
                 <item row="0" column="0">
                  <widget class="QLabel">
                   <property name="text"><string>Font size:</string></property>
