      <!-- ════════════════════════════════════════════════════════
           RIGHT PANEL
           ════════════════════════════════════════════════════════ -->
      <widget class="QFrame" name="frameRight">
       <layout class="QVBoxLayout" name="rightLayout">
        <property name="spacing"><number>0</number></property>
        <property name="leftMargin"><number>0</number></property>
        <property name="topMargin"><number>0</number></property>
        <property name="rightMargin"><number>0</number></property>
        <property name="bottomMargin"><number>0</number></property>

        <!-- Panel header -->
        <item>
         <widget class="QLabel" name="lblRightHeader">
          <property name="text"><string>  DISPLAY SETTINGS</string></property>
          <property name="styleSheet">
           <string>background:#1E2D45; color:#E2E8F0; font-weight:700;
                   font-size:10px; letter-spacing:0.6px; padding:6px 8px;
                   border-bottom:2px solid #2563EB;</string>
          </property>
         </widget>
        </item>

        <!-- Right tab widget -->
        <item>
         <widget class="QTabWidget" name="tabRight">
          <property name="tabPosition"><enum>QTabWidget::North</enum></property>
          <property name="currentIndex"><number>0</number></property>
          <property name="documentMode"><bool>true</bool></property>

          <!-- ─── TAB 0: DISPLAY ────────────────────────────────── -->
          <widget class="QWidget" name="tabDisplay">
           <attribute name="title"><string>Display</string></attribute>
           <layout class="QVBoxLayout" name="displayTabLayout">
            <property name="spacing"><number>6</number></property>
            <property name="leftMargin"><number>6</number></property>
            <property name="topMargin"><number>8</number></property>
            <property name="rightMargin"><number>6</number></property>
            <property name="bottomMargin"><number>6</number></property>

            <!-- Grid / scale group -->
            <item>
             <widget class="QGroupBox" name="grpGridOptions">
              <property name="title"><string>Grid &amp; Scale</string></property>
              <layout class="QVBoxLayout" name="gridOptionsLayout">
               <property name="spacing"><number>5</number></property>
               <item>
                <widget class="QCheckBox" name="chkShowDepthGrid">
                 <property name="text"><string>Show depth grid lines</string></property>
                 <property name="checked"><bool>true</bool></property>
                </widget>
               </item>
               <item>
                <widget class="QCheckBox" name="chkShowMajorGrid">
                 <property name="text"><string>Major depth ticks</string></property>
                 <property name="checked"><bool>true</bool></property>
                </widget>
               </item>
               <item>
                <widget class="QCheckBox" name="chkShowMinorGrid">
                 <property name="text"><string>Minor depth ticks</string></property>
                 <property name="checked"><bool>true</bool></property>
                </widget>
               </item>
               <item>
                <layout class="QFormLayout" name="gridSpacingLayout">
                 <property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property>
                 <property name="horizontalSpacing"><number>8</number></property>
                 <property name="verticalSpacing"><number>4</number></property>
                 <item row="0" column="0">
                  <widget class="QLabel">
                   <property name="text"><string>Major (m):</string></property>
                   <property name="styleSheet"><string>color:#64748B;</string></property>
                  </widget>
                 </item>
                 <item row="0" column="1">
                  <widget class="QDoubleSpinBox" name="dspinMajorGrid">
                   <property name="minimum"><double>1.0</double></property>
                   <property name="maximum"><double>1000.0</double></property>
                   <property name="value"><double>100.0</double></property>
                   <property name="singleStep"><double>50.0</double></property>
                  </widget>
                 </item>
                 <item row="1" column="0">
                  <widget class="QLabel">
                   <property name="text"><string>Minor (m):</string></property>
                   <property name="styleSheet"><string>color:#64748B;</string></property>
                  </widget>
                 </item>
                 <item row="1" column="1">
                  <widget class="QDoubleSpinBox" name="dspinMinorGrid">
                   <property name="minimum"><double>0.5</double></property>
                   <property name="maximum"><double>500.0</double></property>
                   <property name="value"><double>25.0</double></property>
                   <property name="singleStep"><double>5.0</double></property>
                  </widget>
                 </item>
                </layout>
               </item>
              </layout>
             </widget>
            </item>

            <!-- Labels group -->
            <item>
             <widget class="QGroupBox" name="grpLabels">
              <property name="title"><string>Labels &amp; Annotations</string></property>
              <layout class="QVBoxLayout" name="labelsLayout">
               <property name="spacing"><number>5</number></property>
