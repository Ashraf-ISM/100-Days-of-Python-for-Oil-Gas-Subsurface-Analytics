           </layout>
          </widget>

          <!-- ─── TAB 1: CORRELATION ───────────────────────────── -->
          <widget class="QWidget" name="tabCorrelation">
           <attribute name="title"><string>Correlation</string></attribute>
           <layout class="QVBoxLayout" name="correlTabLayout">
            <property name="spacing"><number>6</number></property>
            <property name="leftMargin"><number>6</number></property>
            <property name="topMargin"><number>8</number></property>
            <property name="rightMargin"><number>6</number></property>
            <property name="bottomMargin"><number>6</number></property>

            <!-- Current pick info -->
            <item>
             <widget class="QGroupBox" name="grpCurrentPick">
              <property name="title"><string>Active Pick</string></property>
              <layout class="QFormLayout" name="activePickLayout">
               <property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property>
               <property name="horizontalSpacing"><number>8</number></property>
               <property name="verticalSpacing"><number>5</number></property>
               <item row="0" column="0">
                <widget class="QLabel">
                 <property name="text"><string>Well:</string></property>
                 <property name="styleSheet"><string>color:#64748B;</string></property>
                </widget>
               </item>
               <item row="0" column="1">
                <widget class="QLabel" name="lblPickedWell">
                 <property name="text"><string>—</string></property>
                 <property name="styleSheet"><string>font-weight:600; color:#1E293B;</string></property>
                </widget>
               </item>
               <item row="1" column="0">
                <widget class="QLabel">
                 <property name="text"><string>Depth (MD):</string></property>
                 <property name="styleSheet"><string>color:#64748B;</string></property>
                </widget>
               </item>
               <item row="1" column="1">
                <widget class="QLabel" name="lblPickedMD">
                 <property name="text"><string>—</string></property>
                 <property name="styleSheet"><string>font-weight:600; color:#2563EB;</string></property>
                </widget>
               </item>
               <item row="2" column="0">
                <widget class="QLabel">
                 <property name="text"><string>TVD:</string></property>
                 <property name="styleSheet"><string>color:#64748B;</string></property>
                </widget>
               </item>
               <item row="2" column="1">
                <widget class="QLabel" name="lblPickedTVD">
                 <property name="text"><string>—</string></property>
                 <property name="styleSheet"><string>color:#374151;</string></property>
                </widget>
               </item>
               <item row="3" column="0">
                <widget class="QLabel">
                 <property name="text"><string>Formation:</string></property>
                 <property name="styleSheet"><string>color:#64748B;</string></property>
                </widget>
               </item>
               <item row="3" column="1">
                <widget class="QComboBox" name="cmbPickFormation">
                 <property name="toolTip"><string>Assign this pick to a formation zone</string></property>
                </widget>
               </item>
               <item row="4" column="0">
                <widget class="QLabel">
                 <property name="text"><string>GR:</string></property>
                 <property name="styleSheet"><string>color:#64748B;</string></property>
                </widget>
               </item>
               <item row="4" column="1">
                <widget class="QLabel" name="lblPickedGR">
                 <property name="text"><string>—  API</string></property>
                 <property name="styleSheet"><string>color:#374151;</string></property>
                </widget>
               </item>
               <item row="5" column="0">
                <widget class="QLabel">
                 <property name="text"><string>RHOB:</string></property>
                 <property name="styleSheet"><string>color:#64748B;</string></property>
                </widget>
               </item>
               <item row="5" column="1">
                <widget class="QLabel" name="lblPickedRHOB">
                 <property name="text"><string>—  g/cc</string></property>
                 <property name="styleSheet"><string>color:#374151;</string></property>
                </widget>
               </item>
               <item row="6" column="0">
                <widget class="QLabel">
                 <property name="text"><string>RT:</string></property>
                 <property name="styleSheet"><string>color:#64748B;</string></property>
                </widget>
               </item>
               <item row="6" column="1">
                <widget class="QLabel" name="lblPickedRT">
                 <property name="text"><string>—  ohm.m</string></property>
                 <property name="styleSheet"><string>color:#374151;</string></property>
                </widget>
               </item>
              </layout>
             </widget>
            </item>

            <!-- Pick actions -->
            <item>
             <layout class="QHBoxLayout" name="pickActionsLayout">
              <property name="spacing"><number>4</number></property>
              <item>
               <widget class="QPushButton" name="btnConfirmPick">
                <property name="text"><string>✔ Confirm Pick</string></property>
                <property name="toolTip"><string>Accept and save the current pick</string></property>
               </widget>
              </item>
              <item>
               <widget class="QPushButton" name="btnDeletePick">
                <property name="text"><string>✕ Delete</string></property>
                <property name="toolTip"><string>Delete the nearest pick</string></property>
               </widget>
              </item>
             </layout>
            </item>

            <!-- Correlation propagation group -->
            <item>
             <widget class="QGroupBox" name="grpPropagate">
              <property name="title"><string>Propagation</string></property>
              <layout class="QVBoxLayout" name="propagateLayout">
               <property name="spacing"><number>5</number></property>
               <item>
                <widget class="QCheckBox" name="chkAutoPropagate">
                 <property name="text"><string>Auto-propagate pick to all wells</string></property>
                 <property name="checked"><bool>false</bool></property>
                </widget>
               </item>
               <item>
                <widget class="QCheckBox" name="chkSnapToLog">
                 <property name="text"><string>Snap pick to nearest GR peak</string></property>
                 <property name="checked"><bool>false</bool></property>
                </widget>
               </item>
               <item>
                <widget class="QCheckBox" name="chkInterpolateUncertain">
                 <property name="text"><string>Flag uncertain correlations</string></property>
                 <property name="checked"><bool>true</bool></property>
                </widget>
               </item>
               <item>
                <layout class="QFormLayout" name="snapWindowLayout">
                 <property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property>
                 <property name="horizontalSpacing"><number>8</number></property>
                 <property name="verticalSpacing"><number>4</number></property>
                 <item row="0" column="0">
                  <widget class="QLabel">
                   <property name="text"><string>Snap window:</string></property>
                   <property name="styleSheet"><string>color:#64748B;</string></property>
                  </widget>
                 </item>
                 <item row="0" column="1">
                  <widget class="QDoubleSpinBox" name="dspinSnapWindow">
                   <property name="minimum"><double>0.5</double></property>
                   <property name="maximum"><double>50.0</double></property>
                   <property name="value"><double>5.0</double></property>
                   <property name="suffix"><string>  m</string></property>
                  </widget>
                 </item>
                </layout>
               </item>
              </layout>
             </widget>
            </item>

            <!-- Statistics group -->
            <item>
             <widget class="QGroupBox" name="grpCorrStats">
              <property name="title"><string>Zone Statistics</string></property>
              <layout class="QFormLayout" name="corrStatsLayout">
               <property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property>
               <property name="horizontalSpacing"><number>8</number></property>
               <property name="verticalSpacing"><number>4</number></property>
               <item row="0" column="0">
                <widget class="QLabel">
                 <property name="text"><string>Avg thickness:</string></property>
                 <property name="styleSheet"><string>color:#64748B;</string></property>
                </widget>
               </item>
               <item row="0" column="1">
                <widget class="QLabel" name="lblStatAvgThick">
                 <property name="text"><string>—  m</string></property>
                 <property name="styleSheet"><string>font-weight:600; color:#059669;</string></property>
                </widget>
               </item>
               <item row="1" column="0">
                <widget class="QLabel">
                 <property name="text"><string>Max thickness:</string></property>
                 <property name="styleSheet"><string>color:#64748B;</string></property>
                </widget>
               </item>
               <item row="1" column="1">
                <widget class="QLabel" name="lblStatMaxThick">
                 <property name="text"><string>—  m</string></property>
                 <property name="styleSheet"><string>color:#374151;</string></property>
                </widget>
               </item>
               <item row="2" column="0">
                <widget class="QLabel">
                 <property name="text"><string>Wells picked:</string></property>
                 <property name="styleSheet"><string>color:#64748B;</string></property>
                </widget>
               </item>
               <item row="2" column="1">
                <widget class="QLabel" name="lblStatWellsPicked">
                 <property name="text"><string>0 / 0</string></property>
                 <property name="styleSheet"><string>color:#374151;</string></property>
                </widget>
               </item>
               <item row="3" column="0">
                <widget class="QLabel">
                 <property name="text"><string>Dip (avg):</string></property>
                 <property name="styleSheet"><string>color:#64748B;</string></property>
                </widget>
               </item>
               <item row="3" column="1">
                <widget class="QLabel" name="lblStatDip">
                 <property name="text"><string>—  °</string></property>
                 <property name="styleSheet"><string>color:#374151;</string></property>
                </widget>
               </item>
              </layout>
             </widget>
            </item>

            <!-- Stretch -->
            <item>
             <spacer>
              <property name="orientation"><enum>Qt::Vertical</enum></property>
              <property name="sizeHint"><size><width>1</width><height>8</height></size></property>
             </spacer>
            </item>

           </layout>
          </widget>

          <!-- ─── TAB 2: EXPORT ────────────────────────────────── -->
          <widget class="QWidget" name="tabExport">
           <attribute name="title"><string>Export</string></attribute>
           <layout class="QVBoxLayout" name="exportTabLayout">
            <property name="spacing"><number>6</number></property>
            <property name="leftMargin"><number>6</number></property>
            <property name="topMargin"><number>8</number></property>
            <property name="rightMargin"><number>6</number></property>
            <property name="bottomMargin"><number>6</number></property>

            <!-- Export format group -->
            <item>
             <widget class="QGroupBox" name="grpExportFormat">
              <property name="title"><string>Output Format</string></property>
              <layout class="QVBoxLayout" name="exportFormatLayout">
               <property name="spacing"><number>5</number></property>
               <item>
                <widget class="QRadioButton" name="rdoExportPDF">
                 <property name="text"><string>PDF (vector, multi-page)</string></property>
                 <property name="checked"><bool>true</bool></property>
                </widget>
               </item>
               <item>
                <widget class="QRadioButton" name="rdoExportSVG">
                 <property name="text"><string>SVG (vector, single page)</string></property>
                </widget>
               </item>
               <item>
                <widget class="QRadioButton" name="rdoExportPNG">
                 <property name="text"><string>PNG (raster image)</string></property>
                </widget>
               </item>
               <item>
                <widget class="QRadioButton" name="rdoExportTIFF">
                 <property name="text"><string>TIFF (high-res raster)</string></property>
                </widget>
               </item>
               <item>
                <widget class="QRadioButton" name="rdoExportCSV">
                 <property name="text"><string>CSV (picks / tops table)</string></property>
                </widget>
               </item>
              </layout>
             </widget>
            </item>

            <!-- Page setup group -->
            <item>
             <widget class="QGroupBox" name="grpPageSetup">
              <property name="title"><string>Page / Resolution</string></property>
              <layout class="QFormLayout" name="pageSetupLayout">
               <property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property>
               <property name="horizontalSpacing"><number>8</number></property>
               <property name="verticalSpacing"><number>5</number></property>
               <item row="0" column="0">
                <widget class="QLabel">
                 <property name="text"><string>Paper:</string></property>
                 <property name="styleSheet"><string>color:#64748B;</string></property>
                </widget>
               </item>
               <item row="0" column="1">
                <widget class="QComboBox" name="cmbPaperSize">
                 <item><property name="text"><string>A4 Landscape</string></property></item>
                 <item><property name="text"><string>A4 Portrait</string></property></item>
                 <item><property name="text"><string>A3 Landscape</string></property></item>
                 <item><property name="text"><string>A1 Poster</string></property></item>
                 <item><property name="text"><string>Custom…</string></property></item>
                </widget>
               </item>
               <item row="1" column="0">
                <widget class="QLabel">
                 <property name="text"><string>DPI:</string></property>
                 <property name="styleSheet"><string>color:#64748B;</string></property>
                </widget>
               </item>
               <item row="1" column="1">
                <widget class="QComboBox" name="cmbExportDPI">
                 <item><property name="text"><string>150 dpi (screen)</string></property></item>
                 <item><property name="text"><string>300 dpi (print)</string></property></item>
                 <item><property name="text"><string>600 dpi (high-res)</string></property></item>
                </widget>
               </item>
               <item row="2" column="0">
                <widget class="QLabel">
                 <property name="text"><string>Margins:</string></property>
                 <property name="styleSheet"><string>color:#64748B;</string></property>
                </widget>
               </item>
               <item row="2" column="1">
                <widget class="QDoubleSpinBox" name="dspinMargin">
                 <property name="minimum"><double>0.0</double></property>
                 <property name="maximum"><double>50.0</double></property>
                 <property name="value"><double>10.0</double></property>
                 <property name="suffix"><string>  mm</string></property>
                </widget>
               </item>
              </layout>
             </widget>
            </item>

            <!-- Export content options -->
            <item>
             <widget class="QGroupBox" name="grpExportContent">
              <property name="title"><string>Include in Export</string></property>
              <layout class="QVBoxLayout" name="exportContentLayout">
               <property name="spacing"><number>4</number></property>
               <item>
                <widget class="QCheckBox" name="chkExportTitle">
                 <property name="text"><string>Title block / report header</string></property>
                 <property name="checked"><bool>true</bool></property>
                </widget>
               </item>
               <item>
                <widget class="QCheckBox" name="chkExportLegend">
                 <property name="text"><string>Formation legend</string></property>
                 <property name="checked"><bool>true</bool></property>
                </widget>
               </item>
               <item>
                <widget class="QCheckBox" name="chkExportPicksTable">
                 <property name="text"><string>Picks / tops table</string></property>
                 <property name="checked"><bool>true</bool></property>
                </widget>
               </item>
               <item>
                <widget class="QCheckBox" name="chkExportStats">
                 <property name="text"><string>Zone statistics summary</string></property>
                 <property name="checked"><bool>false</bool></property>
                </widget>
               </item>
               <item>
                <widget class="QCheckBox" name="chkExportPageNumbers">
                 <property name="text"><string>Page numbers</string></property>
                 <property name="checked"><bool>true</bool></property>
                </widget>
               </item>
              </layout>
             </widget>
            </item>

            <!-- Stretch -->
            <item>
             <spacer>
              <property name="orientation"><enum>Qt::Vertical</enum></property>
              <property name="sizeHint"><size><width>1</width><height>8</height></size></property>
             </spacer>
            </item>

            <!-- Export buttons -->
            <item>
             <widget class="QPushButton" name="btnExportPreview">
              <property name="text"><string>Preview Export</string></property>
              <property name="toolTip"><string>Preview before saving</string></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btnExport">
              <property name="text"><string>⇓  Export…</string></property>
              <property name="toolTip"><string>Save the correlation to file</string></property>
             </widget>
            </item>

           </layout>
          </widget>

         </widget>
        </item>
       </layout>
      </widget>

     </widget>
    </item>
   </layout>
  </widget>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  DOCK WIDGET — CORRELATION PICKS TABLE (bottom)             -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <widget class="QDockWidget" name="dockPicksTable">
   <attribute name="dockWidgetArea"><number>8</number></attribute>
   <property name="windowTitle"><string>Correlation Picks &amp; Formation Tops</string></property>
   <property name="minimumHeight"><number>140</number></property>
   <widget class="QWidget" name="dockPicksContents">
    <layout class="QVBoxLayout" name="dockPicksLayout">
     <property name="spacing"><number>0</number></property>
     <property name="leftMargin"><number>0</number></property>
     <property name="topMargin"><number>0</number></property>
     <property name="rightMargin"><number>0</number></property>
     <property name="bottomMargin"><number>0</number></property>

     <!-- Toolbar row for the table -->
     <item>
      <widget class="QFrame" name="framePicksToolbar">
       <property name="styleSheet"><string>background:#F4F6FA; border-bottom:1px solid #D1D9E6; max-height:32px;</string></property>
       <layout class="QHBoxLayout" name="picksToolbarLayout">
        <property name="spacing"><number>4</number></property>
        <property name="leftMargin"><number>6</number></property>
        <property name="topMargin"><number>3</number></property>
        <property name="rightMargin"><number>6</number></property>
        <property name="bottomMargin"><number>3</number></property>
        <item>
         <widget class="QLabel">
          <property name="text"><string>Filter formation:</string></property>
          <property name="styleSheet"><string>color:#64748B; font-size:10px;</string></property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="cmbPicksFilterZone">
          <property name="minimumWidth"><number>130</number></property>
          <item><property name="text"><string>All zones</string></property></item>
         </widget>
        </item>
        <item>
         <widget class="QLabel">
          <property name="text"><string>Filter well:</string></property>
          <property name="styleSheet"><string>color:#64748B; font-size:10px;</string></property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="cmbPicksFilterWell">
          <property name="minimumWidth"><number>130</number></property>
          <item><property name="text"><string>All wells</string></property></item>
         </widget>
        </item>
        <item>
         <spacer>
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <property name="sizeHint"><size><width>1</width><height>1</height></size></property>
         </spacer>
        </item>
        <item>
         <widget class="QPushButton" name="btnPicksExportCSV">
          <property name="text"><string>⇓ CSV</string></property>
          <property name="toolTip"><string>Export picks table as CSV</string></property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="btnPicksClearAll">
          <property name="text"><string>Clear All</string></property>
          <property name="toolTip"><string>Clear all formation picks</string></property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>

     <!-- Picks table -->
     <item>
      <widget class="QTableWidget" name="tableCorrelationPicks">
       <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
       <property name="selectionMode"><enum>QAbstractItemView::ExtendedSelection</enum></property>
       <property name="alternatingRowColors"><bool>true</bool></property>
       <property name="sortingEnabled"><bool>true</bool></property>
       <property name="editTriggers"><set>QAbstractItemView::DoubleClicked|QAbstractItemView::EditKeyPressed</set></property>
       <property name="showGrid"><bool>true</bool></property>
       <property name="gridStyle"><enum>Qt::DotLine</enum></property>
       <property name="columnCount"><number>12</number></property>
       <property name="rowCount"><number>0</number></property>
       <column>
        <property name="text"><string>Well</string></property>
        <property name="toolTip"><string>Well name</string></property>
       </column>
       <column>
        <property name="text"><string>Formation</string></property>
        <property name="toolTip"><string>Formation zone name</string></property>
       </column>
       <column>
        <property name="text"><string>MD (m)</string></property>
        <property name="toolTip"><string>Measured depth of pick</string></property>
       </column>
       <column>
        <property name="text"><string>TVD (m)</string></property>
        <property name="toolTip"><string>True vertical depth</string></property>
       </column>
       <column>
        <property name="text"><string>TVDSS (m)</string></property>
        <property name="toolTip"><string>TVD sub-sea</string></property>
       </column>
       <column>
        <property name="text"><string>GR (API)</string></property>
        <property name="toolTip"><string>Gamma ray at pick depth</string></property>
       </column>
       <column>
        <property name="text"><string>RHOB (g/cc)</string></property>
        <property name="toolTip"><string>Bulk density at pick depth</string></property>
       </column>
       <column>
        <property name="text"><string>RT (ohm.m)</string></property>
        <property name="toolTip"><string>Resistivity at pick depth</string></property>
       </column>
       <column>
        <property name="text"><string>Vsh (v/v)</string></property>
        <property name="toolTip"><string>Shale volume at pick depth</string></property>
       </column>
       <column>
        <property name="text"><string>Confidence</string></property>
        <property name="toolTip"><string>Pick confidence: Certain / Uncertain / Inferred</string></property>
       </column>
       <column>
        <property name="text"><string>Picked By</string></property>
        <property name="toolTip"><string>Interpreter who made the pick</string></property>
       </column>
       <column>
        <property name="text"><string>Notes</string></property>
        <property name="toolTip"><string>Free-text annotation</string></property>
       </column>
      </widget>
     </item>

    </layout>
   </widget>
  </widget>

