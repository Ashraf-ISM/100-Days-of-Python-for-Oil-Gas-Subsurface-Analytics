   <!-- MULTI-WELL -->
   <widget class="QMenu" name="menuMultiWell">
    <property name="title"><string>&amp;Multi-Well</string></property>
    <addaction name="actionWellCorrelation"/>
    <addaction name="actionCrossSection"/>
