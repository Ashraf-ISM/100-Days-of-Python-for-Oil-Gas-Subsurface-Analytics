            <item row="1" column="0"><widget class="QLabel" name="lblScaleLeft"><property name="text"><string>Left Value:</string></property></widget></item>
            <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinScaleLeft"><property name="decimals"><number>2</number></property><property name="minimum"><double>-9999.0</double></property><property name="maximum"><double>99999.0</double></property><property name="value"><double>0.0</double></property></widget></item>
            <item row="2" column="0"><widget class="QLabel" name="lblScaleRight"><property name="text"><string>Right Value:</string></property></widget></item>
            <item row="2" column="1"><widget class="QDoubleSpinBox" name="spinScaleRight"><property name="decimals"><number>2</number></property><property name="minimum"><double>-9999.0</double></property><property name="maximum"><double>99999.0</double></property><property name="value"><double>150.0</double></property></widget></item>
            <item row="3" column="0"><widget class="QLabel" name="lblGridDivs"><property name="text"><string>Divisions:</string></property></widget></item>
            <item row="3" column="1"><widget class="QSpinBox" name="spinGridDivs"><property name="minimum"><number>1</number></property><property name="maximum"><number>20</number></property><property name="value"><number>5</number></property></widget></item>
           </layout>
          </widget>
