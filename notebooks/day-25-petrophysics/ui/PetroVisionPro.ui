            <item row="1" column="0"><widget class="QLabel" name="lblPhiCurve"><property name="text"><string>Phi Curve:</string></property></widget></item>
            <item row="1" column="1"><widget class="QComboBox" name="comboPhiCurve"><item><property name="text"><string>PHIE</string></property></item><item><property name="text"><string>PHIT</string></property></item></widget></item>
            <item row="2" column="0"><widget class="QLabel" name="lblPermCutoff"><property name="text"><string>Perm Cutoff (mD):</string></property></widget></item>
            <item row="2" column="1"><widget class="QDoubleSpinBox" name="spinPermCutoff"><property name="decimals"><number>3</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>10000.0</double></property><property name="singleStep"><double>0.1</double></property><property name="value"><double>0.1</double></property></widget></item>
           </layout>
          </widget>
