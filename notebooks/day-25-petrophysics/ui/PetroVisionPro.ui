  <!-- Depth reference mutually exclusive toggle group -->
  <buttongroup name="depthRefGroup">
   <property name="exclusive"><bool>true</bool></property>
  </buttongroup>
  <!-- Interaction tool radio group -->
  <buttongroup name="toolModeGroup">
   <property name="exclusive"><bool>true</bool></property>
  </buttongroup>
 </buttongroups>

