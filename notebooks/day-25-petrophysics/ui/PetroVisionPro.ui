  <!-- ======================== TOOLBAR 2: WELL DISPLAY ======================== -->
  <widget class="QToolBar" name="toolBarWellDisplay">
   <property name="windowTitle"><string>Well Display Toolbar</string></property>
   <property name="toolButtonStyle">
    <enum>Qt::ToolButtonTextUnderIcon</enum>
   </property>
   <property name="iconSize">
    <size><width>22</width><height>22</height></size>
   </property>
   <attribute name="toolBarArea"><enum>TopToolBarArea</enum></attribute>
   <attribute name="toolBarBreak"><bool>false</bool></attribute>
   <!-- Well Selector inline widget -->
   <widget class="QWidget" name="widgetWellSelector">
    <layout class="QHBoxLayout" name="layoutWellSel">
     <property name="spacing"><number>4</number></property>
     <item>
      <widget class="QLabel" name="lblWellSel">
       <property name="text"><string>Well:</string></property>
       <property name="styleSheet"><string>QLabel{font-weight:600;font-size:11px;color:#1B2B40;}</string></property>
      </widget>
     </item>
     <item>
      <widget class="QComboBox" name="comboActiveWell">
       <property name="minimumWidth"><number>130</number></property>
       <property name="toolTip"><string>Select active well</string></property>
       <item><property name="text"><string>CHr-1</string></property></item>
       <item><property name="text"><string>Tau-1</string></property></item>
       <item><property name="text"><string>Experior</string></property></item>
      </widget>
     </item>
    </layout>
   </widget>
   <addaction name="separator"/>
   <addaction name="actionAddTrack"/>
   <addaction name="actionRemoveTrack"/>
   <addaction name="actionAddCurve"/>
   <addaction name="separator"/>
   <addaction name="actionZoomIn"/>
   <addaction name="actionZoomOut"/>
   <addaction name="actionZoomFit"/>
   <addaction name="actionZoomReset"/>
   <addaction name="separator"/>
   <addaction name="actionToolSelect"/>
   <addaction name="actionToolPan"/>
   <addaction name="actionToolMeasure"/>
   <addaction name="actionToolPick"/>
   <addaction name="separator"/>
   <!-- Depth scale inline widget -->
   <widget class="QWidget" name="widgetDepthScale">
    <layout class="QHBoxLayout" name="layoutDepth">
     <property name="spacing"><number>4</number></property>
     <item>
      <widget class="QLabel" name="lblDepth">
       <property name="text"><string>Scale:</string></property>
       <property name="styleSheet"><string>QLabel{font-weight:600;font-size:11px;color:#1B2B40;}</string></property>
      </widget>
     </item>
     <item>
      <widget class="QComboBox" name="comboDepthMode">
       <property name="minimumWidth"><number>90</number></property>
       <property name="toolTip"><string>Depth reference system</string></property>
       <item><property name="text"><string>MD (ft)</string></property></item>
       <item><property name="text"><string>MD (m)</string></property></item>
       <item><property name="text"><string>TVD (ft)</string></property></item>
       <item><property name="text"><string>TVD (m)</string></property></item>
       <item><property name="text"><string>TVDSS (ft)</string></property></item>
       <item><property name="text"><string>TVDSS (m)</string></property></item>
      </widget>
     </item>
     <item>
      <widget class="QComboBox" name="comboPlotScale">
       <property name="minimumWidth"><number>80</number></property>
       <property name="toolTip"><string>Plot scale</string></property>
       <item><property name="text"><string>1 : 100</string></property></item>
       <item><property name="text"><string>1 : 200</string></property></item>
       <item><property name="text"><string>1 : 500</string></property></item>
       <item><property name="text"><string>1 : 1000</string></property></item>
       <item><property name="text"><string>Fit</string></property></item>
      </widget>
     </item>
    </layout>
   </widget>
