 <!-- ======================== CONNECTIONS ======================== -->
 <connections>

  <!-- File actions wired to status bar feedback placeholders -->
  <connection>
   <sender>actionSaveProject</sender>
   <signal>triggered()</signal>
   <receiver>lblStatusReady</receiver>
   <slot>update()</slot>
   <hints>
    <hint type="sourcelabel"><x>-1</x><y>-1</y></hint>
    <hint type="destinationlabel"><x>840</x><y>974</y></hint>
   </hints>
  </connection>

  <!-- Well selector combo → status bar well label -->
  <connection>
   <sender>comboActiveWell</sender>
   <signal>currentTextChanged(QString)</signal>
   <receiver>lblStatusWell</receiver>
   <slot>setText(QString)</slot>
   <hints>
    <hint type="sourcelabel"><x>200</x><y>38</y></hint>
    <hint type="destinationlabel"><x>120</x><y>974</y></hint>
   </hints>
  </connection>

  <!-- Depth mode combo → status bar depth label -->
  <connection>
   <sender>comboDepthMode</sender>
   <signal>currentTextChanged(QString)</signal>
   <receiver>lblStatusDepth</receiver>
   <slot>setText(QString)</slot>
   <hints>
    <hint type="sourcelabel"><x>400</x><y>38</y></hint>
    <hint type="destinationlabel"><x>300</x><y>974</y></hint>
   </hints>
  </connection>

  <!-- Track scale right spin → curve max spin mirror -->
  <connection>
   <sender>spinScaleRight</sender>
   <signal>valueChanged(double)</signal>
   <receiver>spinCurveMax</receiver>
   <slot>setValue(double)</slot>
   <hints>
    <hint type="sourcelabel"><x>1500</x><y>300</y></hint>
    <hint type="destinationlabel"><x>1500</x><y>500</y></hint>
   </hints>
  </connection>

  <!-- Track scale left spin → curve min spin mirror -->
  <connection>
   <sender>spinScaleLeft</sender>
   <signal>valueChanged(double)</signal>
   <receiver>spinCurveMin</receiver>
   <slot>setValue(double)</slot>
   <hints>
    <hint type="sourcelabel"><x>1500</x><y>280</y></hint>
    <hint type="destinationlabel"><x>1500</x><y>480</y></hint>
   </hints>
  </connection>

  <!-- Statistics well combo → data table well combo sync -->
  <connection>
   <sender>comboStatWell</sender>
   <signal>currentIndexChanged(int)</signal>
   <receiver>comboDTWell</receiver>
   <slot>setCurrentIndex(int)</slot>
   <hints>
    <hint type="sourcelabel"><x>840</x><y>820</y></hint>
    <hint type="destinationlabel"><x>840</x><y>860</y></hint>
   </hints>
  </connection>

  <!-- Project browser well combo → curve well combo sync -->
  <connection>
   <sender>comboActiveWell</sender>
   <signal>currentIndexChanged(int)</signal>
   <receiver>comboCurveWell</receiver>
   <slot>setCurrentIndex(int)</slot>
   <hints>
    <hint type="sourcelabel"><x>200</x><y>38</y></hint>
    <hint type="destinationlabel"><x>120</x><y>200</y></hint>
   </hints>
  </connection>

  <!-- Zone well combo syncs to stat well combo -->
  <connection>
   <sender>comboZoneWell</sender>
   <signal>currentIndexChanged(int)</signal>
   <receiver>comboStatZone</receiver>
   <slot>setCurrentIndex(int)</slot>
   <hints>
    <hint type="sourcelabel"><x>120</x><y>400</y></hint>
    <hint type="destinationlabel"><x>840</x><y>825</y></hint>
   </hints>
  </connection>

 </connections>

