    <!-- ======================== BOTTOM DOCK: DATA & ANALYSIS ======================== -->
  <widget class="QDockWidget" name="dockData">
   <property name="windowTitle"><string>  Data &amp; Analysis</string></property>
   <property name="features">
    <set>QDockWidget::DockWidgetMovable|QDockWidget::DockWidgetFloatable|QDockWidget::DockWidgetClosable</set>
   </property>
   <attribute name="dockWidgetArea"><number>8</number></attribute>
   <widget class="QWidget" name="dockDataContents">
    <layout class="QVBoxLayout" name="layoutDataMain">
     <item>
      <widget class="QTabWidget" name="tabDataHub">
       <property name="tabPosition"><enum>QTabWidget::North</enum></property>

       <!-- ALL DATA -->
       <widget class="QWidget" name="tabDataAll">
        <attribute name="title"><string>All Data</string></attribute>
        <layout class="QVBoxLayout" name="layoutDataAll">
         <item>
          <layout class="QHBoxLayout" name="layoutDataAllControls">
           <item><widget class="QLabel" name="lblDTWell"><property name="text"><string>Well:</string></property></widget></item>
           <item>
            <widget class="QComboBox" name="comboDTWell">
             <item><property name="text"><string>CHr-1</string></property></item>
             <item><property name="text"><string>Tau-1</string></property></item>
             <item><property name="text"><string>Experior</string></property></item>
            </widget>
           </item>
           <item><widget class="QLabel" name="lblDTFrom"><property name="text"><string>From:</string></property></widget></item>
           <item><widget class="QDoubleSpinBox" name="spinDTFrom"><property name="decimals"><number>1</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>99999.0</double></property><property name="value"><double>3000.0</double></property></widget></item>
           <item><widget class="QLabel" name="lblDTTo"><property name="text"><string>To:</string></property></widget></item>
           <item><widget class="QDoubleSpinBox" name="spinDTTo"><property name="decimals"><number>1</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>99999.0</double></property><property name="value"><double>4000.0</double></property></widget></item>
           <item><widget class="QPushButton" name="btnLoadData"><property name="text"><string>Load</string></property><property name="maximumWidth"><number>70</number></property></widget></item>
           <item><widget class="QPushButton" name="btnExportTable"><property name="text"><string>Export CSV</string></property><property name="maximumWidth"><number>95</number></property></widget></item>
           <item>
            <spacer name="spacerDT">
             <property name="orientation"><enum>Qt::Horizontal</enum></property>
             <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
            </spacer>
           </item>
          </layout>
         </item>
         <item>
          <widget class="QTableWidget" name="tableData">
           <property name="alternatingRowColors"><bool>true</bool></property>
           <property name="rowCount"><number>0</number></property>
           <property name="columnCount"><number>12</number></property>
           <column><property name="text"><string>DEPTH</string></property></column>
           <column><property name="text"><string>GR</string></property></column>
           <column><property name="text"><string>SP</string></property></column>
           <column><property name="text"><string>CALI</string></property></column>
           <column><property name="text"><string>RHOB</string></property></column>
           <column><property name="text"><string>NPHI</string></property></column>
           <column><property name="text"><string>LLD</string></property></column>
