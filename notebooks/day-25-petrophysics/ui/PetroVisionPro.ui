       <!-- NET PAY / ZONE CRITERIA -->
       <widget class="QWidget" name="tabZoneCriteria">
        <attribute name="title"><string>Net Pay</string></attribute>
        <layout class="QVBoxLayout" name="layoutZoneCriteria">
         <property name="spacing"><number>5</number></property>
         <item>
          <widget class="QGroupBox" name="groupGrossCriteria">
           <property name="title"><string>Gross Rock Criteria</string></property>
