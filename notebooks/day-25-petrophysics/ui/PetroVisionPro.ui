            </item>
            <item row="3" column="0"><widget class="QLabel" name="lblTrackGrid"><property name="text"><string>Grid Lines:</string></property></widget></item>
            <item row="3" column="1"><widget class="QCheckBox" name="checkTrackGrid"><property name="text"><string>Show Grid</string></property><property name="checked"><bool>true</bool></property></widget></item>
            <item row="4" column="0"><widget class="QLabel" name="lblTrackDepthLabel"><property name="text"><string>Depth Labels:</string></property></widget></item>
            <item row="4" column="1"><widget class="QCheckBox" name="checkTrackDepthLabel"><property name="text"><string>Show Labels</string></property><property name="checked"><bool>true</bool></property></widget></item>
           </layout>
          </widget>
         </item>
         <item>
          <widget class="QGroupBox" name="groupTrackScale">
           <property name="title"><string>Scale Settings</string></property>
           <layout class="QFormLayout" name="formTrackScale">
            <property name="verticalSpacing"><number>6</number></property>
            <item row="0" column="0"><widget class="QLabel" name="lblScaleType"><property name="text"><string>Scale Type:</string></property></widget></item>
