           <column><property name="text"><string>Top (ft)</string></property></column>
           <column><property name="text"><string>Base (ft)</string></property></column>
           <column><property name="text"><string>Thickness</string></property></column>
           <column><property name="text"><string>Color</string></property></column>
          </widget>
         </item>
         <item>
          <layout class="QHBoxLayout" name="layoutZoneBtns">
           <item><widget class="QPushButton" name="btnAddZone"><property name="text"><string>+ Zone</string></property></widget></item>
           <item><widget class="QPushButton" name="btnEditZone"><property name="text"><string>Edit</string></property></widget></item>
           <item><widget class="QPushButton" name="btnDeleteZone"><property name="text"><string>Delete</string></property></widget></item>
          </layout>
         </item>
        </layout>
       </widget>

      </widget>
     </item>
    </layout>
   </widget>
  </widget>

  <!-- ======================== RIGHT DOCK: PROPERTIES ======================== -->
  <widget class="QDockWidget" name="dockProperties">
   <property name="windowTitle"><string>  Properties</string></property>
   <property name="features">
    <set>QDockWidget::DockWidgetMovable|QDockWidget::DockWidgetFloatable|QDockWidget::DockWidgetClosable</set>
   </property>
   <property name="minimumWidth"><number>240</number></property>
   <attribute name="dockWidgetArea"><number>2</number></attribute>
   <widget class="QWidget" name="dockPropertiesContents">
    <layout class="QVBoxLayout" name="layoutPropertiesMain">
     <property name="spacing"><number>4</number></property>
     <item>
      <widget class="QTabWidget" name="tabProperties">
       <property name="tabPosition"><enum>QTabWidget::North</enum></property>

       <!-- TRACK PROPERTIES -->
       <widget class="QWidget" name="tabTrackProps">
        <attribute name="title"><string>Track</string></attribute>
        <layout class="QVBoxLayout" name="layoutTrackProps">
         <property name="spacing"><number>5</number></property>
         <item>
          <widget class="QGroupBox" name="groupTrackGeneral">
           <property name="title"><string>Track Settings</string></property>
           <layout class="QFormLayout" name="formTrackGeneral">
            <property name="verticalSpacing"><number>6</number></property>
