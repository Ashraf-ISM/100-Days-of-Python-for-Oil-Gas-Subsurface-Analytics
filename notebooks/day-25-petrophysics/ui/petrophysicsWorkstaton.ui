p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Consolas'; font-size:8.25pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'monospace'; font-size:11px; font-weight:600; color:#2ab7ca;&quot;&gt;Linear IGR:&lt;/span&gt;&lt;span style=&quot; font-family:'monospace'; font-size:11px; color:#2ab7ca;&quot;&gt;&lt;br /&gt;IGR = (GR - GR_clean) / (GR_shale - GR_clean)&lt;br /&gt;&lt;br /&gt;&lt;/span&gt;&lt;span style=&quot; font-family:'monospace'; font-size:11px; font-weight:600; color:#2ab7ca;&quot;&gt;Larionov (Tertiary):&lt;/span&gt;&lt;span style=&quot; font-family:'monospace'; font-size:11px; color:#2ab7ca;&quot;&gt;&lt;br /&gt;Vsh = 0.083 × (2^(3.7 × IGR) - 1)&lt;br /&gt;&lt;br /&gt;&lt;/span&gt;&lt;span style=&quot; font-family:'monospace'; font-size:11px; font-weight:600; color:#2ab7ca;&quot;&gt;Clavier:&lt;/span&gt;&lt;span style=&quot; font-family:'monospace'; font-size:11px; color:#2ab7ca;&quot;&gt;&lt;br /&gt;Vsh = 1.7 - (3.38 - (IGR + 0.7)²)^0.5 &lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                       </property>
                      </widget>
                     </item>
                    </layout>
                   </widget>
                  </item>
                 </layout>
                </item>
                <item>
                 <layout class="QHBoxLayout">
                  <item>
                   <widget class="QPushButton" name="btnCalculate">
                    <property name="text">
                     <string>▶  Calculate Vshale</string>
                    </property>
                   </widget>
                  </item>
                  <item>
