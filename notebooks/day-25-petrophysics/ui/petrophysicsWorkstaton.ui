  <property name="styleSheet">
   <string notr="true">/* ─────────────────────────────────────────────────────────────
   PetroSight Pro — Clean Light Theme (Fixed)
   ───────────────────────────────────────────────────────────── */

QMainWindow {
  background-color: #F8FAFC;
  color: #1E293B;
  font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;, sans-serif;
  font-size: 13px;
}

/* ── Menu Bar ── */
QMenuBar {
  background-color: #FFFFFF;
  color: #1E293B;
  border-bottom: 1px solid #E2E8F0;
}
QMenuBar::item:selected {
  background-color: #E2E8F0;
  color: #2563EB;
}

/* ── Menu ── */
QMenu {
  background-color: #FFFFFF;
  color: #1E293B;
  border: 1px solid #CBD5E1;
}
QMenu::item:selected {
  background-color: #E2E8F0;
  color: #2563EB;
}

/* ── Toolbar ── */
QToolBar {
  background-color: #FFFFFF;
  border-bottom: 1px solid #E2E8F0;
}
QToolButton {
  color: #475569;
  padding: 6px;
  border-radius: 6px;
}
QToolButton:hover {
  background-color: #E2E8F0;
  color: #2563EB;
}

/* ── Tabs ── */
QTabWidget::pane {
  background-color: #FFFFFF;
  border: 1px solid #E2E8F0;
}
QTabBar::tab {
  background-color: #F1F5F9;
  color: #475569;
  padding: 8px 16px;
  border-radius: 6px;
}
QTabBar::tab:selected {
  background-color: #FFFFFF;
  color: #2563EB;
  border-bottom: 2px solid #2563EB;
}

/* ── Tree ── */
QTreeWidget {
  background-color: #FFFFFF;
  color: #1E293B;
}
QTreeWidget::item:selected {
  background-color: #DBEAFE;
  color: #1D4ED8;
}

/* ── Tables ── */
QTableWidget, QTableView {
  background-color: #FFFFFF;
  color: #1E293B;
  gridline-color: #E2E8F0;
}
QHeaderView::section {
  background-color: #F1F5F9;
  color: #475569;
  padding: 6px;
}

/* ── Inputs ── */
QLineEdit, QSpinBox, QDoubleSpinBox {
  background-color: #FFFFFF;
  color: #1E293B;
  border: 1px solid #CBD5E1;
  border-radius: 6px;
  padding: 6px;
}
QLineEdit:focus {
  border-color: #2563EB;
}

/* ── ComboBox (FIXED &amp; CLEAN) ── */
QComboBox {
  background-color: #FFFFFF;
  color: #1E293B;
  border: 1px solid #CBD5E1;
  border-radius: 6px;
  padding: 6px 10px;
}

QComboBox:hover {
  border-color: #2563EB;
}

QComboBox::drop-down {
  border: none;
  width: 20px;
}

QComboBox::down-arrow {
  image: none;
}

QComboBox QAbstractItemView {
  background-color: #FFFFFF;
  color: #1E293B;
  border: 1px solid #CBD5E1;
  selection-background-color: #2563EB;
  selection-color: #FFFFFF;
}

/* ── Buttons ── */
QPushButton {
  background-color: #E2E8F0;
  color: #1E293B;
  border-radius: 6px;
  padding: 6px 14px;
}
QPushButton:hover {
  background-color: #CBD5E1;
}

/* Primary buttons */
QPushButton#btnRunAll {
  background-color: #2563EB;
  color: #FFFFFF;
}
QPushButton#btnRunAll:hover {
  background-color: #1D4ED8;
}

QPushButton#btnImport {
  background-color: #14B8A6;
  color: #FFFFFF;
}
QPushButton#btnImport:hover {
  background-color: #0D9488;
}

/* ── GroupBox ── */
QGroupBox {
  border: 1px solid #E2E8F0;
  border-radius: 8px;
  margin-top: 10px;
  padding: 10px;
  color: #475569;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
}

/* ── CheckBox &amp; Radio ── */
QCheckBox, QRadioButton {
  color: #1E293B;
}

QCheckBox::indicator, QRadioButton::indicator {
  background-color: #FFFFFF;
  border: 1px solid #CBD5E1;
}

QCheckBox::indicator:checked {
  background-color: #2563EB;
}

QRadioButton::indicator:checked {
  background-color: #14B8A6;
}

/* ── Slider ── */
QSlider::groove:horizontal {
  background: #E2E8F0;
  height: 4px;
}
QSlider::handle:horizontal {
  background: #2563EB;
  width: 14px;
  border-radius: 7px;
}

/* ── Progress ── */
QProgressBar {
  background-color: #F1F5F9;
  border: 1px solid #CBD5E1;
}
QProgressBar::chunk {
  background-color: #14B8A6;
}

/* ── Text Output ── */
QTextBrowser, QPlainTextEdit {
  background-color: #F8FAFC;
  color: #0F172A;
  border: 1px solid #E2E8F0;
  font-family: Consolas;
}

/* ── Status Bar ── */
QStatusBar {
  background-color: #FFFFFF;
  color: #64748B;
}</string>
