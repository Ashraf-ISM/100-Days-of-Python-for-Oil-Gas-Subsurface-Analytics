  <property name="windowTitle">
   <string>Facies Classification — PetroARX</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
/* ===== GLOBAL ===== */
QWidget {
    background-color: #F7FAFC;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 9pt;
    color: #2D3748;
}
/* ===== HEADER ===== */
QFrame#headerFrame {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 #1A365D, stop:0.45 #2C5282, stop:1 #2B6CB0);
    border-radius: 8px;
    min-height: 64px;
    max-height: 72px;
}
QLabel#lblTitle {
    color: #FFFFFF;
    font-size: 15pt;
    font-weight: bold;
}
QLabel#lblSubtitle {
    color: #BEE3F8;
    font-size: 8pt;
}
/* ===== STATUS BAR ===== */
QFrame#statusFrame {
    background: #EBF8FF;
    border: 1px solid #90CDF4;
    border-radius: 5px;
    max-height: 34px;
    min-height: 34px;
}
/* ===== GROUPBOX ===== */
QGroupBox {
    background: #FFFFFF;
    font-weight: bold;
    font-size: 9pt;
    color: #1A365D;
    border: 1.5px solid #BEE3F8;
    border-radius: 7px;
    margin-top: 10px;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    background: #FFFFFF;
}
QGroupBox:disabled { border-color: #E2E8F0; color: #A0AEC0; }
/* ===== TAB WIDGET ===== */
QTabWidget::pane {
    border: 1px solid #BEE3F8;
    background: #FFFFFF;
    border-radius: 5px;
}
QTabBar::tab {
    background: #EDF2F7;
    color: #4A5568;
    padding: 5px 9px;
    border: 1px solid #CBD5E0;
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    min-width: 60px;
    font-size: 8pt;
}
QTabBar::tab:selected {
    background: #2C5282;
    color: #FFFFFF;
    font-weight: bold;
}
QTabBar::tab:hover:!selected { background: #BEE3F8; color: #2C5282; }
/* ===== MAIN BUTTONS ===== */
QPushButton {
    background-color: #2B6CB0;
    color: #FFFFFF;
    border: none;
    border-radius: 5px;
    padding: 6px 14px;
    font-size: 9pt;
    font-weight: bold;
    min-height: 28px;
}
QPushButton:hover { background-color: #2C5282; }
QPushButton:pressed { background-color: #1A365D; }
QPushButton:disabled { background: #CBD5E0; color: #A0AEC0; }
QPushButton#btnRunClassification,
QPushButton#btnRunClassificationLeft {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #68D391, stop:1 #38A169);
    min-width: 160px;
    font-size: 10pt;
}
QPushButton#btnRunClassification:hover,
QPushButton#btnRunClassificationLeft:hover { background: #2F855A; }
QPushButton#btnResetAll {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #FC8181, stop:1 #E53E3E);
}
QPushButton#btnResetAll:hover { background: #C53030; }
QPushButton#btnExportResults,
QPushButton#btnExportNow,
QPushButton#btnSaveReportPDF {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #F6AD55, stop:1 #D69E2E);
}
QPushButton#btnExportResults:hover,
QPushButton#btnExportNow:hover,
QPushButton#btnSaveReportPDF:hover { background: #B7791F; }
QPushButton#btnGenerateReport,
QPushButton#btnGenerateReportContent {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #B794F4, stop:1 #805AD5);
}
QPushButton#btnGenerateReport:hover,
QPushButton#btnGenerateReportContent:hover { background: #6B46C1; }
/* Tool / Small Buttons */
QPushButton#btnAddCurveRow, QPushButton#btnRemoveCurveRow,
QPushButton#btnAutoDetectCurves, QPushButton#btnLoadCoreData,
QPushButton#btnAddFaciesRow, QPushButton#btnRemoveFaciesRow,
QPushButton#btnAutoColorFacies, QPushButton#btnSaveFaciesTemplate,
QPushButton#btnLoadFaciesTemplate, QPushButton#btnAddRule,
QPushButton#btnRemoveRule, QPushButton#btnClearRules,
QPushButton#btnImportRules, QPushButton#btnExportStatsCSV,
QPushButton#btnExportStatsExcel, QPushButton#btnRunElbowAnalysis,
QPushButton#btnUpdateChart {
    background: #EDF2F7;
    color: #2C5282;
    border: 1px solid #BEE3F8;
    padding: 3px 8px;
    min-height: 22px;
    font-size: 8pt;
    font-weight: normal;
    border-radius: 3px;
}
QPushButton#btnAddCurveRow:hover, QPushButton#btnRemoveCurveRow:hover,
QPushButton#btnAutoDetectCurves:hover, QPushButton#btnLoadCoreData:hover,
QPushButton#btnAddFaciesRow:hover, QPushButton#btnRemoveFaciesRow:hover,
QPushButton#btnAutoColorFacies:hover, QPushButton#btnSaveFaciesTemplate:hover,
QPushButton#btnLoadFaciesTemplate:hover, QPushButton#btnAddRule:hover,
QPushButton#btnRemoveRule:hover, QPushButton#btnClearRules:hover,
QPushButton#btnImportRules:hover, QPushButton#btnExportStatsCSV:hover,
QPushButton#btnExportStatsExcel:hover, QPushButton#btnRunElbowAnalysis:hover,
QPushButton#btnUpdateChart:hover { background: #BEE3F8; border-color: #90CDF4; }
/* View Toolbar buttons */
QPushButton#btnZoomIn, QPushButton#btnZoomOut, QPushButton#btnFitView,
QPushButton#btnPanMode, QPushButton#btnScreenshotLogView,
QPushButton#btnPrintLogView, QPushButton#btnUpdateCrossplot,
QPushButton#btnPrintReport, QPushButton#btnBrowseCoreFile,
QPushButton#btnBrowseExportDir {
    background: #EDF2F7;
    color: #2D3748;
    border: 1px solid #CBD5E0;
    padding: 4px 8px;
    min-height: 26px;
    font-size: 8pt;
    font-weight: normal;
    border-radius: 3px;
}
QPushButton#btnZoomIn:hover, QPushButton#btnZoomOut:hover,
QPushButton#btnFitView:hover, QPushButton#btnPanMode:hover,
QPushButton#btnScreenshotLogView:hover, QPushButton#btnPrintLogView:hover,
QPushButton#btnUpdateCrossplot:hover, QPushButton#btnPrintReport:hover,
QPushButton#btnBrowseCoreFile:hover, QPushButton#btnBrowseExportDir:hover { background: #BEE3F8; }
QPushButton#btnPanMode:checked { background: #2B6CB0; color: white; }
QPushButton#btnBrowseExportDirSmall {
    background: #4A5568; color: white; padding: 4px 8px;
    min-height: 26px; font-size: 8pt; border-radius: 3px; border: none; font-weight: normal;
}
/* ===== COMBOBOX ===== */
QComboBox {
    border: 1.5px solid #CBD5E0;
    border-radius: 4px;
    padding: 4px 8px;
    background: #FFFFFF;
    min-height: 26px;
}
QComboBox:hover { border-color: #4299E1; }
QComboBox:focus { border-color: #2B6CB0; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1.5px solid #90CDF4;
    selection-background-color: #BEE3F8;
    selection-color: #1A365D;
}
/* ===== SPINBOX ===== */
QSpinBox, QDoubleSpinBox {
    border: 1.5px solid #CBD5E0;
    border-radius: 4px;
    padding: 4px 6px;
    background: #FFFFFF;
    min-height: 26px;
}
QSpinBox:focus, QDoubleSpinBox:focus { border-color: #2B6CB0; }
/* ===== LINEEDIT ===== */
QLineEdit {
    border: 1.5px solid #CBD5E0;
    border-radius: 4px;
    padding: 4px 8px;
    background: #FFFFFF;
    min-height: 26px;
}
QLineEdit:focus { border-color: #2B6CB0; }
QLineEdit:read-only { background: #EDF2F7; color: #718096; }
/* ===== LISTWIDGET ===== */
QListWidget {
    border: 1.5px solid #CBD5E0;
    border-radius: 4px;
    background: #FFFFFF;
    alternate-background-color: #F7FAFC;
    outline: 0;
}
QListWidget::item { padding: 4px 8px; }
QListWidget::item:selected { background: #BEE3F8; color: #1A365D; }
QListWidget::item:hover { background: #EBF8FF; }
/* ===== TABLEWIDGET ===== */
QTableWidget {
    border: 1.5px solid #CBD5E0;
    border-radius: 4px;
    background: #FFFFFF;
    gridline-color: #E2E8F0;
    selection-background-color: #BEE3F8;
    selection-color: #1A365D;
    alternate-background-color: #F7FAFC;
    outline: 0;
}
QTableWidget::item { padding: 4px 6px; }
QHeaderView::section {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #2C5282, stop:1 #1A365D);
    color: #FFFFFF;
    padding: 6px 8px;
    border: none;
    border-right: 1px solid #2B6CB0;
    font-weight: bold;
    font-size: 8pt;
}
QHeaderView::section:last { border-right: none; }
/* ===== SCROLLBAR ===== */
QScrollBar:vertical { background: #F7FAFC; width: 7px; border-radius: 4px; margin: 0; }
QScrollBar::handle:vertical { background: #CBD5E0; border-radius: 4px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: #4299E1; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #F7FAFC; height: 7px; border-radius: 4px; margin: 0; }
QScrollBar::handle:horizontal { background: #CBD5E0; border-radius: 4px; min-width: 28px; }
QScrollBar::handle:horizontal:hover { background: #4299E1; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
/* ===== PROGRESSBAR ===== */
QProgressBar {
    border: 1.5px solid #CBD5E0;
    border-radius: 5px;
    background: #EDF2F7;
    text-align: center;
    font-size: 8pt;
    font-weight: bold;
    color: #2C5282;
    max-height: 18px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 #4299E1, stop:1 #48BB78);
    border-radius: 4px;
}
/* ===== CHECKBOX / RADIO ===== */
QCheckBox { spacing: 6px; color: #2D3748; }
QCheckBox::indicator {
    width: 14px; height: 14px;
    border: 1.5px solid #CBD5E0;
    border-radius: 3px; background: #FFFFFF;
}
QCheckBox::indicator:checked { background: #2B6CB0; border-color: #2B6CB0; }
QCheckBox::indicator:hover { border-color: #4299E1; }
QCheckBox:disabled { color: #A0AEC0; }
QRadioButton { spacing: 6px; color: #2D3748; }
QRadioButton::indicator {
    width: 14px; height: 14px;
    border: 1.5px solid #CBD5E0;
    border-radius: 7px; background: #FFFFFF;
}
QRadioButton::indicator:checked { background: #2B6CB0; border-color: #2B6CB0; }
/* ===== SLIDER ===== */
QSlider::groove:horizontal { background: #E2E8F0; height: 6px; border-radius: 3px; }
QSlider::handle:horizontal {
    background: #2B6CB0; width: 14px; height: 14px;
    border-radius: 7px; margin: -4px 0;
}
QSlider::sub-page:horizontal { background: #4299E1; border-radius: 3px; }
/* ===== SPLITTER ===== */
QSplitter::handle { background: #CBD5E0; }
QSplitter::handle:horizontal { width: 4px; }
QSplitter::handle:vertical { height: 4px; }
/* ===== TEXTBROWSER ===== */
QTextBrowser {
    border: 1.5px solid #CBD5E0;
    border-radius: 5px;
    background: #FFFFFF;
    font-size: 9pt;
}
/* ===== PLOT PLACEHOLDERS ===== */
QFrame#frameLogPlot, QFrame#frameCrossplot,
QFrame#frameElbowPlot, QFrame#frameSilhouettePlot,
QFrame#framePCAPlot, QFrame#frameFeaturePlot,
QFrame#frameConfMatPlot, QFrame#frameStatsChart {
    background: #F7FAFC;
    border: 2px dashed #CBD5E0;
    border-radius: 8px;
}
QLabel#lblLogPlotPlaceholder, QLabel#lblCrossplotPlaceholder,
QLabel#lblElbowPlaceholder, QLabel#lblSilhouettePlaceholder,
QLabel#lblPCAPlaceholder, QLabel#lblFeaturePlaceholder,
QLabel#lblConfMatPlaceholder, QLabel#lblStatsChartPlaceholder {
    color: #A0AEC0;
    font-size: 11pt;
    font-style: italic;
}
/* ===== HINT / INFO LABELS ===== */
QLabel#lblAlgorithmDescription {
    color: #2C5282;
    font-size: 8pt;
    background: #EBF8FF;
    border: 1px solid #90CDF4;
    border-radius: 4px;
    padding: 6px 8px;
}
QLabel#lblCoresHint, QLabel#lblRuleBasedHint {
    background: #FFFBEB;
    border: 1px solid #F6E05E;
    border-radius: 4px;
    padding: 5px 8px;
    color: #744210;
    font-size: 8pt;
}
QLabel#lblMetricValue {
    background: #EBF8FF;
    border: 1px solid #90CDF4;
    border-radius: 4px;
    padding: 3px 8px;
    color: #2B6CB0;
    font-weight: bold;
    font-size: 8pt;
}
/* ===== LEGEND PANEL ===== */
QFrame#legendFrame {
    background: #FFFFFF;
    border: 1.5px solid #BEE3F8;
    border-radius: 6px;
}
QFrame#metricsFrame {
    background: #F7FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 5px;
}
/* ===== TOOLBAR FRAMES ===== */
QFrame#logViewToolbarFrame, QFrame#crossplotControlsFrame,
QFrame#reportToolbarFrame {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 4px;
}
