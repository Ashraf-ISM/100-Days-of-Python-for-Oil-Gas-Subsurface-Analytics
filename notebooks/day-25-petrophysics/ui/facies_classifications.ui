 <connections>
  <connection>
   <sender>cmbAlgorithm</sender>
   <signal>currentIndexChanged(int)</signal>
   <receiver>stackedAlgoParams</receiver>
   <slot>setCurrentIndex(int)</slot>
   <hints>
