&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI'; font-style:italic; color:#718096;&quot;&gt;Click &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI'; font-weight:600; font-style:italic; color:#718096;&quot;&gt;Generate Preview&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI'; font-style:italic; color:#718096;&quot;&gt; after running a classification to populate this panel.&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI'; color:#4a5568;&quot;&gt; &lt;/span&gt;&lt;/p&gt;
&lt;hr /&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI'; color:#4a5568;&quot;&gt;The report will include: &lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;&lt;li style=&quot; font-family:'Segoe UI'; color:#4a5568;&quot; style=&quot; margin-top:12px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Executive summary with method and key metrics &lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI'; color:#4a5568;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Facies description table with colours and rock types &lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI'; color:#4a5568;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Log view figures (composite display) &lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI'; color:#4a5568;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Crossplots coloured by facies class &lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI'; color:#4a5568;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Statistical summary per facies &lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI'; color:#4a5568;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Diagnostic plots (elbow, silhouette, confusion matrix) &lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI'; color:#4a5568;&quot; style=&quot; margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Input parameters and pre-processing settings &lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
