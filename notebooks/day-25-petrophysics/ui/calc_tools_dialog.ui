                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Cap Sw [0–1]:</string></property></widget></item>
                <item row="1" column="1"><widget class="QCheckBox" name="checkSw2Cap"><property name="text"><string>Enabled</string></property><property name="checked"><bool>true</bool></property></widget></item>
               </layout>
              </widget>
             </item>
