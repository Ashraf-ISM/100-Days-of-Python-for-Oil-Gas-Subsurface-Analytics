<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>CalcToolsDialog</class>
 <widget class="QDialog" name="CalcToolsDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1160</width>
    <height>820</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size>
    <width>1000</width>
    <height>700</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>PetroARX — Calculations &amp; Tools</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
/* ============================================================
   PETROARX — CALCULATIONS &amp; TOOLS DIALOG
   Inherits the main Light Professional Theme
   ============================================================ */

QDialog {
    background-color: #EBF0F6;
    font-family: "Segoe UI", "Noto Sans", sans-serif;
}

/* ---- Header Banner ---- */
#frameHeader {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1D4A85, stop:0.5 #2A5C9E, stop:1 #3A72B5);
    border-bottom: 2px solid #1A3F78;
    min-height: 52px;
    max-height: 52px;
}
#lblHeaderTitle {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.5px;
}
#lblHeaderSub {
    color: rgba(210,230,255,0.85);
    font-size: 11px;
    font-weight: 400;
}

/* ---- Navigation Tree ---- */
#treeNav {
    background-color: #F0F5FB;
    border: none;
    border-right: 1px solid #C2D0E0;
    font-size: 12px;
    outline: 0;
    color: #1B2B40;
    min-width: 210px;
    max-width: 210px;
}
#treeNav::item {
    padding: 5px 8px 5px 6px;
    border-radius: 3px;
    min-height: 22px;
}
#treeNav::item:hover {
    background-color: #D6E5F5;
}
#treeNav::item:selected {
    background-color: #3A72B5;
    color: #FFFFFF;
    border-radius: 3px;
}
#treeNav QHeaderView { height: 0px; }

/* ---- Stacked Content Area ---- */
#stackedContent {
    background-color: #EBF0F6;
}

/* ---- Module Pages ---- */
QGroupBox {
    font-size: 11px;
    font-weight: 700;
    color: #2A5090;
    border: 1px solid #C2D4E6;
    border-radius: 5px;
    margin-top: 10px;
    padding-top: 10px;
    background-color: #FAFCFF;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px;
    background-color: #FAFCFF;
    color: #2A5090;
}

/* ---- Buttons ---- */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #4A82C4, stop:1 #2A5C9E);
    color: #FFFFFF;
    border: 1px solid #1D4A85;
    border-radius: 4px;
    padding: 5px 14px;
    font-size: 11px;
    font-weight: 600;
    min-height: 26px;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5A92D4, stop:1 #3A6CAE);
}
QPushButton:pressed { background-color: #1D4A85; }
QPushButton:disabled {
    background-color: #C8D8E8;
    color: #8898A8;
    border-color: #B8C8D8;
}
QPushButton#btnClose {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #E0E8F0, stop:1 #C8D4E0);
    color: #2B4A6E;
    border-color: #AABBD0;
}
QPushButton#btnClose:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #D0DCE8, stop:1 #B8C8D8);
}
QPushButton#btnReset {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #F5E8D0, stop:1 #DFCAAA);
    color: #6B4A1A;
    border-color: #C8A870;
}
QPushButton#btnCalculate {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3CB85A, stop:1 #259645);
    color: #FFFFFF;
    border-color: #1E7A38;
    min-width: 110px;
}
QPushButton#btnCalculate:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #4CC86A, stop:1 #35A655);
}

/* ---- Form Controls ---- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #BFCFDF;
    border-radius: 3px;
    padding: 3px 7px;
    color: #1B2B40;
    font-size: 12px;
    min-height: 22px;
    selection-background-color: #3A72B5;
    selection-color: white;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #3A72B5;
    background-color: #F0F7FF;
}
QComboBox::drop-down { border: none; padding-right: 5px; width: 18px; }
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #BFCFDF;
    selection-background-color: #3A72B5;
    selection-color: white;
    font-size: 12px;
}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #E0EAF5; border: none; border-radius: 2px; width: 16px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #3A72B5; color: white;
}

/* ---- CheckBox / RadioButton ---- */
QCheckBox, QRadioButton {
    font-size: 12px; color: #1B2B40; spacing: 5px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px; height: 14px;
    border: 1.5px solid #9BB0C6;
    background-color: white;
}
QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #3A72B5; border-color: #2A5C9E;
}

/* ---- Table Widget ---- */
QTableWidget, QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #EFF5FC;
    gridline-color: #D8E6F2;
    border: 1px solid #C2D0E0;
    border-radius: 3px;
    font-size: 11px;
    color: #1B2B40;
    selection-background-color: #3A72B5;
    selection-color: white;
}
QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #EBF0F6, stop:1 #DDEAF5);
    color: #2B4A6E;
    border: none;
    border-right: 1px solid #C8D8E8;
    border-bottom: 1px solid #C8D8E8;
    padding: 5px 8px;
    font-weight: 700;
    font-size: 11px;
}

/* ---- Tab Widget ---- */
QTabWidget::pane {
    background-color: #FFFFFF;
    border: 1px solid #C2D0E0;
    border-radius: 0 4px 4px 4px;
    top: -1px;
}
QTabBar::tab {
    background-color: #D5E3F0;
    color: #3A5878;
    padding: 5px 12px;
    border: 1px solid #BECFE6;
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    margin-right: 2px;
    font-size: 11px;
    font-weight: 600;
    min-width: 48px;
}
QTabBar::tab:selected { background-color: #3A72B5; color: #FFFFFF; border-color: #2A5C9E; }
QTabBar::tab:hover:!selected { background-color: #C0D5EC; color: #1B2B40; }

/* ---- Labels ---- */
QLabel { color: #1B2B40; font-size: 12px; }

/* ---- Progress Bar ---- */
QProgressBar {
    background-color: #DCE9F5;
    border: 1px solid #BFCFDF;
    border-radius: 4px;
    text-align: center;
    color: #1B2B40;
    font-size: 11px;
    font-weight: 600;
    max-height: 14px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3A72B5, stop:1 #56A0E0);
    border-radius: 3px;
}

/* ---- Scroll Bars ---- */
QScrollBar:vertical {
    background-color: #EBF0F6; width: 12px; border-radius: 6px; margin: 0;
}
QScrollBar::handle:vertical {
    background-color: #AABFD6; border-radius: 5px; min-height: 28px; margin: 2px;
}
QScrollBar::handle:vertical:hover { background-color: #3A72B5; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background-color: #EBF0F6; height: 12px; border-radius: 6px; margin: 0;
}
QScrollBar::handle:horizontal {
    background-color: #AABFD6; border-radius: 5px; min-width: 28px; margin: 2px;
}
QScrollBar::handle:horizontal:hover { background-color: #3A72B5; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---- Tool Tips ---- */
QToolTip {
    background-color: #1D3A5E; color: #FFFFFF;
    border: 1px solid #9BB8D5; border-radius: 4px;
    padding: 5px 9px; font-size: 11px;
}

/* ---- Splitter ---- */
QSplitter::handle { background-color: #C2D0E0; }
QSplitter::handle:horizontal { width: 3px; }
QSplitter::handle:hover { background-color: #3A72B5; }

/* ---- Bottom Bar ---- */
#frameBottomBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #E0E8F2, stop:1 #D0DCEC);
    border-top: 1px solid #C2D0E0;
    min-height: 46px;
    max-height: 46px;
}
#lblStatusMsg {
    color: #3A5878;
    font-size: 11px;
    font-style: italic;
}

/* ---- Canvas Frames ---- */
#frameCanvas {
    background: #FFFFFF;
    border: 1px solid #C2D0E0;
    border-radius: 4px;
}

/* ---- Welcome page ---- */
#lblWelcomeTitle {
    color: #2A5090;
    font-size: 17px;
    font-weight: 700;
}
#lblWelcomeSub {
    color: #4A6A8A;
    font-size: 12px;
}

/* ---- Section badge labels ---- */
#lblSectionBadge {
    background-color: #3A72B5;
    color: #FFFFFF;
    border-radius: 3px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 700;
}

/* ---- Formula TextEdit ---- */
QTextEdit {
    background-color: #F5F9FE;
    color: #1B2B40;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    border: 1px solid #BFCFDF;
    border-radius: 3px;
    selection-background-color: #3A72B5;
}
QTextEdit:focus { border-color: #3A72B5; background-color: #F0F7FF; }

/* ---- List Widget ---- */
QListWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F4F8FD;
    border: 1px solid #CCDAEA;
    border-radius: 3px;
    color: #1B2B40;
    font-size: 12px;
    outline: 0;
}
QListWidget::item { padding: 3px 6px; border-radius: 2px; min-height: 20px; }
QListWidget::item:hover { background-color: #E5EFF8; }
QListWidget::item:selected { background-color: #3A72B5; color: #FFFFFF; }

/* ---- Slider ---- */
QSlider::groove:horizontal {
    height: 4px; background-color: #C2D4E6; border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 14px; height: 14px;
    background-color: #3A72B5; border-radius: 7px;
    margin: -5px 0; border: 1px solid #2A5C9E;
}
QSlider::sub-page:horizontal { background-color: #3A72B5; border-radius: 2px; }
   </string>
  </property>

  <!-- ═══════════════════════════════════════════════════════════
       MAIN VERTICAL LAYOUT
       ═══════════════════════════════════════════════════════════ -->
  <layout class="QVBoxLayout" name="layoutMain">
   <property name="spacing">
    <number>0</number>
   </property>
   <property name="leftMargin">
    <number>0</number>
   </property>
   <property name="topMargin">
    <number>0</number>
   </property>
   <property name="rightMargin">
    <number>0</number>
   </property>
   <property name="bottomMargin">
    <number>0</number>
   </property>

   <!-- ── HEADER BANNER ────────────────────────────────────── -->
   <item>
    <widget class="QFrame" name="frameHeader">
     <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
     <layout class="QHBoxLayout" name="layoutHeader">
      <property name="leftMargin"><number>18</number></property>
      <property name="topMargin"><number>0</number></property>
      <property name="rightMargin"><number>18</number></property>
      <property name="bottomMargin"><number>0</number></property>
      <property name="spacing"><number>12</number></property>
      <item>
       <layout class="QVBoxLayout">
        <property name="spacing"><number>1</number></property>
        <item>
         <widget class="QLabel" name="lblHeaderTitle">
          <property name="text"><string>Calculations &amp; Tools</string></property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="lblHeaderSub">
          <property name="text"><string>Petrophysics calculations, reservoir analysis and log-processing utilities</string></property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <spacer>
        <property name="orientation"><enum>Qt::Horizontal</enum></property>
        <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
       </spacer>
      </item>
      <item>
       <widget class="QLabel" name="lblHeaderWell">
        <property name="styleSheet"><string>color:rgba(210,230,255,0.9);font-size:11px;</string></property>
        <property name="text"><string>Active Well:  CHr-1</string></property>
        <property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- ── SPLITTER: NAV TREE  |  CONTENT STACK ──────────────── -->
   <item>
    <widget class="QSplitter" name="splitterMain">
     <property name="orientation"><enum>Qt::Horizontal</enum></property>
     <property name="handleWidth"><number>3</number></property>
     <property name="childrenCollapsible"><bool>false</bool></property>

     <!-- LEFT: Navigation Tree -->
     <widget class="QTreeWidget" name="treeNav">
      <property name="sizePolicy">
       <sizepolicy hsizetype="Fixed" vsizetype="Expanding">
        <horstretch>0</horstretch><verstretch>0</verstretch>
       </sizepolicy>
      </property>
      <property name="alternatingRowColors"><bool>false</bool></property>
      <property name="rootIsDecorated"><bool>true</bool></property>
      <property name="itemsExpandable"><bool>true</bool></property>
      <property name="headerHidden"><bool>true</bool></property>
      <property name="expandsOnDoubleClick"><bool>false</bool></property>
      <column><property name="text"><string>Module</string></property></column>

      <!-- Category: Petrophysics Calculations -->
      <item>
       <property name="text">
        <string>Petrophysics Calculations</string>
       </property>
       <item>
        <property name="text">
         <string>Shale Volume (Vcl)</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Porosity (PHIT / PHIE)</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Water Saturation (Sw)</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Permeability (K)</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Net Pay / Cutoff</string>
        </property>
       </item>
      </item>

      <!-- Category: Reservoir & Rock Physics -->
      <item>
       <property name="text">
        <string>Reservoir &amp; Rock Physics</string>
       </property>
       <item>
        <property name="text">
         <string>Multimineral Inversion</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Rock Physics Templates</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Fluid Substitution (Gassmann)</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Volumetrics (OOIP / OGIP)</string>
        </property>
       </item>
      </item>

      <!-- Category: Tools & Utilities -->
      <item>
       <property name="text">
        <string>Tools &amp; Utilities</string>
       </property>
       <item>
        <property name="text">
         <string>Unit Converter</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Depth / Time Converter</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Curve Math (Formula)</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Log Normalization / QC</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Splice &amp; Merge Curves</string>
        </property>
       </item>
      </item>
     </widget>

     <!-- RIGHT: Stacked Content -->
     <widget class="QStackedWidget" name="stackedContent">

      <!-- ════════════════════════════════════════════════════
           PAGE 0 — WELCOME / OVERVIEW
           ════════════════════════════════════════════════════ -->
      <widget class="QWidget" name="pageWelcome">
       <layout class="QVBoxLayout" name="layoutWelcome">
        <property name="leftMargin"><number>30</number></property>
        <property name="topMargin"><number>30</number></property>
        <property name="rightMargin"><number>30</number></property>
        <property name="bottomMargin"><number>30</number></property>
        <item>
         <spacer><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property></spacer>
        </item>
        <item>
         <widget class="QLabel" name="lblWelcomeTitle">
          <property name="text"><string>Select a module from the navigation panel</string></property>
          <property name="alignment"><set>Qt::AlignHCenter</set></property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="lblWelcomeSub">
          <property name="text"><string>Choose a calculation or tool from the left-hand tree to get started.
All results are stored as new curves in your active well dataset.</string></property>
          <property name="alignment"><set>Qt::AlignHCenter</set></property>
          <property name="wordWrap"><bool>true</bool></property>
         </widget>
        </item>
        <item>
         <spacer><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property></spacer>
        </item>
        <!-- Quick-launch cards row -->
        <item>
         <layout class="QHBoxLayout" name="layoutQuickCards">
          <item>
           <widget class="QGroupBox" name="cardCalcQuick">
            <property name="title"><string>Quick Calculations</string></property>
            <layout class="QVBoxLayout">
             <item><widget class="QPushButton" name="btnQuickVcl"><property name="text"><string>Shale Volume (Vcl)</string></property></widget></item>
             <item><widget class="QPushButton" name="btnQuickPhi"><property name="text"><string>Porosity (PHIE)</string></property></widget></item>
             <item><widget class="QPushButton" name="btnQuickSw"><property name="text"><string>Water Saturation (Sw)</string></property></widget></item>
             <item><widget class="QPushButton" name="btnQuickPerm"><property name="text"><string>Permeability (K)</string></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="cardRockQuick">
            <property name="title"><string>Reservoir Analysis</string></property>
            <layout class="QVBoxLayout">
             <item><widget class="QPushButton" name="btnQuickMultimin"><property name="text"><string>Multimineral Inversion</string></property></widget></item>
             <item><widget class="QPushButton" name="btnQuickGassmann"><property name="text"><string>Fluid Substitution</string></property></widget></item>
             <item><widget class="QPushButton" name="btnQuickVolumetrics"><property name="text"><string>Volumetrics (OOIP)</string></property></widget></item>
             <item><widget class="QPushButton" name="btnQuickNetPay"><property name="text"><string>Net Pay / Cutoff</string></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="cardToolsQuick">
            <property name="title"><string>Tools &amp; Utilities</string></property>
            <layout class="QVBoxLayout">
             <item><widget class="QPushButton" name="btnQuickUnit"><property name="text"><string>Unit Converter</string></property></widget></item>
             <item><widget class="QPushButton" name="btnQuickDepth"><property name="text"><string>Depth / Time Converter</string></property></widget></item>
             <item><widget class="QPushButton" name="btnQuickFormula"><property name="text"><string>Curve Math (Formula)</string></property></widget></item>
             <item><widget class="QPushButton" name="btnQuickNorm"><property name="text"><string>Log Normalization</string></property></widget></item>
            </layout>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <spacer><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property></spacer>
        </item>
       </layout>
      </widget>

      <!-- ════════════════════════════════════════════════════
           PAGE 1 — SHALE VOLUME (Vcl)
           ════════════════════════════════════════════════════ -->
      <widget class="QWidget" name="pageShaleVolume">
       <layout class="QVBoxLayout" name="layoutPageVcl">
        <property name="leftMargin"><number>8</number></property>
        <property name="topMargin"><number>8</number></property>
        <property name="rightMargin"><number>8</number></property>
        <property name="bottomMargin"><number>4</number></property>
        <property name="spacing"><number>6</number></property>
        <!-- Page title -->
        <item>
         <layout class="QHBoxLayout">
          <item><widget class="QLabel" name="lblVclPageTitle"><property name="styleSheet"><string>font-size:14px;font-weight:700;color:#2A5090;</string></property><property name="text"><string>Shale Volume (Vcl) Calculation</string></property></widget></item>
          <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
          <item><widget class="QLabel" name="lblVclBadge"><property name="objectName"><string>lblSectionBadge</string></property><property name="text"><string>PETROPHYSICS</string></property></widget></item>
         </layout>
        </item>
        <!-- Main content splitter -->
        <item>
         <widget class="QSplitter" name="splitterVcl">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <!-- Parameters panel -->
          <widget class="QScrollArea" name="scrollVclParams">
           <property name="widgetResizable"><bool>true</bool></property>
           <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
           <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
           <widget class="QWidget" name="scrollVclContents">
            <layout class="QVBoxLayout">
             <property name="spacing"><number>6</number></property>
             <!-- Well & Zone -->
             <item>
              <widget class="QGroupBox" name="groupVclWell">
               <property name="title"><string>Well &amp; Zone Selection</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Well:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboVcl2Well"><item><property name="text"><string>CHr-1</string></property></item><item><property name="text"><string>Tau-1</string></property></item><item><property name="text"><string>Experior</string></property></item></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Apply to Zone:</string></property></widget></item>
                <item row="1" column="1"><widget class="QComboBox" name="comboVcl2Zone"><item><property name="text"><string>Entire Well</string></property></item><item><property name="text"><string>Zone A</string></property></item><item><property name="text"><string>Zone B</string></property></item></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Depth Range:</string></property></widget></item>
                <item row="2" column="1">
                 <layout class="QHBoxLayout">
                  <item><widget class="QDoubleSpinBox" name="spinVcl2DepthTop"><property name="suffix"><string> m</string></property><property name="maximum"><double>9999.0</double></property><property name="value"><double>1000.0</double></property></widget></item>
                  <item><widget class="QLabel"><property name="text"><string>to</string></property><property name="alignment"><set>Qt::AlignHCenter</set></property></widget></item>
                  <item><widget class="QDoubleSpinBox" name="spinVcl2DepthBase"><property name="suffix"><string> m</string></property><property name="maximum"><double>9999.0</double></property><property name="value"><double>2500.0</double></property></widget></item>
                 </layout>
                </item>
               </layout>
              </widget>
             </item>
             <!-- GR-Based method -->
             <item>
              <widget class="QGroupBox" name="groupVclGR">
               <property name="title"><string>GR-Based Parameters</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>GR Curve:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboVcl2GR"><item><property name="text"><string>GR</string></property></item><item><property name="text"><string>CGR</string></property></item></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>GR Clean (min):</string></property></widget></item>
                <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinVcl2GRmin"><property name="suffix"><string> API</string></property><property name="maximum"><double>300.0</double></property><property name="value"><double>15.0</double></property></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>GR Shale (max):</string></property></widget></item>
                <item row="2" column="1"><widget class="QDoubleSpinBox" name="spinVcl2GRmax"><property name="suffix"><string> API</string></property><property name="maximum"><double>300.0</double></property><property name="value"><double>120.0</double></property></widget></item>
                <item row="3" column="0"><widget class="QLabel"><property name="text"><string>Auto-detect GR min/max:</string></property></widget></item>
                <item row="3" column="1"><widget class="QCheckBox" name="checkVclAutoGR"><property name="text"><string>Use P5 / P95 percentiles</string></property></widget></item>
               </layout>
              </widget>
             </item>
             <!-- Method & Correction -->
             <item>
              <widget class="QGroupBox" name="groupVclMethod">
               <property name="title"><string>Calculation Method</string></property>
               <layout class="QVBoxLayout">
                <item>
                 <layout class="QFormLayout">
                  <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Primary Method:</string></property></widget></item>
                  <item row="0" column="1"><widget class="QComboBox" name="comboVcl2Method"><item><property name="text"><string>Linear GR Index</string></property></item><item><property name="text"><string>Larionov — Tertiary Rocks</string></property></item><item><property name="text"><string>Larionov — Older Rocks</string></property></item><item><property name="text"><string>Steiber</string></property></item><item><property name="text"><string>Clavier</string></property></item><item><property name="text"><string>Neutron-Density (N-D)</string></property></item><item><property name="text"><string>SP Curve</string></property></item></widget></item>
                  <item row="1" column="0"><widget class="QLabel"><property name="text"><string>SP Curve (if used):</string></property></widget></item>
                  <item row="1" column="1"><widget class="QComboBox" name="comboVcl2SP"><item><property name="text"><string>SP</string></property></item><item><property name="text"><string>N/A</string></property></item></widget></item>
                  <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Cap Vcl at 1.0:</string></property></widget></item>
                  <item row="2" column="1"><widget class="QCheckBox" name="checkVclCap"><property name="text"><string>Enabled</string></property><property name="checked"><bool>true</bool></property></widget></item>
                 </layout>
                </item>
               </layout>
              </widget>
             </item>
             <!-- Output -->
             <item>
              <widget class="QGroupBox" name="groupVclOutput">
               <property name="title"><string>Output</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Output Curve Name:</string></property></widget></item>
                <item row="0" column="1"><widget class="QLineEdit" name="lineVcl2OutName"><property name="text"><string>VSH</string></property></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Overwrite existing:</string></property></widget></item>
                <item row="1" column="1"><widget class="QCheckBox" name="checkVclOverwrite"><property name="text"><string>Yes</string></property></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Store in project:</string></property></widget></item>
                <item row="2" column="1"><widget class="QCheckBox" name="checkVclSaveProject"><property name="text"><string>Yes</string></property><property name="checked"><bool>true</bool></property></widget></item>
               </layout>
              </widget>
             </item>
             <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item>
            </layout>
           </widget>
          </widget>
          <!-- Preview canvas -->
          <widget class="QFrame" name="frameVcl2Canvas">
           <property name="objectName"><string>frameCanvas</string></property>
           <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
           <layout class="QVBoxLayout">
            <item>
             <widget class="QTabWidget" name="tabsVclResult">
              <widget class="QWidget" name="tabVclPreview">
               <attribute name="title"><string>Log Preview</string></attribute>
               <layout class="QVBoxLayout">
                <item><widget class="QLabel" name="lblVcl2Canvas"><property name="styleSheet"><string>color:#8898A8;font-size:13px;</string></property><property name="text"><string>Vcl preview log canvas
(appears after Calculate)</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
               </layout>
              </widget>
              <widget class="QWidget" name="tabVclStats">
               <attribute name="title"><string>Statistics</string></attribute>
               <layout class="QVBoxLayout">
                <item>
                 <widget class="QTableWidget" name="tableVclStats">
                  <property name="alternatingRowColors"><bool>true</bool></property>
                  <property name="rowCount"><number>6</number></property>
                  <property name="columnCount"><number>2</number></property>
                  <column><property name="text"><string>Parameter</string></property></column>
                  <column><property name="text"><string>Value</string></property></column>
                 </widget>
                </item>
               </layout>
              </widget>
              <widget class="QWidget" name="tabVclFormula">
               <attribute name="title"><string>Formula Reference</string></attribute>
               <layout class="QVBoxLayout">
                <item><widget class="QLabel" name="lblVclFormula"><property name="styleSheet"><string>font-size:12px;color:#1B2B40;padding:10px;</string></property><property name="wordWrap"><bool>true</bool></property><property name="text"><string>&lt;b&gt;Linear GR Index:&lt;/b&gt;  IGR = (GR - GR_min) / (GR_max - GR_min)&lt;br&gt;&lt;br&gt;&lt;b&gt;Larionov (Tertiary):&lt;/b&gt;  Vcl = 0.083 × (2^(3.7×IGR) - 1)&lt;br&gt;&lt;b&gt;Larionov (Older Rocks):&lt;/b&gt;  Vcl = 0.33 × (2^(2×IGR) - 1)&lt;br&gt;&lt;b&gt;Steiber:&lt;/b&gt;  Vcl = IGR / (3 - 2×IGR)&lt;br&gt;&lt;b&gt;Clavier:&lt;/b&gt;  Vcl = 1.7 - √(3.38 - (IGR + 0.7)²)</string></property></widget></item>
               </layout>
              </widget>
             </widget>
            </item>
           </layout>
          </widget>
         </widget>
        </item>
       </layout>
      </widget>

      <!-- ════════════════════════════════════════════════════
           PAGE 2 — POROSITY (PHIT / PHIE)
           ════════════════════════════════════════════════════ -->
      <widget class="QWidget" name="pagePorosity">
       <layout class="QVBoxLayout" name="layoutPagePhi">
        <property name="leftMargin"><number>8</number></property>
        <property name="topMargin"><number>8</number></property>
        <property name="rightMargin"><number>8</number></property>
        <property name="bottomMargin"><number>4</number></property>
        <property name="spacing"><number>6</number></property>
        <item>
         <layout class="QHBoxLayout">
          <item><widget class="QLabel"><property name="styleSheet"><string>font-size:14px;font-weight:700;color:#2A5090;</string></property><property name="text"><string>Porosity Calculation (PHIT / PHIE)</string></property></widget></item>
          <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
          <item><widget class="QLabel"><property name="objectName"><string>lblSectionBadge</string></property><property name="text"><string>PETROPHYSICS</string></property></widget></item>
         </layout>
        </item>
        <item>
         <widget class="QSplitter" name="splitterPhi">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <widget class="QScrollArea" name="scrollPhiParams">
           <property name="widgetResizable"><bool>true</bool></property>
           <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
           <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
           <widget class="QWidget" name="scrollPhiContents">
            <layout class="QVBoxLayout">
             <property name="spacing"><number>6</number></property>
             <item>
              <widget class="QGroupBox" name="groupPhi2Well">
               <property name="title"><string>Well &amp; Zone</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Well:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboPhi2Well"><item><property name="text"><string>CHr-1</string></property></item><item><property name="text"><string>Tau-1</string></property></item></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Zone:</string></property></widget></item>
                <item row="1" column="1"><widget class="QComboBox" name="comboPhi2Zone"><item><property name="text"><string>Entire Well</string></property></item><item><property name="text"><string>Zone A</string></property></item></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox" name="groupPhi2Method">
               <property name="title"><string>Porosity Method</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Primary Method:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboPhi2Method"><item><property name="text"><string>Density (PHID)</string></property></item><item><property name="text"><string>Neutron (PHIN)</string></property></item><item><property name="text"><string>Sonic / DT (PHIS)</string></property></item><item><property name="text"><string>Neutron-Density Crossplot</string></property></item><item><property name="text"><string>Neutron-Density Average</string></property></item></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox" name="groupPhi2DensParams">
               <property name="title"><string>Density Parameters</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>RHOB Curve:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboPhi2RHOB"><item><property name="text"><string>RHOB</string></property></item></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Matrix Density (ρma):</string></property></widget></item>
                <item row="1" column="1"><widget class="QComboBox" name="comboPhi2RhoMa"><item><property name="text"><string>Sandstone — 2.65 g/cc</string></property></item><item><property name="text"><string>Limestone — 2.71 g/cc</string></property></item><item><property name="text"><string>Dolomite — 2.87 g/cc</string></property></item><item><property name="text"><string>Custom...</string></property></item></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Custom ρma (g/cc):</string></property></widget></item>
                <item row="2" column="1"><widget class="QDoubleSpinBox" name="spinPhi2RhoMa"><property name="decimals"><number>3</number></property><property name="minimum"><double>2.0</double></property><property name="maximum"><double>3.5</double></property><property name="value"><double>2.650</double></property></widget></item>
                <item row="3" column="0"><widget class="QLabel"><property name="text"><string>Fluid Density (ρfl):</string></property></widget></item>
                <item row="3" column="1"><widget class="QDoubleSpinBox" name="spinPhi2RhoFl"><property name="decimals"><number>3</number></property><property name="minimum"><double>0.5</double></property><property name="maximum"><double>1.2</double></property><property name="value"><double>1.000</double></property></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox" name="groupPhi2NeutParams">
               <property name="title"><string>Neutron &amp; Sonic Parameters</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>NPHI Curve:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboPhi2NPHI"><item><property name="text"><string>NPHI</string></property></item></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>DT Curve (sonic):</string></property></widget></item>
                <item row="1" column="1"><widget class="QComboBox" name="comboPhi2DT"><item><property name="text"><string>DT</string></property></item></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>DTma (μs/ft):</string></property></widget></item>
                <item row="2" column="1"><widget class="QDoubleSpinBox" name="spinPhi2DTma"><property name="decimals"><number>1</number></property><property name="minimum"><double>40.0</double></property><property name="maximum"><double>100.0</double></property><property name="value"><double>55.5</double></property></widget></item>
                <item row="3" column="0"><widget class="QLabel"><property name="text"><string>DTfl (μs/ft):</string></property></widget></item>
                <item row="3" column="1"><widget class="QDoubleSpinBox" name="spinPhi2DTfl"><property name="decimals"><number>1</number></property><property name="minimum"><double>180.0</double></property><property name="maximum"><double>220.0</double></property><property name="value"><double>189.0</double></property></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox" name="groupPhi2Correction">
               <property name="title"><string>Corrections &amp; Output</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Vcl Curve (for PHIE):</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboPhi2Vcl"><item><property name="text"><string>VSH</string></property></item></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Shale Porosity (PHIsh):</string></property></widget></item>
                <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinPhi2PHIsh"><property name="decimals"><number>3</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>0.5</double></property><property name="value"><double>0.120</double></property></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>PHIT Output Name:</string></property></widget></item>
                <item row="2" column="1"><widget class="QLineEdit" name="linePhi2OutPHIT"><property name="text"><string>PHIT</string></property></widget></item>
                <item row="3" column="0"><widget class="QLabel"><property name="text"><string>PHIE Output Name:</string></property></widget></item>
                <item row="3" column="1"><widget class="QLineEdit" name="linePhi2OutPHIE"><property name="text"><string>PHIE</string></property></widget></item>
               </layout>
              </widget>
             </item>
             <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item>
            </layout>
           </widget>
          </widget>
          <widget class="QFrame" name="framePhiCanvas">
           <property name="objectName"><string>frameCanvas</string></property>
           <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
           <layout class="QVBoxLayout">
            <item>
             <widget class="QTabWidget" name="tabsPhiResult">
              <widget class="QWidget" name="tabPhiPreview"><attribute name="title"><string>Log Preview</string></attribute><layout class="QVBoxLayout"><item><widget class="QLabel"><property name="styleSheet"><string>color:#8898A8;font-size:13px;</string></property><property name="text"><string>Porosity preview log canvas</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item></layout></widget>
              <widget class="QWidget" name="tabPhiCrossplot"><attribute name="title"><string>N-D Crossplot</string></attribute><layout class="QVBoxLayout"><item><widget class="QLabel"><property name="styleSheet"><string>color:#8898A8;font-size:13px;</string></property><property name="text"><string>Neutron-Density crossplot canvas</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item></layout></widget>
              <widget class="QWidget" name="tabPhiStats"><attribute name="title"><string>Statistics</string></attribute><layout class="QVBoxLayout"><item><widget class="QTableWidget" name="tablePhiStats"><property name="alternatingRowColors"><bool>true</bool></property><property name="rowCount"><number>8</number></property><property name="columnCount"><number>3</number></property><column><property name="text"><string>Curve</string></property></column><column><property name="text"><string>Mean</string></property></column><column><property name="text"><string>Std Dev</string></property></column></widget></item></layout></widget>
             </widget>
            </item>
           </layout>
          </widget>
         </widget>
        </item>
       </layout>
      </widget>

      <!-- ════════════════════════════════════════════════════
           PAGE 3 — WATER SATURATION (Sw)
           ════════════════════════════════════════════════════ -->
      <widget class="QWidget" name="pageWaterSat">
       <layout class="QVBoxLayout" name="layoutPageSw">
        <property name="leftMargin"><number>8</number></property>
        <property name="topMargin"><number>8</number></property>
        <property name="rightMargin"><number>8</number></property>
        <property name="bottomMargin"><number>4</number></property>
        <property name="spacing"><number>6</number></property>
        <item>
         <layout class="QHBoxLayout">
          <item><widget class="QLabel"><property name="styleSheet"><string>font-size:14px;font-weight:700;color:#2A5090;</string></property><property name="text"><string>Water Saturation (Sw) Calculation</string></property></widget></item>
          <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
          <item><widget class="QLabel"><property name="objectName"><string>lblSectionBadge</string></property><property name="text"><string>PETROPHYSICS</string></property></widget></item>
         </layout>
        </item>
        <item>
         <widget class="QSplitter" name="splitterSw">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <widget class="QScrollArea" name="scrollSwParams">
           <property name="widgetResizable"><bool>true</bool></property>
           <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
           <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
           <widget class="QWidget" name="scrollSwContents">
            <layout class="QVBoxLayout"><property name="spacing"><number>6</number></property>
             <item>
              <widget class="QGroupBox" name="groupSw2Well"><property name="title"><string>Well &amp; Zone</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Well:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboSw2Well"><item><property name="text"><string>CHr-1</string></property></item><item><property name="text"><string>Tau-1</string></property></item></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox" name="groupSw2Method"><property name="title"><string>Saturation Model</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Model:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboSw2Model"><item><property name="text"><string>Archie (Clean Sand)</string></property></item><item><property name="text"><string>Simandoux</string></property></item><item><property name="text"><string>Indonesia (Poupon-Leveaux)</string></property></item><item><property name="text"><string>Waxman-Smits</string></property></item><item><property name="text"><string>Dual-Water</string></property></item></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Rt Curve (deep res.):</string></property></widget></item>
                <item row="1" column="1"><widget class="QComboBox" name="comboSw2Rt"><item><property name="text"><string>LLD</string></property></item><item><property name="text"><string>ILD</string></property></item><item><property name="text"><string>AT90</string></property></item></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>PHIE Curve:</string></property></widget></item>
                <item row="2" column="1"><widget class="QComboBox" name="comboSw2PHIE"><item><property name="text"><string>PHIE</string></property></item></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox" name="groupSw2ArchieParams"><property name="title"><string>Archie Parameters</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Rw (Ω·m):</string></property></widget></item>
                <item row="0" column="1"><widget class="QDoubleSpinBox" name="spinSw2Rw"><property name="decimals"><number>4</number></property><property name="minimum"><double>0.001</double></property><property name="maximum"><double>10.0</double></property><property name="value"><double>0.0500</double></property></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>a — tortuosity:</string></property></widget></item>
                <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinSw2A"><property name="decimals"><number>3</number></property><property name="minimum"><double>0.1</double></property><property name="maximum"><double>2.0</double></property><property name="value"><double>1.000</double></property></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>m — cementation:</string></property></widget></item>
                <item row="2" column="1"><widget class="QDoubleSpinBox" name="spinSw2M"><property name="decimals"><number>3</number></property><property name="minimum"><double>1.0</double></property><property name="maximum"><double>3.0</double></property><property name="value"><double>2.000</double></property></widget></item>
                <item row="3" column="0"><widget class="QLabel"><property name="text"><string>n — saturation:</string></property></widget></item>
                <item row="3" column="1"><widget class="QDoubleSpinBox" name="spinSw2N"><property name="decimals"><number>3</number></property><property name="minimum"><double>1.0</double></property><property name="maximum"><double>3.0</double></property><property name="value"><double>2.000</double></property></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox" name="groupSw2ShaleParams"><property name="title"><string>Shaly-Sand Parameters (Simandoux / Indonesia)</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Vcl Curve:</string></property></widget></item>
