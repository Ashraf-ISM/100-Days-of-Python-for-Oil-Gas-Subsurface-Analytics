      <!-- ════════════════════════════════════════════════════
           PAGE 6 — MULTIMINERAL INVERSION
           ════════════════════════════════════════════════════ -->
      <widget class="QWidget" name="pageMultimin">
       <layout class="QVBoxLayout" name="layoutPageMM">
        <property name="leftMargin"><number>8</number></property>
        <property name="topMargin"><number>8</number></property>
        <property name="rightMargin"><number>8</number></property>
        <property name="bottomMargin"><number>4</number></property>
        <property name="spacing"><number>6</number></property>
        <item>
         <layout class="QHBoxLayout">
          <item><widget class="QLabel"><property name="styleSheet"><string>font-size:14px;font-weight:700;color:#2A5090;</string></property><property name="text"><string>Multimineral Inversion</string></property></widget></item>
          <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
          <item><widget class="QLabel"><property name="objectName"><string>lblSectionBadge</string></property><property name="text"><string>RESERVOIR</string></property></widget></item>
         </layout>
        </item>
        <item>
         <widget class="QSplitter" name="splitterMM">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <widget class="QScrollArea" name="scrollMMParams">
           <property name="widgetResizable"><bool>true</bool></property>
           <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
           <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
           <widget class="QWidget" name="scrollMMContents">
            <layout class="QVBoxLayout"><property name="spacing"><number>6</number></property>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Input Log Curves</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>GR:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboMMGR"><item><property name="text"><string>GR</string></property></item></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>RHOB:</string></property></widget></item>
                <item row="1" column="1"><widget class="QComboBox" name="comboMMRHOB"><item><property name="text"><string>RHOB</string></property></item></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>NPHI:</string></property></widget></item>
                <item row="2" column="1"><widget class="QComboBox" name="comboMMNPHI"><item><property name="text"><string>NPHI</string></property></item></widget></item>
                <item row="3" column="0"><widget class="QLabel"><property name="text"><string>PE (photoelectric):</string></property></widget></item>
                <item row="3" column="1"><widget class="QComboBox" name="comboMMPE"><item><property name="text"><string>PE</string></property></item><item><property name="text"><string>N/A</string></property></item></widget></item>
                <item row="4" column="0"><widget class="QLabel"><property name="text"><string>DT (sonic):</string></property></widget></item>
                <item row="4" column="1"><widget class="QComboBox" name="comboMMDT"><item><property name="text"><string>DT</string></property></item><item><property name="text"><string>N/A</string></property></item></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Mineral End-Points</string></property>
               <layout class="QVBoxLayout">
                <item>
                 <widget class="QTableWidget" name="tableMMEndPoints">
                  <property name="alternatingRowColors"><bool>true</bool></property>
                  <property name="rowCount"><number>5</number></property>
                  <property name="columnCount"><number>5</number></property>
                  <column><property name="text"><string>Mineral</string></property></column>
                  <column><property name="text"><string>ρ (g/cc)</string></property></column>
                  <column><property name="text"><string>NPHI</string></property></column>
                  <column><property name="text"><string>PE (b/e)</string></property></column>
                  <column><property name="text"><string>GR (API)</string></property></column>
                 </widget>
                </item>
                <item>
                 <layout class="QHBoxLayout">
                  <item><widget class="QPushButton" name="btnMMAddMineral"><property name="text"><string>+ Add Mineral</string></property></widget></item>
                  <item><widget class="QPushButton" name="btnMMRemoveMineral"><property name="text"><string>– Remove</string></property></widget></item>
                  <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
                 </layout>
                </item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Solver Settings</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Method:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboMMSolver"><item><property name="text"><string>Weighted Least Squares</string></property></item><item><property name="text"><string>Non-negative Least Squares</string></property></item><item><property name="text"><string>Probabilistic (Monte Carlo)</string></property></item></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Constraint (sum=1):</string></property></widget></item>
                <item row="1" column="1"><widget class="QCheckBox" name="checkMMConstraint"><property name="text"><string>Enforce volume closure</string></property><property name="checked"><bool>true</bool></property></widget></item>
               </layout>
              </widget>
             </item>
             <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item>
            </layout>
           </widget>
          </widget>
          <widget class="QFrame" name="frameMMCanvas">
           <property name="objectName"><string>frameCanvas</string></property>
           <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
           <layout class="QVBoxLayout">
            <item>
             <widget class="QTabWidget" name="tabsMMResult">
              <widget class="QWidget"><attribute name="title"><string>Mineral Volume Log</string></attribute><layout class="QVBoxLayout"><item><widget class="QLabel"><property name="styleSheet"><string>color:#8898A8;font-size:13px;</string></property><property name="text"><string>Stacked mineral volume log canvas</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item></layout></widget>
              <widget class="QWidget"><attribute name="title"><string>Goodness of Fit</string></attribute><layout class="QVBoxLayout"><item><widget class="QLabel"><property name="styleSheet"><string>color:#8898A8;font-size:13px;</string></property><property name="text"><string>GOF / error track canvas</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item></layout></widget>
             </widget>
            </item>
           </layout>
          </widget>
         </widget>
        </item>
       </layout>
      </widget>

      <!-- ════════════════════════════════════════════════════
           PAGE 7 — ROCK PHYSICS TEMPLATES
           ════════════════════════════════════════════════════ -->
      <widget class="QWidget" name="pageRockPhysics">
       <layout class="QVBoxLayout" name="layoutPageRP">
        <property name="leftMargin"><number>8</number></property>
        <property name="topMargin"><number>8</number></property>
        <property name="rightMargin"><number>8</number></property>
        <property name="bottomMargin"><number>4</number></property>
        <property name="spacing"><number>6</number></property>
        <item>
         <layout class="QHBoxLayout">
          <item><widget class="QLabel"><property name="styleSheet"><string>font-size:14px;font-weight:700;color:#2A5090;</string></property><property name="text"><string>Rock Physics Templates</string></property></widget></item>
          <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
          <item><widget class="QLabel"><property name="objectName"><string>lblSectionBadge</string></property><property name="text"><string>RESERVOIR</string></property></widget></item>
         </layout>
        </item>
        <item>
         <widget class="QSplitter" name="splitterRP">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <widget class="QScrollArea" name="scrollRPParams">
           <property name="widgetResizable"><bool>true</bool></property>
           <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
           <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
           <widget class="QWidget" name="scrollRPContents">
            <layout class="QVBoxLayout"><property name="spacing"><number>6</number></property>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Template &amp; Curves</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>RPT Template:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboRPTemplate"><item><property name="text"><string>Vp/Vs vs AI (Castagna)</string></property></item><item><property name="text"><string>Vp vs Porosity (Han)</string></property></item><item><property name="text"><string>Vs vs Porosity</string></property></item><item><property name="text"><string>Lambda-Rho vs Mu-Rho</string></property></item><item><property name="text"><string>AI vs Vp/Vs</string></property></item></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Vp Curve:</string></property></widget></item>
                <item row="1" column="1"><widget class="QComboBox" name="comboRPVp"><item><property name="text"><string>VP</string></property></item><item><property name="text"><string>DT (computed)</string></property></item></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Vs Curve:</string></property></widget></item>
                <item row="2" column="1"><widget class="QComboBox" name="comboRPVs"><item><property name="text"><string>VS</string></property></item><item><property name="text"><string>DTS (computed)</string></property></item></widget></item>
                <item row="3" column="0"><widget class="QLabel"><property name="text"><string>RHOB Curve:</string></property></widget></item>
                <item row="3" column="1"><widget class="QComboBox" name="comboRPRHOB"><item><property name="text"><string>RHOB</string></property></item></widget></item>
                <item row="4" column="0"><widget class="QLabel" name="labelRPColorBy"><property name="text"><string>Colour by:</string></property></widget></item>
                <item row="4" column="1"><widget class="QComboBox" name="comboRPColor"><item><property name="text"><string>VSH</string></property></item><item><property name="text"><string>SW</string></property></item><item><property name="text"><string>PHIE</string></property></item><item><property name="text"><string>Depth</string></property></item></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Derived Elastic Properties</string></property>
               <layout class="QVBoxLayout">
                <item><widget class="QCheckBox" name="checkRPCalcAI"><property name="text"><string>Compute Acoustic Impedance (AI)</string></property><property name="checked"><bool>true</bool></property></widget></item>
                <item><widget class="QCheckBox" name="checkRPCalcVpVs"><property name="text"><string>Compute Vp/Vs ratio</string></property><property name="checked"><bool>true</bool></property></widget></item>
                <item><widget class="QCheckBox" name="checkRPCalcPR"><property name="text"><string>Compute Poisson's Ratio (ν)</string></property></widget></item>
                <item><widget class="QCheckBox" name="checkRPCalcLR"><property name="text"><string>Compute Lambda·Rho &amp; Mu·Rho</string></property></widget></item>
                <item><widget class="QCheckBox" name="checkRPCalcE"><property name="text"><string>Compute Young's Modulus (E)</string></property></widget></item>
               </layout>
              </widget>
             </item>
             <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item>
            </layout>
           </widget>
          </widget>
          <widget class="QFrame" name="frameRPCanvas">
           <property name="objectName"><string>frameCanvas</string></property>
           <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
           <layout class="QVBoxLayout">
            <item>
             <widget class="QTabWidget" name="tabsRPResult">
              <widget class="QWidget"><attribute name="title"><string>RPT Crossplot</string></attribute><layout class="QVBoxLayout"><item><widget class="QLabel"><property name="styleSheet"><string>color:#8898A8;font-size:13px;</string></property><property name="text"><string>Rock Physics Template crossplot canvas</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item></layout></widget>
              <widget class="QWidget"><attribute name="title"><string>Elastic Log</string></attribute><layout class="QVBoxLayout"><item><widget class="QLabel"><property name="styleSheet"><string>color:#8898A8;font-size:13px;</string></property><property name="text"><string>Derived elastic log canvas (AI, Vp/Vs, ν)</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item></layout></widget>
             </widget>
            </item>
           </layout>
          </widget>
         </widget>
        </item>
       </layout>
      </widget>

      <!-- ════════════════════════════════════════════════════
           PAGE 8 — FLUID SUBSTITUTION (GASSMANN)
           ════════════════════════════════════════════════════ -->
      <widget class="QWidget" name="pageGassmann">
       <layout class="QVBoxLayout" name="layoutPageGass">
        <property name="leftMargin"><number>8</number></property>
        <property name="topMargin"><number>8</number></property>
        <property name="rightMargin"><number>8</number></property>
        <property name="bottomMargin"><number>4</number></property>
        <property name="spacing"><number>6</number></property>
        <item>
         <layout class="QHBoxLayout">
          <item><widget class="QLabel"><property name="styleSheet"><string>font-size:14px;font-weight:700;color:#2A5090;</string></property><property name="text"><string>Fluid Substitution — Gassmann Equation</string></property></widget></item>
          <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
          <item><widget class="QLabel"><property name="objectName"><string>lblSectionBadge</string></property><property name="text"><string>RESERVOIR</string></property></widget></item>
         </layout>
        </item>
        <item>
         <widget class="QSplitter" name="splitterGass">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <widget class="QScrollArea" name="scrollGassParams">
           <property name="widgetResizable"><bool>true</bool></property>
           <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
           <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
           <widget class="QWidget" name="scrollGassContents">
            <layout class="QVBoxLayout"><property name="spacing"><number>6</number></property>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Input Curves</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Vp Curve:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboGassVp"><item><property name="text"><string>VP</string></property></item></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Vs Curve:</string></property></widget></item>
                <item row="1" column="1"><widget class="QComboBox" name="comboGassVs"><item><property name="text"><string>VS</string></property></item></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>RHOB Curve:</string></property></widget></item>
                <item row="2" column="1"><widget class="QComboBox" name="comboGassRHOB"><item><property name="text"><string>RHOB</string></property></item></widget></item>
                <item row="3" column="0"><widget class="QLabel"><property name="text"><string>PHIE Curve:</string></property></widget></item>
                <item row="3" column="1"><widget class="QComboBox" name="comboGassPHIE"><item><property name="text"><string>PHIE</string></property></item></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Initial Fluid Properties</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Initial Fluid:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboGassFluid1"><item><property name="text"><string>Brine</string></property></item><item><property name="text"><string>Gas</string></property></item><item><property name="text"><string>Oil</string></property></item><item><property name="text"><string>Mixed (Sw)</string></property></item></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Kfl₁ (GPa):</string></property></widget></item>
                <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinGassKfl1"><property name="decimals"><number>4</number></property><property name="minimum"><double>0.001</double></property><property name="maximum"><double>5.0</double></property><property name="value"><double>2.500</double></property></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>ρfl₁ (g/cc):</string></property></widget></item>
                <item row="2" column="1"><widget class="QDoubleSpinBox" name="spinGassRhofl1"><property name="decimals"><number>4</number></property><property name="minimum"><double>0.001</double></property><property name="maximum"><double>2.0</double></property><property name="value"><double>1.000</double></property></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Substituted Fluid Properties</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Substituted Fluid:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboGassFluid2"><item><property name="text"><string>Gas</string></property></item><item><property name="text"><string>Brine</string></property></item><item><property name="text"><string>Oil</string></property></item></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Kfl₂ (GPa):</string></property></widget></item>
                <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinGassKfl2"><property name="decimals"><number>4</number></property><property name="minimum"><double>0.001</double></property><property name="maximum"><double>5.0</double></property><property name="value"><double>0.022</double></property></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>ρfl₂ (g/cc):</string></property></widget></item>
                <item row="2" column="1"><widget class="QDoubleSpinBox" name="spinGassRhofl2"><property name="decimals"><number>4</number></property><property name="minimum"><double>0.001</double></property><property name="maximum"><double>2.0</double></property><property name="value"><double>0.200</double></property></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Frame &amp; Mineral</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Mineral K₀ (GPa):</string></property></widget></item>
                <item row="0" column="1"><widget class="QDoubleSpinBox" name="spinGassK0"><property name="decimals"><number>2</number></property><property name="minimum"><double>10.0</double></property><property name="maximum"><double>100.0</double></property><property name="value"><double>36.6</double></property></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>ρmineral (g/cc):</string></property></widget></item>
                <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinGassRhoMin"><property name="decimals"><number>3</number></property><property name="minimum"><double>2.0</double></property><property name="maximum"><double>4.0</double></property><property name="value"><double>2.650</double></property></widget></item>
               </layout>
              </widget>
             </item>
             <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item>
            </layout>
           </widget>
          </widget>
          <widget class="QFrame" name="frameGassCanvas">
           <property name="objectName"><string>frameCanvas</string></property>
           <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
           <layout class="QVBoxLayout">
            <item>
             <widget class="QTabWidget" name="tabsGassResult">
              <widget class="QWidget"><attribute name="title"><string>Substituted Logs</string></attribute><layout class="QVBoxLayout"><item><widget class="QLabel"><property name="styleSheet"><string>color:#8898A8;font-size:13px;</string></property><property name="text"><string>Original vs substituted Vp, Vs, RHOB log canvas</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item></layout></widget>
              <widget class="QWidget"><attribute name="title"><string>Fluid Effect RPT</string></attribute><layout class="QVBoxLayout"><item><widget class="QLabel"><property name="styleSheet"><string>color:#8898A8;font-size:13px;</string></property><property name="text"><string>AI vs Vp/Vs: original vs substituted overlay</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item></layout></widget>
             </widget>
            </item>
           </layout>
          </widget>
         </widget>
        </item>
       </layout>
      </widget>

      <!-- ════════════════════════════════════════════════════
           PAGE 9 — VOLUMETRICS (OOIP / OGIP)
           ════════════════════════════════════════════════════ -->
      <widget class="QWidget" name="pageVolumetrics">
       <layout class="QVBoxLayout" name="layoutPageVol">
        <property name="leftMargin"><number>8</number></property>
        <property name="topMargin"><number>8</number></property>
        <property name="rightMargin"><number>8</number></property>
        <property name="bottomMargin"><number>4</number></property>
        <property name="spacing"><number>6</number></property>
        <item>
         <layout class="QHBoxLayout">
          <item><widget class="QLabel"><property name="styleSheet"><string>font-size:14px;font-weight:700;color:#2A5090;</string></property><property name="text"><string>Volumetrics — OOIP / OGIP Estimation</string></property></widget></item>
          <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
          <item><widget class="QLabel"><property name="objectName"><string>lblSectionBadge</string></property><property name="text"><string>RESERVOIR</string></property></widget></item>
         </layout>
        </item>
        <item>
         <widget class="QSplitter" name="splitterVol">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <widget class="QScrollArea" name="scrollVolParams">
           <property name="widgetResizable"><bool>true</bool></property>
           <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
           <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
           <widget class="QWidget" name="scrollVolContents">
            <layout class="QVBoxLayout"><property name="spacing"><number>6</number></property>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Fluid Type</string></property>
               <layout class="QVBoxLayout">
                <item><widget class="QRadioButton" name="radioOil"><property name="text"><string>Oil Reservoir (OOIP)</string></property><property name="checked"><bool>true</bool></property></widget></item>
                <item><widget class="QRadioButton" name="radioGas"><property name="text"><string>Gas Reservoir (OGIP)</string></property></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Reservoir Geometry</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Drainage Area (acres):</string></property></widget></item>
                <item row="0" column="1"><widget class="QDoubleSpinBox" name="spinVolArea"><property name="decimals"><number>1</number></property><property name="minimum"><double>0.1</double></property><property name="maximum"><double>100000.0</double></property><property name="value"><double>500.0</double></property></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Net Pay (ft):</string></property></widget></item>
                <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinVolNP"><property name="decimals"><number>1</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>5000.0</double></property><property name="value"><double>50.0</double></property></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Petrophysical Parameters</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Porosity — φ (frac):</string></property></widget></item>
                <item row="0" column="1"><widget class="QDoubleSpinBox" name="spinVolPhi"><property name="decimals"><number>3</number></property><property name="minimum"><double>0.001</double></property><property name="maximum"><double>0.5</double></property><property name="value"><double>0.180</double></property></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Sw — water sat. (frac):</string></property></widget></item>
                <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinVolSw"><property name="decimals"><number>3</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>1.0</double></property><property name="value"><double>0.250</double></property></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Fluid &amp; Recovery</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Formation Vol. Factor (Bo):</string></property></widget></item>
                <item row="0" column="1"><widget class="QDoubleSpinBox" name="spinVolBo"><property name="decimals"><number>4</number></property><property name="minimum"><double>0.1</double></property><property name="maximum"><double>5.0</double></property><property name="value"><double>1.250</double></property></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Recovery Factor RF (frac):</string></property></widget></item>
                <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinVolRF"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>1.0</double></property><property name="value"><double>0.35</double></property></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>OGIP Bg (res ft³/scf):</string></property></widget></item>
                <item row="2" column="1"><widget class="QDoubleSpinBox" name="spinVolBg"><property name="decimals"><number>6</number></property><property name="minimum"><double>0.000001</double></property><property name="maximum"><double>1.0</double></property><property name="value"><double>0.005</double></property></widget></item>
               </layout>
              </widget>
             </item>
             <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item>
            </layout>
           </widget>
          </widget>
          <widget class="QFrame" name="frameVolCanvas">
           <property name="objectName"><string>frameCanvas</string></property>
           <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
           <layout class="QVBoxLayout">
            <item>
             <widget class="QGroupBox" name="groupVolResults"><property name="title"><string>Calculation Results</string></property>
              <layout class="QFormLayout">
               <item row="0" column="0"><widget class="QLabel"><property name="styleSheet"><string>font-weight:700;</string></property><property name="text"><string>Gross Rock Volume (GRV):</string></property></widget></item>
               <item row="0" column="1"><widget class="QLineEdit" name="lineVolGRV"><property name="readOnly"><bool>true</bool></property><property name="styleSheet"><string>background:#EBF4FF;font-weight:700;</string></property><property name="placeholderText"><string>— MMBBL</string></property></widget></item>
               <item row="1" column="0"><widget class="QLabel"><property name="styleSheet"><string>font-weight:700;</string></property><property name="text"><string>Pore Volume (PV):</string></property></widget></item>
               <item row="1" column="1"><widget class="QLineEdit" name="lineVolPV"><property name="readOnly"><bool>true</bool></property><property name="styleSheet"><string>background:#EBF4FF;font-weight:700;</string></property><property name="placeholderText"><string>— MMBBL</string></property></widget></item>
               <item row="2" column="0"><widget class="QLabel"><property name="styleSheet"><string>font-weight:700;color:#1A6A30;</string></property><property name="text"><string>OOIP / OGIP:</string></property></widget></item>
               <item row="2" column="1"><widget class="QLineEdit" name="lineVolOOIP"><property name="readOnly"><bool>true</bool></property><property name="styleSheet"><string>background:#E6F6EC;font-weight:700;color:#1A6A30;font-size:13px;</string></property><property name="placeholderText"><string>— MMBBL or Bcf</string></property></widget></item>
               <item row="3" column="0"><widget class="QLabel"><property name="styleSheet"><string>font-weight:700;color:#2A5090;</string></property><property name="text"><string>Estimated Recoverable:</string></property></widget></item>
               <item row="3" column="1"><widget class="QLineEdit" name="lineVolRecoverable"><property name="readOnly"><bool>true</bool></property><property name="styleSheet"><string>background:#EBF4FF;font-weight:700;color:#2A5090;font-size:13px;</string></property><property name="placeholderText"><string>— MMBBL or Bcf</string></property></widget></item>
              </layout>
             </widget>
            </item>
            <item>
             <widget class="QGroupBox" name="groupVolSensitivity"><property name="title"><string>Sensitivity Tornado</string></property>
              <layout class="QVBoxLayout">
               <item><widget class="QLabel"><property name="styleSheet"><string>color:#8898A8;font-size:12px;</string></property><property name="text"><string>Tornado chart canvas
(OOIP sensitivity to φ, Sw, Net Pay, RF)</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
              </layout>
             </widget>
            </item>
            <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item>
           </layout>
          </widget>
         </widget>
        </item>
       </layout>
      </widget>

      <!-- ════════════════════════════════════════════════════
           PAGE 10 — UNIT CONVERTER
           ════════════════════════════════════════════════════ -->
      <widget class="QWidget" name="pageUnitConverter">
       <layout class="QVBoxLayout" name="layoutPageUnit">
        <property name="leftMargin"><number>8</number></property>
        <property name="topMargin"><number>8</number></property>
        <property name="rightMargin"><number>8</number></property>
        <property name="bottomMargin"><number>4</number></property>
        <property name="spacing"><number>6</number></property>
        <item>
         <layout class="QHBoxLayout">
          <item><widget class="QLabel"><property name="styleSheet"><string>font-size:14px;font-weight:700;color:#2A5090;</string></property><property name="text"><string>Unit Converter</string></property></widget></item>
          <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
          <item><widget class="QLabel"><property name="objectName"><string>lblSectionBadge</string></property><property name="text"><string>TOOLS</string></property></widget></item>
         </layout>
        </item>
        <item>
         <widget class="QGroupBox" name="groupUnitCategory"><property name="title"><string>Conversion Category</string></property>
          <layout class="QHBoxLayout">
           <item><widget class="QComboBox" name="comboUnitCategory"><item><property name="text"><string>Pressure</string></property></item><item><property name="text"><string>Depth / Length</string></property></item><item><property name="text"><string>Temperature</string></property></item><item><property name="text"><string>Density</string></property></item><item><property name="text"><string>Resistivity</string></property></item><item><property name="text"><string>Velocity (Vp / Vs)</string></property></item><item><property name="text"><string>Permeability</string></property></item><item><property name="text"><string>Volume (reservoir)</string></property></item><item><property name="text"><string>Flow Rate</string></property></item><item><property name="text"><string>Viscosity</string></property></item></widget></item>
           <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="groupUnitConvert"><property name="title"><string>Value Conversion</string></property>
          <layout class="QGridLayout">
           <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Input Value:</string></property></widget></item>
           <item row="0" column="1"><widget class="QDoubleSpinBox" name="spinUnitInput"><property name="decimals"><number>6</number></property><property name="minimum"><double>-1e+09</double></property><property name="maximum"><double>1e+09</double></property><property name="value"><double>1.0</double></property></widget></item>
           <item row="0" column="2"><widget class="QComboBox" name="comboUnitFrom"><item><property name="text"><string>psi</string></property></item><item><property name="text"><string>MPa</string></property></item><item><property name="text"><string>bar</string></property></item><item><property name="text"><string>atm</string></property></item><item><property name="text"><string>kPa</string></property></item></widget></item>
           <item row="0" column="3"><widget class="QLabel"><property name="text"><string>→</string></property><property name="alignment"><set>Qt::AlignHCenter</set></property></widget></item>
           <item row="0" column="4"><widget class="QLineEdit" name="lineUnitResult"><property name="readOnly"><bool>true</bool></property><property name="styleSheet"><string>background:#EBF4FF;font-weight:700;font-size:13px;</string></property></widget></item>
           <item row="0" column="5"><widget class="QComboBox" name="comboUnitTo"><item><property name="text"><string>MPa</string></property></item><item><property name="text"><string>psi</string></property></item><item><property name="text"><string>bar</string></property></item><item><property name="text"><string>atm</string></property></item><item><property name="text"><string>kPa</string></property></item></widget></item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="groupUnitTable"><property name="title"><string>Quick Reference Table</string></property>
          <layout class="QVBoxLayout">
           <item>
            <widget class="QTableWidget" name="tableUnitRef">
             <property name="alternatingRowColors"><bool>true</bool></property>
             <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
             <property name="rowCount"><number>12</number></property>
             <property name="columnCount"><number>3</number></property>
             <column><property name="text"><string>From Unit</string></property></column>
             <column><property name="text"><string>To Unit</string></property></column>
             <column><property name="text"><string>Factor</string></property></column>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item>
       </layout>
      </widget>

      <!-- ════════════════════════════════════════════════════
           PAGE 11 — DEPTH / TIME CONVERTER
           ════════════════════════════════════════════════════ -->
      <widget class="QWidget" name="pageDepthTime">
       <layout class="QVBoxLayout" name="layoutPageDT">
        <property name="leftMargin"><number>8</number></property>
        <property name="topMargin"><number>8</number></property>
        <property name="rightMargin"><number>8</number></property>
        <property name="bottomMargin"><number>4</number></property>
        <property name="spacing"><number>6</number></property>
        <item>
         <layout class="QHBoxLayout">
          <item><widget class="QLabel"><property name="styleSheet"><string>font-size:14px;font-weight:700;color:#2A5090;</string></property><property name="text"><string>Depth / Time Domain Converter</string></property></widget></item>
          <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
          <item><widget class="QLabel"><property name="objectName"><string>lblSectionBadge</string></property><property name="text"><string>TOOLS</string></property></widget></item>
         </layout>
        </item>
        <item>
         <widget class="QSplitter" name="splitterDT">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <widget class="QScrollArea" name="scrollDTParams">
           <property name="widgetResizable"><bool>true</bool></property>
           <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
           <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
           <widget class="QWidget" name="scrollDTContents">
            <layout class="QVBoxLayout"><property name="spacing"><number>6</number></property>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Conversion Direction</string></property>
               <layout class="QVBoxLayout">
                <item><widget class="QRadioButton" name="radioDT_D2T"><property name="text"><string>Depth → Two-Way Time (TWT)</string></property><property name="checked"><bool>true</bool></property></widget></item>
                <item><widget class="QRadioButton" name="radioDT_T2D"><property name="text"><string>TWT → Depth</string></property></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Velocity Model</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Velocity Source:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboDTVelSource"><item><property name="text"><string>Constant Vint (m/s)</string></property></item><item><property name="text"><string>Interval Velocity Curve</string></property></item><item><property name="text"><string>Check-Shot Table</string></property></item><item><property name="text"><string>Seismic Velocity Field</string></property></item></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Constant Vint (m/s):</string></property></widget></item>
                <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinDTVint"><property name="decimals"><number>0</number></property><property name="minimum"><double>1000.0</double></property><property name="maximum"><double>8000.0</double></property><property name="value"><double>2500.0</double></property></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Vel Curve (if used):</string></property></widget></item>
                <item row="2" column="1"><widget class="QComboBox" name="comboDTVelCurve"><item><property name="text"><string>VINT</string></property></item><item><property name="text"><string>VP</string></property></item></widget></item>
                <item row="3" column="0"><widget class="QLabel"><property name="text"><string>Datum Correction:</string></property></widget></item>
                <item row="3" column="1"><widget class="QCheckBox" name="checkDTDatum"><property name="text"><string>Apply KB elevation</string></property></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Check-Shot Editor</string></property>
               <layout class="QVBoxLayout">
                <item>
                 <widget class="QTableWidget" name="tableCSTable">
                  <property name="alternatingRowColors"><bool>true</bool></property>
                  <property name="rowCount"><number>6</number></property>
                  <property name="columnCount"><number>2</number></property>
                  <column><property name="text"><string>Depth (m)</string></property></column>
                  <column><property name="text"><string>TWT (ms)</string></property></column>
                 </widget>
                </item>
                <item>
                 <layout class="QHBoxLayout">
                  <item><widget class="QPushButton" name="btnCSAddRow"><property name="text"><string>+ Row</string></property></widget></item>
                  <item><widget class="QPushButton" name="btnCSImport"><property name="text"><string>Import CSV…</string></property></widget></item>
                  <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
                 </layout>
                </item>
               </layout>
              </widget>
             </item>
             <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item>
            </layout>
           </widget>
          </widget>
          <widget class="QFrame" name="frameDTCanvas">
           <property name="objectName"><string>frameCanvas</string></property>
           <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
           <layout class="QVBoxLayout">
            <item>
             <widget class="QTabWidget" name="tabsDTResult">
              <widget class="QWidget"><attribute name="title"><string>Depth-Time Curve</string></attribute><layout class="QVBoxLayout"><item><widget class="QLabel"><property name="styleSheet"><string>color:#8898A8;font-size:13px;</string></property><property name="text"><string>Depth vs TWT conversion curve canvas</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item></layout></widget>
              <widget class="QWidget"><attribute name="title"><string>Converted Log</string></attribute><layout class="QVBoxLayout"><item><widget class="QLabel"><property name="styleSheet"><string>color:#8898A8;font-size:13px;</string></property><property name="text"><string>Converted log in new domain canvas</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item></layout></widget>
             </widget>
            </item>
           </layout>
          </widget>
         </widget>
        </item>
       </layout>
      </widget>

      <!-- ════════════════════════════════════════════════════
           PAGE 12 — CURVE MATH (FORMULA EDITOR)
           ════════════════════════════════════════════════════ -->
      <widget class="QWidget" name="pageCurveMath">
       <layout class="QVBoxLayout" name="layoutPageCM">
        <property name="leftMargin"><number>8</number></property>
        <property name="topMargin"><number>8</number></property>
        <property name="rightMargin"><number>8</number></property>
        <property name="bottomMargin"><number>4</number></property>
        <property name="spacing"><number>6</number></property>
        <item>
         <layout class="QHBoxLayout">
          <item><widget class="QLabel"><property name="styleSheet"><string>font-size:14px;font-weight:700;color:#2A5090;</string></property><property name="text"><string>Curve Math — Formula Editor</string></property></widget></item>
          <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
          <item><widget class="QLabel"><property name="objectName"><string>lblSectionBadge</string></property><property name="text"><string>TOOLS</string></property></widget></item>
         </layout>
        </item>
        <item>
         <widget class="QSplitter" name="splitterCM">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <!-- Formula editor panel -->
          <widget class="QWidget" name="widgetCMEditor">
           <layout class="QVBoxLayout"><property name="spacing"><number>6</number></property>
            <item>
             <widget class="QGroupBox"><property name="title"><string>Available Curves</string></property>
              <layout class="QVBoxLayout">
               <item>
                <widget class="QListWidget" name="listCMCurves">
                 <item><property name="text"><string>GR (API)</string></property></item>
                 <item><property name="text"><string>RHOB (g/cc)</string></property></item>
                 <item><property name="text"><string>NPHI (frac)</string></property></item>
                 <item><property name="text"><string>LLD (Ω·m)</string></property></item>
                 <item><property name="text"><string>DT (μs/ft)</string></property></item>
                 <item><property name="text"><string>VSH (frac)</string></property></item>
                 <item><property name="text"><string>PHIE (frac)</string></property></item>
                 <item><property name="text"><string>SW (frac)</string></property></item>
                 <item><property name="text"><string>PERM (mD)</string></property></item>
                </widget>
               </item>
               <item><widget class="QLabel"><property name="styleSheet"><string>color:#4A6A8A;font-size:11px;</string></property><property name="text"><string>Double-click a curve to insert it into the formula.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
              </layout>
             </widget>
            </item>
            <item>
             <widget class="QGroupBox"><property name="title"><string>Formula (NumPy expressions supported)</string></property>
              <layout class="QVBoxLayout">
               <item>
                <widget class="QTextEdit" name="textCMFormula">
                 <property name="placeholderText"><string>Example:
result = PHIE * (1 - SW)
# Hydrocarbon Pore Volume

# Available functions: np.log, np.log10, np.sqrt,
# np.exp, np.where, np.clip, np.abs</string></property>
                </widget>
               </item>
               <item>
                <layout class="QHBoxLayout">
                 <item><widget class="QPushButton" name="btnCMValidate"><property name="text"><string>Validate Formula</string></property></widget></item>
                 <item><widget class="QPushButton" name="btnCMClear"><property name="text"><string>Clear</string></property></widget></item>
                 <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
                </layout>
               </item>
              </layout>
             </widget>
            </item>
            <item>
             <widget class="QGroupBox"><property name="title"><string>Output Curve</string></property>
              <layout class="QFormLayout">
               <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Output Name:</string></property></widget></item>
               <item row="0" column="1"><widget class="QLineEdit" name="lineCMOutName"><property name="text"><string>CUSTOM_CURVE</string></property></widget></item>
               <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Output Unit:</string></property></widget></item>
               <item row="1" column="1"><widget class="QLineEdit" name="lineCMOutUnit"><property name="text"><string>frac</string></property></widget></item>
              </layout>
             </widget>
            </item>
           </layout>
          </widget>
          <!-- Preview canvas -->
          <widget class="QFrame" name="frameCMCanvas">
           <property name="objectName"><string>frameCanvas</string></property>
           <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
           <layout class="QVBoxLayout">
            <item>
             <widget class="QTabWidget" name="tabsCMResult">
              <widget class="QWidget"><attribute name="title"><string>Result Log</string></attribute><layout class="QVBoxLayout"><item><widget class="QLabel"><property name="styleSheet"><string>color:#8898A8;font-size:13px;</string></property><property name="text"><string>Custom formula result log canvas</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item></layout></widget>
              <widget class="QWidget"><attribute name="title"><string>Console Output</string></attribute><layout class="QVBoxLayout"><item><widget class="QPlainTextEdit" name="textCMConsole"><property name="readOnly"><bool>true</bool></property><property name="placeholderText"><string>Formula validation and execution messages appear here…</string></property></widget></item></layout></widget>
             </widget>
            </item>
           </layout>
          </widget>
         </widget>
        </item>
       </layout>
      </widget>

      <!-- ════════════════════════════════════════════════════
           PAGE 13 — LOG NORMALIZATION / QC
           ════════════════════════════════════════════════════ -->
      <widget class="QWidget" name="pageNormalization">
       <layout class="QVBoxLayout" name="layoutPageNorm">
        <property name="leftMargin"><number>8</number></property>
        <property name="topMargin"><number>8</number></property>
        <property name="rightMargin"><number>8</number></property>
        <property name="bottomMargin"><number>4</number></property>
        <property name="spacing"><number>6</number></property>
        <item>
         <layout class="QHBoxLayout">
          <item><widget class="QLabel"><property name="styleSheet"><string>font-size:14px;font-weight:700;color:#2A5090;</string></property><property name="text"><string>Log Normalization &amp; QC</string></property></widget></item>
          <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
          <item><widget class="QLabel"><property name="objectName"><string>lblSectionBadge</string></property><property name="text"><string>TOOLS</string></property></widget></item>
         </layout>
        </item>
        <item>
         <widget class="QSplitter" name="splitterNorm">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <widget class="QScrollArea" name="scrollNormParams">
           <property name="widgetResizable"><bool>true</bool></property>
           <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
           <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
           <widget class="QWidget" name="scrollNormContents">
            <layout class="QVBoxLayout"><property name="spacing"><number>6</number></property>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Curve &amp; Wells</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Curve to Normalize:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboNormCurve"><item><property name="text"><string>GR</string></property></item><item><property name="text"><string>RHOB</string></property></item><item><property name="text"><string>NPHI</string></property></item><item><property name="text"><string>DT</string></property></item></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Reference Well:</string></property></widget></item>
                <item row="1" column="1"><widget class="QComboBox" name="comboNormRefWell"><item><property name="text"><string>CHr-1</string></property></item><item><property name="text"><string>Tau-1</string></property></item></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Wells to Normalize:</string></property></widget></item>
                <item row="2" column="1"><widget class="QListWidget" name="listNormWells"><property name="selectionMode"><enum>QAbstractItemView::MultiSelection</enum></property><item><property name="text"><string>Tau-1</string></property></item><item><property name="text"><string>Experior</string></property></item></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Normalization Method</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Method:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboNormMethod"><item><property name="text"><string>Key-Bed Percentile (P5/P95)</string></property></item><item><property name="text"><string>Mean Shift</string></property></item><item><property name="text"><string>Linear Stretch</string></property></item><item><property name="text"><string>Histogram Matching</string></property></item></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Low percentile:</string></property></widget></item>
                <item row="1" column="1"><widget class="QSpinBox" name="spinNormLow"><property name="minimum"><number>1</number></property><property name="maximum"><number>49</number></property><property name="value"><number>5</number></property></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>High percentile:</string></property></widget></item>
                <item row="2" column="1"><widget class="QSpinBox" name="spinNormHigh"><property name="minimum"><number>51</number></property><property name="maximum"><number>99</number></property><property name="value"><number>95</number></property></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>QC Spike Filter</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Apply despiking:</string></property></widget></item>
                <item row="0" column="1"><widget class="QCheckBox" name="checkNormDespike"><property name="text"><string>Enabled</string></property></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Threshold (σ):</string></property></widget></item>
                <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinNormSigma"><property name="decimals"><number>1</number></property><property name="minimum"><double>1.0</double></property><property name="maximum"><double>5.0</double></property><property name="value"><double>3.0</double></property></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Replace with:</string></property></widget></item>
                <item row="2" column="1"><widget class="QComboBox" name="comboNormSpikeReplace"><item><property name="text"><string>Running Median</string></property></item><item><property name="text"><string>Linear Interpolation</string></property></item><item><property name="text"><string>Null (NaN)</string></property></item></widget></item>
               </layout>
              </widget>
             </item>
             <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item>
            </layout>
           </widget>
          </widget>
          <widget class="QFrame" name="frameNormCanvas">
           <property name="objectName"><string>frameCanvas</string></property>
           <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
           <layout class="QVBoxLayout">
            <item>
             <widget class="QTabWidget" name="tabsNormResult">
              <widget class="QWidget"><attribute name="title"><string>Before / After Histograms</string></attribute><layout class="QVBoxLayout"><item><widget class="QLabel"><property name="styleSheet"><string>color:#8898A8;font-size:13px;</string></property><property name="text"><string>Overlaid histograms: reference (blue) vs to-normalize (orange) → normalized (green)</string></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="wordWrap"><bool>true</bool></property></widget></item></layout></widget>
              <widget class="QWidget"><attribute name="title"><string>Log Track Comparison</string></attribute><layout class="QVBoxLayout"><item><widget class="QLabel"><property name="styleSheet"><string>color:#8898A8;font-size:13px;</string></property><property name="text"><string>Original vs normalized log track canvas</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item></layout></widget>
             </widget>
            </item>
           </layout>
          </widget>
         </widget>
        </item>
       </layout>
      </widget>

      <!-- ════════════════════════════════════════════════════
           PAGE 14 — SPLICE & MERGE CURVES
           ════════════════════════════════════════════════════ -->
      <widget class="QWidget" name="pageSpliceMerge">
       <layout class="QVBoxLayout" name="layoutPageSM">
        <property name="leftMargin"><number>8</number></property>
        <property name="topMargin"><number>8</number></property>
        <property name="rightMargin"><number>8</number></property>
        <property name="bottomMargin"><number>4</number></property>
        <property name="spacing"><number>6</number></property>
        <item>
         <layout class="QHBoxLayout">
          <item><widget class="QLabel"><property name="styleSheet"><string>font-size:14px;font-weight:700;color:#2A5090;</string></property><property name="text"><string>Splice &amp; Merge Curves</string></property></widget></item>
          <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
          <item><widget class="QLabel"><property name="objectName"><string>lblSectionBadge</string></property><property name="text"><string>TOOLS</string></property></widget></item>
         </layout>
        </item>
        <item>
         <widget class="QSplitter" name="splitterSM">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <widget class="QScrollArea" name="scrollSMParams">
           <property name="widgetResizable"><bool>true</bool></property>
           <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
           <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
           <widget class="QWidget" name="scrollSMContents">
            <layout class="QVBoxLayout"><property name="spacing"><number>6</number></property>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Operation</string></property>
               <layout class="QVBoxLayout">
                <item><widget class="QRadioButton" name="radioSplice"><property name="text"><string>Splice (depth-based join: tool replaces BHC)</string></property><property name="checked"><bool>true</bool></property></widget></item>
                <item><widget class="QRadioButton" name="radioMerge"><property name="text"><string>Merge (fill nulls from backup curve)</string></property></widget></item>
                <item><widget class="QRadioButton" name="radioAverage"><property name="text"><string>Weighted Average (blending)</string></property></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Primary Curve (A)</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Curve A:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboSMA"><item><property name="text"><string>DT</string></property></item><item><property name="text"><string>LLS</string></property></item><item><property name="text"><string>NPHI</string></property></item></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Use A from depth:</string></property></widget></item>
                <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinSMAFrom"><property name="suffix"><string> m</string></property><property name="maximum"><double>9999.0</double></property><property name="value"><double>0.0</double></property></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Use A to depth:</string></property></widget></item>
                <item row="2" column="1"><widget class="QDoubleSpinBox" name="spinSMATo"><property name="suffix"><string> m</string></property><property name="maximum"><double>9999.0</double></property><property name="value"><double>1800.0</double></property></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Secondary Curve (B)</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Curve B:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboSMB"><item><property name="text"><string>DT_BHC</string></property></item><item><property name="text"><string>LLD</string></property></item><item><property name="text"><string>CALI</string></property></item></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Use B from depth:</string></property></widget></item>
                <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinSMBFrom"><property name="suffix"><string> m</string></property><property name="maximum"><double>9999.0</double></property><property name="value"><double>1800.0</double></property></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Blending / Taper</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Taper Zone (m):</string></property></widget></item>
                <item row="0" column="1"><widget class="QDoubleSpinBox" name="spinSMTaper"><property name="decimals"><number>1</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>200.0</double></property><property name="value"><double>10.0</double></property></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Weight A (blend):</string></property></widget></item>
                <item row="1" column="1"><widget class="QSlider" name="sliderSMWeight"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="minimum"><number>0</number></property><property name="maximum"><number>100</number></property><property name="value"><number>50</number></property></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Output Curve Name:</string></property></widget></item>
                <item row="2" column="1"><widget class="QLineEdit" name="lineSMOut"><property name="text"><string>DT_SPLICE</string></property></widget></item>
               </layout>
              </widget>
             </item>
             <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item>
            </layout>
           </widget>
          </widget>
          <widget class="QFrame" name="frameSMCanvas">
           <property name="objectName"><string>frameCanvas</string></property>
           <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
           <layout class="QVBoxLayout">
            <item>
             <widget class="QTabWidget" name="tabsSMResult">
              <widget class="QWidget"><attribute name="title"><string>Splice Preview</string></attribute><layout class="QVBoxLayout"><item><widget class="QLabel"><property name="styleSheet"><string>color:#8898A8;font-size:13px;</string></property><property name="text"><string>Curve A / Curve B / Spliced result log canvas
(shown in different colours per track)</string></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="wordWrap"><bool>true</bool></property></widget></item></layout></widget>
              <widget class="QWidget"><attribute name="title"><string>Difference Track</string></attribute><layout class="QVBoxLayout"><item><widget class="QLabel"><property name="styleSheet"><string>color:#8898A8;font-size:13px;</string></property><property name="text"><string>A - B difference log canvas</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item></layout></widget>
             </widget>
            </item>
           </layout>
          </widget>
         </widget>
        </item>
       </layout>
      </widget>

     </widget><!-- end stackedContent -->
    </widget><!-- end splitterMain -->
   </item>

   <!-- ── BOTTOM ACTION BAR ────────────────────────────────── -->
   <item>
    <widget class="QFrame" name="frameBottomBar">
     <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
     <layout class="QHBoxLayout" name="layoutBottomBar">
      <property name="leftMargin"><number>12</number></property>
      <property name="topMargin"><number>0</number></property>
      <property name="rightMargin"><number>12</number></property>
      <property name="bottomMargin"><number>0</number></property>
      <property name="spacing"><number>8</number></property>
      <!-- Status message -->
      <item>
       <widget class="QLabel" name="lblStatusMsg">
        <property name="text"><string>Select a module to begin.</string></property>
        <property name="minimumWidth"><number>200</number></property>
       </widget>
      </item>
      <!-- Progress bar -->
      <item>
       <widget class="QProgressBar" name="progressCalc">
        <property name="value"><number>0</number></property>
        <property name="minimum"><number>0</number></property>
        <property name="maximum"><number>100</number></property>
        <property name="textVisible"><bool>false</bool></property>
        <property name="minimumWidth"><number>160</number></property>
        <property name="maximumWidth"><number>220</number></property>
       </widget>
      </item>
      <item>
       <spacer>
        <property name="orientation"><enum>Qt::Horizontal</enum></property>
        <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
       </spacer>
      </item>
      <!-- Batch run toggle -->
      <item>
       <widget class="QCheckBox" name="checkBatchAllWells">
        <property name="text"><string>Batch (All Wells)</string></property>
       </widget>
      </item>
      <!-- Action buttons -->
      <item>
       <widget class="QPushButton" name="btnReset">
        <property name="text"><string>Reset Defaults</string></property>
        <property name="toolTip"><string>Restore all parameters to their default values</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="btnExport">
        <property name="text"><string>Export Results…</string></property>
        <property name="toolTip"><string>Export computed curves or results to CSV / LAS</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="btnCalculate">
        <property name="text"><string>▶  Calculate</string></property>
        <property name="toolTip"><string>Run the selected calculation</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="btnClose">
        <property name="text"><string>Close</string></property>
        <property name="toolTip"><string>Close this dialog</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

  </layout>
 </widget>
 <resources/>
 <connections>
  <!-- Close button -->
  <connection>
   <sender>btnClose</sender>
   <signal>clicked()</signal>
   <receiver>CalcToolsDialog</receiver>
   <slot>close()</slot>
   <hints>
    <hint type="sourcelabel"><x>1100</x><y>800</y></hint>
    <hint type="destinationlabel"><x>580</x><y>410</y></hint>
   </hints>
  </connection>
 </connections>
</ui>
