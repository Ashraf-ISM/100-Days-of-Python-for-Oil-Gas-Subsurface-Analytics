      <!-- ════════════════════════════════════════════════════
           PAGE 4 — PERMEABILITY (K)
           ════════════════════════════════════════════════════ -->
      <widget class="QWidget" name="pagePermeability">
       <layout class="QVBoxLayout" name="layoutPagePerm">
        <property name="leftMargin"><number>8</number></property>
        <property name="topMargin"><number>8</number></property>
        <property name="rightMargin"><number>8</number></property>
        <property name="bottomMargin"><number>4</number></property>
        <property name="spacing"><number>6</number></property>
        <item>
         <layout class="QHBoxLayout">
          <item><widget class="QLabel"><property name="styleSheet"><string>font-size:14px;font-weight:700;color:#2A5090;</string></property><property name="text"><string>Permeability (K) Calculation</string></property></widget></item>
          <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
          <item><widget class="QLabel"><property name="objectName"><string>lblSectionBadge</string></property><property name="text"><string>PETROPHYSICS</string></property></widget></item>
         </layout>
        </item>
        <item>
         <widget class="QSplitter" name="splitterPerm">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <widget class="QScrollArea" name="scrollPermParams">
           <property name="widgetResizable"><bool>true</bool></property>
           <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
           <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
           <widget class="QWidget" name="scrollPermContents">
            <layout class="QVBoxLayout"><property name="spacing"><number>6</number></property>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Well</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Well:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboPerm2Well"><item><property name="text"><string>CHr-1</string></property></item><item><property name="text"><string>Tau-1</string></property></item></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Model Selection</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Model:</string></property></widget></item>
                <item row="0" column="1"><widget class="QComboBox" name="comboPerm2Model"><item><property name="text"><string>Timur / Coates (BVI)</string></property></item><item><property name="text"><string>Kozeny-Carman</string></property></item><item><property name="text"><string>Wyllie-Rose</string></property></item><item><property name="text"><string>Morris-Biggs (Gas)</string></property></item><item><property name="text"><string>Core Regression (Custom)</string></property></item></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>PHIE Curve:</string></property></widget></item>
                <item row="1" column="1"><widget class="QComboBox" name="comboPerm2PHIE"><item><property name="text"><string>PHIE</string></property></item></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>BVI / Swi Curve:</string></property></widget></item>
                <item row="2" column="1"><widget class="QComboBox" name="comboPerm2BVI"><item><property name="text"><string>SW</string></property></item></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Timur / Coates Coefficients</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Coefficient C:</string></property></widget></item>
                <item row="0" column="1"><widget class="QDoubleSpinBox" name="spinPerm2C"><property name="decimals"><number>4</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>100.0</double></property><property name="value"><double>0.0316</double></property></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Swi — irreducible:</string></property></widget></item>
                <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinPerm2Swi"><property name="decimals"><number>3</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>1.0</double></property><property name="value"><double>0.200</double></property></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Exponent e (PHIE):</string></property></widget></item>
                <item row="2" column="1"><widget class="QDoubleSpinBox" name="spinPerm2E"><property name="decimals"><number>2</number></property><property name="minimum"><double>1.0</double></property><property name="maximum"><double>8.0</double></property><property name="value"><double>4.50</double></property></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Core Regression (Custom)</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>log(K) = A × PHIE + B:</string></property></widget></item>
                <item row="0" column="1"><widget class="QLabel"><property name="text"><string></string></property></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Coefficient A:</string></property></widget></item>
                <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinPerm2RegA"><property name="decimals"><number>3</number></property><property name="minimum"><double>-100.0</double></property><property name="maximum"><double>100.0</double></property><property name="value"><double>15.0</double></property></widget></item>
                <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Intercept B:</string></property></widget></item>
                <item row="2" column="1"><widget class="QDoubleSpinBox" name="spinPerm2RegB"><property name="decimals"><number>3</number></property><property name="minimum"><double>-20.0</double></property><property name="maximum"><double>20.0</double></property><property name="value"><double>-2.5</double></property></widget></item>
               </layout>
              </widget>
             </item>
             <item>
              <widget class="QGroupBox"><property name="title"><string>Output</string></property>
               <layout class="QFormLayout">
                <item row="0" column="0"><widget class="QLabel"><property name="text"><string>K Output Name:</string></property></widget></item>
                <item row="0" column="1"><widget class="QLineEdit" name="linePerm2Out"><property name="text"><string>PERM</string></property></widget></item>
                <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Output units:</string></property></widget></item>
                <item row="1" column="1"><widget class="QComboBox" name="comboPerm2Units"><item><property name="text"><string>mD (milliDarcy)</string></property></item><item><property name="text"><string>μD (microDarcy)</string></property></item><item><property name="text"><string>m² (SI)</string></property></item></widget></item>
               </layout>
              </widget>
             </item>
             <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item>
            </layout>
           </widget>
          </widget>
          <widget class="QFrame" name="framePerm2Canvas">
           <property name="objectName"><string>frameCanvas</string></property>
           <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
           <layout class="QVBoxLayout">
            <item>
             <widget class="QTabWidget" name="tabsPermResult">
              <widget class="QWidget"><attribute name="title"><string>Log Preview</string></attribute><layout class="QVBoxLayout"><item><widget class="QLabel"><property name="styleSheet"><string>color:#8898A8;font-size:13px;</string></property><property name="text"><string>Permeability log canvas</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item></layout></widget>
              <widget class="QWidget"><attribute name="title"><string>Core vs Log</string></attribute><layout class="QVBoxLayout"><item><widget class="QLabel"><property name="styleSheet"><string>color:#8898A8;font-size:13px;</string></property><property name="text"><string>Core-calibration crossplot canvas</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item></layout></widget>
             </widget>
            </item>
           </layout>
          </widget>
         </widget>
        </item>
       </layout>
      </widget>

